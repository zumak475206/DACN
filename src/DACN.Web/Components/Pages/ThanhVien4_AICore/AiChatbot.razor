@page "/ai-analytics/chatbot"
@inject DACNContext Db
@inject GoiYDuLichService AiService
@inject UserSessionService Session

<PageTitle>AI Travel Advisor & Chatbot — TV4</PageTitle>

<PageHeader Title="Trợ Lý AI Tư Vấn Du Lịch Theo Ngân Sách, Gu & Mùa"
            Subtitle="Hệ thống Hybrid RAG: Trích xuất ý định (Ngân sách / Tháng / Gu sống ảo - thư giãn) + Chấm điểm DB + Gemini API"
            Icon="bi bi-robot"
            MemberTag="TV4 — AI TRAVEL ADVISOR"
            MemberTagClass="member-tag-tv4">
</PageHeader>

<div class="row g-4">
    <!-- Cột trái: Khung Chat thử nghiệm trực tiếp với AI Engine -->
    <div class="col-12 col-lg-7">
        <div class="hotel-card h-100 d-flex flex-column">
            <div class="hotel-card-header">
                <div class="hotel-card-title">
                    <i class="bi bi-stars" style="color: #8B5CF6;"></i>
                    <span>Bảng Điều Khiển & Test Trực Tiếp AI Advisor</span>
                </div>
                <span class="badge bg-dark font-monospace">Phiên: @(currentSessionToken ?? "Mới")</span>
            </div>

            <div class="hotel-card-body flex-grow-1" style="max-height: 460px; overflow-y: auto; background: #F8FAFC;">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button class="btn btn-sm btn-outline-primary rounded-pill" @onclick='() => AskQuickAsync("Tháng 6 có 3 triệu muốn đi đâu check-in sống ảo đẹp nhất?")'>
                        📸 Tháng 6 có 3tr đi đâu sống ảo?
                    </button>
                    <button class="btn btn-sm btn-outline-success rounded-pill" @onclick='() => AskQuickAsync("Cuối năm có 4 triệu muốn đi nghỉ dưỡng thư giãn chữa lành")'>
                        🌿 Cuối năm 4tr nghỉ dưỡng chữa lành
                    </button>
                    <button class="btn btn-sm btn-outline-warning text-dark rounded-pill" @onclick='() => AskQuickAsync("Khách sạn đang có mã voucher giảm giá nào còn lượt?")'>
                        🎁 Hỏi mã Voucher đang mở
                    </button>
                </div>

                @foreach (var msg in chatHistory)
                {
                    <div class="mb-3 d-flex @(msg.IsUser ? "justify-content-end" : "justify-content-start")">
                        <div class="p-3 rounded-3 shadow-sm" style="max-width: 88%; background: @(msg.IsUser ? "#003B95" : "#FFFFFF"); color: @(msg.IsUser ? "#FFFFFF" : "#1E293B"); border: 1px solid #E2E8F0;">
                            <div class="small mb-1 fw-bold d-flex justify-content-between gap-3">
                                <span>@(msg.IsUser ? "Khách hàng" : $"BookingStay.AI ({msg.EngineSource})")</span>
                                <span class="opacity-75">@msg.Time.ToString("HH:mm")</span>
                            </div>
                            <div class="small">@msg.Text</div>

                            @if (!msg.IsUser && msg.Intent != null)
                            {
                                <div class="mt-2 pt-2 border-top d-flex flex-wrap gap-1">
                                    <span class="badge bg-light text-dark border">Chủ đề: @msg.Intent.ChuDe</span>
                                    @if (msg.Intent.NganSach.HasValue)
                                    {
                                        <span class="badge bg-warning text-dark">Ngân sách: @msg.Intent.NganSach.Value.ToString("N0")đ</span>
                                    }
                                    @if (msg.Intent.ThangDi.HasValue)
                                    {
                                        <span class="badge bg-info text-dark">Tháng: @msg.Intent.ThangDi.Value</span>
                                    }
                                    @if (!string.IsNullOrEmpty(msg.Intent.PhongCach))
                                    {
                                        <span class="badge bg-primary">Gu: @msg.Intent.PhongCach</span>
                                    }
                                </div>
                            }

                            @if (msg.Suggestions.Any())
                            {
                                <div class="mt-2 d-flex flex-column gap-2">
                                    @foreach (var s in msg.Suggestions)
                                    {
                                        <div class="p-2 rounded border bg-light text-dark small">
                                            <div class="d-flex justify-content-between">
                                                <strong>@s.TieuDe (@s.DiemDen)</strong>
                                                <span class="badge bg-success">@s.PhanTramPhuHop% Match</span>
                                            </div>
                                            <div class="text-muted" style="font-size: 0.75rem;">
                                                🌤️ @s.ThoiDiemDepNhat (@s.ThoiTietDuKien) | 🛏️ Phòng: <strong>@s.HangPhongPhuHop</strong> (@s.GiaPhongMoiDem?.ToString("N0")đ/đêm)
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="p-3 border-top bg-white">
                <div class="input-group">
                    <input class="form-control hotel-input"
                           placeholder="Nhập câu hỏi tư vấn (VD: Tháng 7 có 2tr5 đi đâu biển đẹp sống ảo?)..."
                           @bind="userQuestion"
                           @onkeyup="HandleKeyUpAsync" />
                    <button class="hotel-btn hotel-btn-primary" disabled="@isSending" @onclick="SendMessageAsync">
                        <i class="bi bi-send-fill me-1"></i> @(isSending ? "Đang phân tích..." : "Gửi AI")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Danh sách Phiên Chat đã lưu trong bảng PhienChat_AI & TinNhanChat_AI -->
    <div class="col-12 col-lg-5">
        <div class="hotel-card h-100">
            <div class="hotel-card-header">
                <div class="hotel-card-title">
                    <i class="bi bi-clock-history text-primary"></i>
                    <span>Nhật Ký Phiên Chat (`PhienChat_AI`: @sessions.Count)</span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="hotel-table">
                    <thead>
                        <tr>
                            <th>Mã Phiên</th>
                            <th>Khách Hàng</th>
                            <th>Số Tin</th>
                            <th>Thời Gian</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in sessions)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border font-monospace">@s.MaPhienChat</span></td>
                                <td>@(s.MaNguoiDungNavigation?.HoTen ?? "Khách vãng lai")</td>
                                <td><span class="hotel-badge hotel-badge-info">@s.TinNhanChatAis.Count tin</span></td>
                                <td class="small text-muted">@s.ThoiGianBatDau.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private record ChatBubble(bool IsUser, string Text, DateTime Time, string EngineSource, TrichXuatYChinhResult? Intent, List<GoiYKetQuaDto> Suggestions);

    private List<ChatBubble> chatHistory = new();
    private List<PhienChatAi> sessions = new();
    private string userQuestion = "";
    private string? currentSessionToken;
    private bool isSending = false;

    protected override async Task OnInitializedAsync()
    {
        chatHistory.Add(new ChatBubble(
            false,
            "Xin chào! Hãy cho mình biết Ngân sách dự kiến, Tháng đi và Gu trải nghiệm (Check-in sống ảo / Nghỉ dưỡng chữa lành / Ẩm thực) để AI chấm điểm điểm đến & hạng phòng phù hợp nhất!",
            DateTime.Now,
            "System",
            null,
            new()));

        await LoadSessionsAsync();
    }

    private async Task LoadSessionsAsync()
    {
        sessions = await Db.PhienChatAis
            .AsNoTracking()
            .Include(s => s.MaNguoiDungNavigation)
            .Include(s => s.TinNhanChatAis)
            .OrderByDescending(s => s.ThoiGianBatDau)
            .Take(15)
            .ToListAsync();
    }

    private async Task AskQuickAsync(string q)
    {
        userQuestion = q;
        await SendMessageAsync();
    }

    private async Task HandleKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendMessageAsync();
    }

    private DateTime lastSentAt = DateTime.MinValue;

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(userQuestion) || isSending) return;
        if ((DateTime.UtcNow - lastSentAt).TotalSeconds < 2) return;

        var q = userQuestion.Trim();
        userQuestion = "";
        isSending = true;
        lastSentAt = DateTime.UtcNow;

        chatHistory.Add(new ChatBubble(true, q, DateTime.Now, "User", null, new()));

        try
        {
            var res = await AiService.ChatAsync(q, currentSessionToken, Session.CurrentUser.Id);
            currentSessionToken = res.MaPhienChat;
            chatHistory.Add(new ChatBubble(false, res.CauTraLoi, DateTime.Now, res.NguonTraLoi, res.YChinh, res.GoiYKemTheo));
            await LoadSessionsAsync();
        }
        finally
        {
            isSending = false;
        }
    }
}
