@page "/ai-analytics/forecast"
@inject DACNContext Db
@inject GoiYDuLichService AiService
@inject UserSessionService Session

<PageTitle>AI Dự Báo Nhu Cầu & Cảnh Báo Hủy — TV4</PageTitle>

<PageHeader Title="AI Dự Báo Nhu Cầu Phòng & Cảnh Báo Rủi Ro Hủy Đơn"
            Subtitle="Mô hình thống kê theo mùa du lịch (`DuBaoNhuCauDatPhong_AI`) và chấm điểm 6 yếu tố rủi ro hủy (`DuDoanHuyPhong_AI`)"
            Icon="bi bi-graph-up-arrow"
            MemberTag="TV4 — AI FORECAST & CHURN RISK"
            MemberTagClass="member-tag-tv4">
    <Actions>
        @if (Session.HasPermission(Quyen.ViewAIPredictions))
        {
            <button class="hotel-btn hotel-btn-outline" @onclick="RunChurnRiskAsync">
                <i class="bi bi-shield-exclamation"></i> Chấm Điểm Rủi Ro Hủy
            </button>
            <button class="hotel-btn hotel-btn-primary" @onclick="RunDemandForecastAsync">
                <i class="bi bi-cpu-fill"></i> Chạy Dự Báo 14 Ngày Tới
            </button>
        }
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-success alert-dismissible fade show py-2 small mb-3">
        <i class="bi bi-check-circle-fill me-1"></i> @statusMessage
        <button type="button" class="btn-close py-2" @onclick="() => statusMessage = null"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <StatCard Label="Công Suất Dự Báo TB" Value="@($"{avgOccupancy:N1}%")" Icon="bi bi-bar-chart-line-fill" Variant="primary" Subtext="14 ngày tiếp theo" />
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <StatCard Label="Đơn Nguy Cơ Hủy Cao" Value="@highRiskCount.ToString()" Icon="bi bi-exclamation-octagon-fill" Variant="danger" Subtext="Xác suất hủy >= 60%" />
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <StatCard Label="Độ Chính Xác Mô Hình" Value="@($"{modelAccuracy:N1}%")" Icon="bi bi-bullseye" Variant="success" Subtext="Đối chiếu thực tế hủy" />
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <StatCard Label="Phiên Bản Thuật Toán" Value="v1.0-Rule" Icon="bi bi-cpu" Variant="info" Subtext="Giải thích được trọng số" />
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái: Dự báo nhu cầu đặt phòng -->
    <div class="col-12 col-lg-6">
        <div class="hotel-card h-100">
            <div class="hotel-card-header">
                <div class="hotel-card-title">
                    <i class="bi bi-calendar2-range-fill text-primary"></i>
                    <span>Dự Báo Lấp Đầy Theo Hạng Phòng (`DuBaoNhuCauDatPhong_AI`)</span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="hotel-table">
                    <thead>
                        <tr>
                            <th>Ngày Dự Báo</th>
                            <th>Hạng Phòng</th>
                            <th>Số Đơn Dự Báo</th>
                            <th>Lấp Đầy Dự Kiến</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in forecasts)
                        {
                            <tr>
                                <td class="fw-semibold">@f.NgayDuBao.ToString("dd/MM/yyyy")</td>
                                <td>@(f.MaLoaiPhongNavigation?.Ten ?? $"Hạng #{f.MaLoaiPhong}")</td>
                                <td>@f.SoDatPhongDuBao phòng</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar @((f.TyLeLapDayDuBao ?? 0m) >= 80 ? "bg-success" : "bg-primary")"
                                                 style="width: @($"{Math.Clamp(f.TyLeLapDayDuBao ?? 0m, 5m, 100m):0}%")"></div>
                                        </div>
                                        <span class="fw-bold small">@((f.TyLeLapDayDuBao ?? 0m).ToString("N0"))%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Cột phải: Cảnh báo nguy cơ hủy đặt phòng -->
    <div class="col-12 col-lg-6">
        <div class="hotel-card h-100">
            <div class="hotel-card-header">
                <div class="hotel-card-title">
                    <i class="bi bi-shield-exclamation text-danger"></i>
                    <span>Cảnh Báo Nguy Cơ Hủy Đơn (`DuDoanHuyPhong_AI`)</span>
                </div>
                <span class="hotel-badge hotel-badge-danger">6 trọng số đánh giá</span>
            </div>
            <div class="hotel-card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var r in risks)
                    {
                        <div class="list-group-item p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="fw-bold text-dark">
                                    @(r.MaDatPhongNavigation?.MaDatPhong ?? $"#DP-{r.MaDatPhong}") — @(r.MaDatPhongNavigation?.TenKhach ?? "Khách đặt phòng")
                                </div>
                                <span class="hotel-badge @(r.MucDoRuiRo == "high" ? "hotel-badge-danger" : r.MucDoRuiRo == "medium" ? "hotel-badge-warning" : "hotel-badge-success")">
                                    @r.XacSuatHuyPhong.ToString("N0")% (@r.MucDoRuiRo.ToUpper())
                                </span>
                            </div>
                            <p class="text-muted small mb-1">
                                <strong>Yếu tố rủi ro chính:</strong> @r.YeuToChinh
                            </p>
                            <div class="d-flex justify-content-between align-items-center small text-muted">
                                <span>Mô hình: <code>@r.PhienBanMoHinh</code></span>
                                @if (r.ThucTeDaHuy.HasValue)
                                {
                                    <span class="badge @(r.ThucTeDaHuy.Value ? "bg-danger" : "bg-success")">
                                        Thực tế: @(r.ThucTeDaHuy.Value ? "Đã hủy" : "Đã nhận phòng")
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<DuBaoNhuCauDatPhongAi> forecasts = new();
    private List<DuDoanHuyPhongAi> risks = new();
    private decimal avgOccupancy = 75m;
    private int highRiskCount = 0;
    private decimal modelAccuracy = 88.5m;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        forecasts = await Db.DuBaoNhuCauDatPhongAis
            .AsNoTracking()
            .Include(d => d.MaLoaiPhongNavigation)
            .OrderByDescending(d => d.NgayDuBao)
            .Take(16)
            .ToListAsync();

        risks = await Db.DuDoanHuyPhongAis
            .AsNoTracking()
            .Include(r => r.MaDatPhongNavigation)
            .OrderByDescending(r => r.XacSuatHuyPhong)
            .Take(15)
            .ToListAsync();

        if (forecasts.Any())
            avgOccupancy = forecasts.Average(f => f.TyLeLapDayDuBao ?? 0m);

        highRiskCount = risks.Count(r => r.XacSuatHuyPhong >= 60m);

        var evaluated = risks.Where(r => r.ThucTeDaHuy.HasValue).ToList();
        if (evaluated.Any())
        {
            var correct = evaluated.Count(p =>
                (p.XacSuatHuyPhong >= 50m && p.ThucTeDaHuy == true) ||
                (p.XacSuatHuyPhong < 50m && p.ThucTeDaHuy == false));
            modelAccuracy = Math.Round((decimal)correct / evaluated.Count * 100m, 1);
        }
    }

    private async Task RunDemandForecastAsync()
    {
        var count = await AiService.ChayDuBaoNhuCauAsync(14);
        await LoadDataAsync();
        statusMessage = $"Đã chạy mô hình dự báo thống kê 14 ngày tới và cập nhật {count} bản ghi!";
    }

    private async Task RunChurnRiskAsync()
    {
        var count = await AiService.ChayDuDoanHuyPhongAsync();
        await LoadDataAsync();
        statusMessage = $"Đã chấm điểm rủi ro hủy phòng cho {count} đơn đặt phòng!";
    }
}
