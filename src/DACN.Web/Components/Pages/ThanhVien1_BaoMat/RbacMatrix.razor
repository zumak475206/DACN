@page "/admin/rbac"
@inject DACNContext Db
@inject UserSessionService Session
@inject IAuditService AuditService
@inject NavigationManager Nav

<PageTitle>Phân Quyền RBAC — TV1</PageTitle>

<PageHeader Title="Phân Quyền Vai Trò (Role-Based Access Control)"
            Subtitle="Quản lý vai trò hệ thống và thiết lập ma trận 18 quyền hạn thực tế theo từng phân hệ nghiệp vụ"
            Icon="bi bi-shield-lock-fill"
            MemberTag="TV1 — PHÂN QUYỀN RBAC"
            MemberTagClass="member-tag-tv1">
    <Actions>
        @if (Session.HasPermission(Quyen.ManageUsers))
        {
            <button class="hotel-btn hotel-btn-outline" @onclick="() => showCreateModal = !showCreateModal">
                <i class="bi bi-plus-lg"></i> Tạo Vai Trò Mới
            </button>
            <button class="hotel-btn hotel-btn-primary" @onclick="SaveRolePermissionsAsync">
                <i class="bi bi-floppy-fill"></i> Lưu Cấu Hình Phân Quyền
            </button>
        }
    </Actions>
</PageHeader>

@if (!Session.HasPermission(Quyen.ManageUsers))
{
    <div class="alert alert-warning border-0 shadow-sm">
        <i class="bi bi-lock-fill me-2"></i> Bạn cần quyền <strong>ManageUsers</strong> (Quản trị viên — TV1) để thay đổi ma trận phân quyền RBAC.
    </div>
}

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small mb-3">
        <i class="bi @(isError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-1"></i> @statusMessage
        <button type="button" class="btn-close py-2" @onclick="() => statusMessage = null"></button>
    </div>
}

@if (showCreateModal && Session.HasPermission(Quyen.ManageUsers))
{
    <div class="hotel-card mb-4 border-primary">
        <div class="hotel-card-header bg-light">
            <div class="hotel-card-title">
                <i class="bi bi-plus-circle-fill text-primary"></i>
                <span>Thêm Vai Trò Mới</span>
            </div>
        </div>
        <div class="hotel-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-bold">Tên Vai Trò *</label>
                    <input class="form-control hotel-input" placeholder="VD: Supervisor" @bind="newRoleName" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-bold">Mô tả chức năng</label>
                    <input class="form-control hotel-input" placeholder="Giám sát ca trực và kiểm soát chất lượng..." @bind="newRoleDesc" />
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button class="hotel-btn hotel-btn-primary w-100" @onclick="CreateRoleAsync">Lưu</button>
                    <button class="hotel-btn hotel-btn-outline" @onclick="() => showCreateModal = false">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Danh sách Roles -->
    <div class="col-12 col-lg-4">
        <div class="hotel-card h-100">
            <div class="hotel-card-header">
                <div class="hotel-card-title">
                    <i class="bi bi-person-badge-fill text-primary"></i>
                    <span>Vai Trò Hệ Thống</span>
                </div>
                <span class="hotel-badge hotel-badge-info">@roles.Count vai trò</span>
            </div>
            <div class="hotel-card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var r in roles)
                    {
                        <a href="javascript:void(0)" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3 @(selectedRoleId == r.MaId ? "bg-light border-start border-4 border-primary" : "")"
                           @onclick="() => SelectRole(r.MaId)">
                            <div>
                                <div class="fw-bold text-dark">@r.Ten</div>
                                <small class="text-muted">@(string.IsNullOrEmpty(r.MoTa) ? "Chưa có mô tả" : r.MoTa)</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-primary rounded-pill d-block mb-1">@(r.MaQuyenHans?.Count ?? 0) quyền</span>
                                <span class="badge bg-secondary rounded-pill">@(r.NguoiDungs?.Count ?? 0) user</span>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Ma trận 18 quyền hạn thực tế từ bảng QuyenHan -->
    <div class="col-12 col-lg-8">
        <div class="hotel-card h-100">
            <div class="hotel-card-header">
                <div class="hotel-card-title">
                    <i class="bi bi-sliders" style="color: var(--hotel-accent);"></i>
                    <span>Ma Trận Quyền Hạn — @(selectedRole?.Ten ?? $"Vai trò #{selectedRoleId}")</span>
                </div>
                <span class="badge bg-dark">@selectedPermIds.Count / @allPermissions.Count quyền được bật</span>
            </div>
            <div class="hotel-card-body">
                <div class="row g-3">
                    @foreach (var grp in allPermissions.GroupBy(p => p.PhanHe ?? "Chung"))
                    {
                        <div class="col-12">
                            <div class="p-3 rounded border" style="background: var(--hotel-bg-app);">
                                <div class="fw-bold mb-2 text-primary">
                                    <i class="bi bi-folder2-open me-1"></i> Phân hệ: @grp.Key
                                </div>
                                <div class="row g-2">
                                    @foreach (var perm in grp)
                                    {
                                        var isChecked = selectedPermIds.Contains(perm.MaId);
                                        var isLockedAdminPerm = selectedRole?.Ten.Equals("Admin", StringComparison.OrdinalIgnoreCase) == true && perm.Ten == Quyen.ManageUsers;
                                        <div class="col-12 col-md-6">
                                            <label class="form-check-label d-flex align-items-start gap-2 p-2 rounded bg-white border h-100" style="cursor: pointer;">
                                                <input type="checkbox"
                                                       class="form-check-input mt-1"
                                                       checked="@isChecked"
                                                       disabled="@(!Session.HasPermission(Quyen.ManageUsers) || isLockedAdminPerm)"
                                                       @onchange="(e) => TogglePermission(perm.MaId, (bool)(e.Value ?? false))" />
                                                <div>
                                                    <div class="fw-bold small text-dark">@perm.Ten</div>
                                                    <div class="text-muted" style="font-size: 0.75rem;">@perm.MoTa</div>
                                                </div>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Session.HasPermission(Quyen.ManageUsers))
                {
                    <div class="mt-4 d-flex justify-content-between align-items-center">
                        <small class="text-muted">Mọi thay đổi quyền hạn đều được lưu vào Nhật ký kiểm toán (Audit Logs).</small>
                        <button class="hotel-btn hotel-btn-primary" @onclick="SaveRolePermissionsAsync">
                            <i class="bi bi-floppy-fill me-1"></i> Lưu Cấu Hình Phân Quyền
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private int selectedRoleId = 1;
    private List<VaiTro> roles = new();
    private List<QuyenHan> allPermissions = new();
    private HashSet<int> selectedPermIds = new();

    private bool showCreateModal = false;
    private string newRoleName = "";
    private string newRoleDesc = "";
    private string? statusMessage;
    private bool isError = false;

    private VaiTro? selectedRole => roles.FirstOrDefault(r => r.MaId == selectedRoleId);

    protected override async Task OnInitializedAsync()
    {
        if (!Session.HasPermission(Quyen.ManageUsers))
        {
            Nav.NavigateTo("/admin/dashboard");
            return;
        }
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        allPermissions = await Db.QuyenHans.AsNoTracking().OrderBy(q => q.PhanHe).ThenBy(q => q.MaId).ToListAsync();
        roles = await Db.VaiTros
            .AsNoTracking()
            .Include(v => v.MaQuyenHans)
            .Include(v => v.NguoiDungs)
            .OrderBy(v => v.MaId)
            .ToListAsync();

        if (roles.Any() && !roles.Any(r => r.MaId == selectedRoleId))
            selectedRoleId = roles.First().MaId;

        SyncSelectedPermissions();
    }

    private void SelectRole(int roleId)
    {
        selectedRoleId = roleId;
        SyncSelectedPermissions();
        statusMessage = null;
    }

    private void SyncSelectedPermissions()
    {
        var role = roles.FirstOrDefault(r => r.MaId == selectedRoleId);
        selectedPermIds = role?.MaQuyenHans.Select(q => q.MaId).ToHashSet() ?? new HashSet<int>();
    }

    private void TogglePermission(int permId, bool enabled)
    {
        if (enabled) selectedPermIds.Add(permId);
        else selectedPermIds.Remove(permId);
    }

    private async Task SaveRolePermissionsAsync()
    {
        if (!Session.HasPermission(Quyen.ManageUsers))
        {
            statusMessage = "Bạn không có quyền ManageUsers.";
            isError = true;
            return;
        }

        var roleEntity = await Db.VaiTros.Include(v => v.MaQuyenHans).FirstOrDefaultAsync(v => v.MaId == selectedRoleId);
        if (roleEntity == null) return;

        var newPerms = await Db.QuyenHans.Where(q => selectedPermIds.Contains(q.MaId)).ToListAsync();
        if (roleEntity.Ten.Equals("Admin", StringComparison.OrdinalIgnoreCase) &&
            !newPerms.Any(q => q.Ten == Quyen.ManageUsers))
        {
            statusMessage = "Không thể gỡ quyền ManageUsers khỏi vai trò Admin.";
            isError = true;
            return;
        }

        roleEntity.MaQuyenHans.Clear();
        foreach (var p in newPerms)
            roleEntity.MaQuyenHans.Add(p);

        await Db.SaveChangesAsync();

        await AuditService.GhiNhanAsync(
            "CAP_NHAT_QUYEN_VAI_TRO",
            "VaiTro",
            roleEntity.MaId.ToString(),
            $"Cập nhật {newPerms.Count} quyền cho vai trò '{roleEntity.Ten}'",
            Session.CurrentUser.Id,
            Session.CurrentUser.Email,
            "127.0.0.1",
            true);

        await LoadDataAsync();
        isError = false;
        statusMessage = $"Đã lưu {newPerms.Count} quyền hạn cho vai trò '{roleEntity.Ten}' thành công!";
    }

    private async Task CreateRoleAsync()
    {
        if (string.IsNullOrWhiteSpace(newRoleName))
        {
            statusMessage = "Vui lòng nhập tên vai trò.";
            isError = true;
            return;
        }

        var trimmed = newRoleName.Trim();
        if (await Db.VaiTros.AnyAsync(v => v.Ten.ToLower() == trimmed.ToLower()))
        {
            statusMessage = "Tên vai trò này đã tồn tại.";
            isError = true;
            return;
        }

        var role = new VaiTro { Ten = trimmed, MoTa = newRoleDesc?.Trim() };
        Db.VaiTros.Add(role);
        await Db.SaveChangesAsync();

        await AuditService.GhiNhanAsync("TAO_VAI_TRO", "VaiTro", role.MaId.ToString(), $"Tạo vai trò '{role.Ten}'", Session.CurrentUser.Id, Session.CurrentUser.Email, "127.0.0.1", true);

        newRoleName = "";
        newRoleDesc = "";
        showCreateModal = false;
        selectedRoleId = role.MaId;
        await LoadDataAsync();
        isError = false;
        statusMessage = $"Đã tạo vai trò '{role.Ten}' thành công!";
    }
}
