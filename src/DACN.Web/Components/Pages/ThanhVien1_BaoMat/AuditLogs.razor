@page "/admin/audit-logs"
@rendermode InteractiveServer
@inject DACNContext Db

<PageTitle>Nhật Ký Kiểm Toán (Audit Logs) — TV1</PageTitle>

<PageHeader Title="Giám Sát Hệ Thống — Nhật Ký Kiểm Toán (Audit Logs)"
            Subtitle="Theo dõi mọi thao tác trong hệ thống: ai đăng nhập, ai thay đổi dữ liệu, khi nào và từ IP nào"
            Icon="bi bi-journal-check"
            MemberTag="TV1 — AUDIT LOGS"
            MemberTagClass="member-tag-tv1">
    <Actions>
        <button class="hotel-btn hotel-btn-outline" @onclick="LoadDataAsync">
            <i class="bi bi-arrow-clockwise"></i> Làm Mới
        </button>
        <button class="hotel-btn hotel-btn-outline">
            <i class="bi bi-download"></i> Xuất Logs
        </button>
    </Actions>
</PageHeader>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <StatCard Title="Tổng Log Hôm Nay" Value="@logs.Count(l => l.ThoiGian.Date == DateTime.Today).ToString()" Description="Thao tác trong ngày" Icon="bi bi-calendar-check" Variant="info" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Thành Công" Value="@logs.Count(l => l.ThanhCong).ToString()" Description="Thao tác hợp lệ" Icon="bi bi-check-circle-fill" Variant="success" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Thất Bại / Cảnh Báo" Value="@logs.Count(l => !l.ThanhCong).ToString()" Description="Cần kiểm tra ngay" Icon="bi bi-exclamation-triangle-fill" Variant="danger" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Tổng Logs (Hiển thị)" Value="@logs.Count.ToString()" Description="50 bản ghi gần nhất" Icon="bi bi-journal-text" Variant="warning" />
    </div>
</div>

<div class="hotel-card">
    <div class="hotel-card-header">
        <div class="hotel-card-title">
            <i class="bi bi-journal-check text-warning"></i>
            <span>Nhật Ký Hoạt Động Hệ Thống</span>
        </div>
        <div class="d-flex gap-2">
            <input type="text" class="hotel-input" placeholder="Tìm email, hành động..." @bind="searchLog" @bind:event="oninput" style="width:240px;" />
            <select class="hotel-select" @bind="filterStatus" style="width:140px;">
                <option value="">Tất cả</option>
                <option value="success">Thành công</option>
                <option value="failed">Thất bại</option>
            </select>
        </div>
    </div>
    <div class="hotel-card-body p-0">
        <div class="table-responsive">
            <table class="hotel-table">
                <thead>
                    <tr>
                        <th>Thời Gian</th>
                        <th>Tài Khoản</th>
                        <th>Hành Động</th>
                        <th>Đối Tượng</th>
                        <th>Địa Chỉ IP</th>
                        <th>Kết Quả</th>
                        <th>Chi Tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in FilteredLogs)
                    {
                        <tr>
                            <td><small class="font-monospace text-muted">@log.ThoiGian.ToString("dd/MM/yy HH:mm:ss")</small></td>
                            <td><div class="fw-semibold">@(string.IsNullOrEmpty(log.Email) ? "Hệ thống" : log.Email)</div></td>
                            <td><span class="badge bg-light text-dark border font-monospace">@log.HanhDong</span></td>
                            <td><code>@log.DoiTuong</code></td>
                            <td><small class="text-muted">@(log.DiaChiIp ?? "127.0.0.1")</small></td>
                            <td>
                                @if (log.ThanhCong) { <span class="hotel-badge hotel-badge-success">OK</span> }
                                else { <span class="hotel-badge hotel-badge-danger">Lỗi</span> }
                            </td>
                            <td class="text-truncate" style="max-width:220px;" title="@log.NoiDung">
                                <small class="text-muted">@log.NoiDung</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string searchLog = "";
    private string filterStatus = "";
    private List<NhatKyHeThong> logs = new();

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        try { logs = await Db.NhatKyHeThongs.AsNoTracking().OrderByDescending(l => l.ThoiGian).Take(50).ToListAsync(); } catch { }
        if (!logs.Any())
            logs = new List<NhatKyHeThong>
            {
                new NhatKyHeThong { MaId=101, Email="admin@grandhotel.vn", HanhDong="LOGIN", DoiTuong="AUTH", DiaChiIp="192.168.1.15", ThanhCong=true, NoiDung="Đăng nhập quản trị thành công", ThoiGian=DateTime.Now.AddMinutes(-12) },
                new NhatKyHeThong { MaId=102, Email="letan@grandhotel.vn", HanhDong="CHECKIN", DoiTuong="DAT_PHONG", DiaChiIp="192.168.1.20", ThanhCong=true, NoiDung="Check-in khách Nguyễn Văn A — Phòng 301", ThoiGian=DateTime.Now.AddMinutes(-35) },
                new NhatKyHeThong { MaId=103, Email="admin@grandhotel.vn", HanhDong="UPDATE_ROLE", DoiTuong="RBAC", DiaChiIp="192.168.1.15", ThanhCong=true, NoiDung="Cập nhật quyền hạn vai trò Front Desk", ThoiGian=DateTime.Now.AddHours(-2) },
                new NhatKyHeThong { MaId=104, Email="unknown@badip.com", HanhDong="LOGIN_FAILED", DoiTuong="AUTH", DiaChiIp="45.12.89.23", ThanhCong=false, NoiDung="Nhập sai mật khẩu 3 lần liên tiếp — TẠM KHÓA IP", ThoiGian=DateTime.Now.AddHours(-5) }
            };
    }

    private IEnumerable<NhatKyHeThong> FilteredLogs => logs.Where(l =>
        (string.IsNullOrWhiteSpace(searchLog) || (l.Email != null && l.Email.Contains(searchLog, StringComparison.OrdinalIgnoreCase)) || l.HanhDong.Contains(searchLog, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(filterStatus) || (filterStatus == "success" && l.ThanhCong) || (filterStatus == "failed" && !l.ThanhCong)));
}
