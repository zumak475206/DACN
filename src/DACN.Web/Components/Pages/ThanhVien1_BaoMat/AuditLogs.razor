@page "/admin/audit-logs"
@inject DACNContext Db
@inject UserSessionService Session
@inject NavigationManager Nav

<PageTitle>Nhật Ký Kiểm Toán Hệ Thống — TV1</PageTitle>

<PageHeader Title="Nhật Ký Kiểm Toán Hệ Thống (Audit Logs)"
            Subtitle="Giám sát toàn bộ thao tác nhạy cảm: phân quyền RBAC, đăng nhập, phát hành voucher, đặt phòng và thanh toán"
            Icon="bi bi-journal-code"
            MemberTag="TV1 — AUDIT LOGS"
            MemberTagClass="member-tag-tv1">
    <Actions>
        <button class="hotel-btn hotel-btn-outline" @onclick="LoadLogsAsync">
            <i class="bi bi-arrow-clockwise"></i> Làm Mới Nhật Ký
        </button>
    </Actions>
</PageHeader>

<!-- Bộ lọc tìm kiếm -->
<div class="hotel-card mb-4">
    <div class="hotel-card-body py-3">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-5">
                <input class="form-control hotel-input" placeholder="Tìm theo hành động, đối tượng, email, nội dung..." @bind="keyword" @bind:event="oninput" />
            </div>
            <div class="col-6 col-md-4">
                <select class="form-select hotel-input" @bind="filterEntity">
                    <option value="">-- Tất cả đối tượng --</option>
                    <option value="Auth">Auth (Đăng nhập / Bảo mật)</option>
                    <option value="VaiTro">VaiTro (Phân quyền RBAC)</option>
                    <option value="NguoiDung">NguoiDung (Tài khoản)</option>
                    <option value="MaGiamGia">MaGiamGia (Voucher)</option>
                    <option value="DatPhong">DatPhong (Đặt phòng)</option>
                    <option value="HoaDon">HoaDon (Hóa đơn)</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select class="form-select hotel-input" @bind="filterResult">
                    <option value="all">Tất cả kết quả</option>
                    <option value="ok">Thành công</option>
                    <option value="fail">Thất bại / Cảnh báo</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="hotel-card">
    <div class="hotel-card-header">
        <div class="hotel-card-title">
            <i class="bi bi-shield-check text-success"></i>
            <span>Lịch Sử Hoạt Động Hệ Thống (@FilteredLogs.Count() bản ghi)</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="hotel-table">
            <thead>
                <tr>
                    <th>Thời Gian</th>
                    <th>Người Thực Hiện</th>
                    <th>Hành Động</th>
                    <th>Đối Tượng</th>
                    <th>Chi Tiết Nội Dung</th>
                    <th>IP</th>
                    <th>Kết Quả</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in FilteredLogs)
                {
                    <tr>
                        <td class="small text-muted">@log.ThoiGian.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>
                            <div class="fw-semibold">@(log.Email ?? $"User #{log.MaNguoiDung}")</div>
                        </td>
                        <td><span class="badge bg-dark font-monospace">@log.HanhDong</span></td>
                        <td><span class="hotel-badge hotel-badge-info">@log.DoiTuong #@log.KhoaChinh</span></td>
                        <td class="small">@log.NoiDung</td>
                        <td class="small font-monospace text-muted">@(log.DiaChiIp ?? "127.0.0.1")</td>
                        <td>
                            <span class="hotel-badge @(log.ThanhCong ? "hotel-badge-success" : "hotel-badge-danger")">
                                @(log.ThanhCong ? "Thành công" : "Cảnh báo")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<NhatKyHeThong> logs = new();
    private string keyword = "";
    private string filterEntity = "";
    private string filterResult = "all";

    private IEnumerable<NhatKyHeThong> FilteredLogs => logs.Where(l =>
        (string.IsNullOrWhiteSpace(keyword) ||
         (l.HanhDong?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
         (l.NoiDung?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
         (l.Email?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (string.IsNullOrWhiteSpace(filterEntity) || string.Equals(l.DoiTuong, filterEntity, StringComparison.OrdinalIgnoreCase)) &&
        (filterResult == "all" || (filterResult == "ok" ? l.ThanhCong : !l.ThanhCong)));

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanAccessAdmin())
        {
            Nav.NavigateTo("/admin/dashboard");
            return;
        }
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        logs = await Db.NhatKyHeThongs
            .AsNoTracking()
            .OrderByDescending(l => l.ThoiGian)
            .Take(100)
            .ToListAsync();
    }
}
