@page "/admin/content"
@inject DACNContext Db
@inject UserSessionService Session
@inject IAuditService AuditService
@inject NavigationManager Nav

<PageTitle>Quản Trị Nội Dung & Điểm Đến — TV1</PageTitle>

<PageHeader Title="Quản Trị Điểm Tham Quan & Cẩm Nang Du Lịch"
            Subtitle="Quản lý dữ liệu địa điểm check-in (gắn nhãn Gu trải nghiệm cho AI) và bài viết cẩm nang du lịch"
            Icon="bi bi-compass-fill"
            MemberTag="TV1 — NỘI DUNG & ĐỊA ĐIỂM"
            MemberTagClass="member-tag-tv1">
    <Actions>
        @if (CanManageContent)
        {
            <button class="hotel-btn hotel-btn-outline" @onclick="() => showAttractionForm = !showAttractionForm">
                <i class="bi bi-geo-alt-fill"></i> Thêm Địa Điểm
            </button>
            <button class="hotel-btn hotel-btn-primary" @onclick="() => showArticleForm = !showArticleForm">
                <i class="bi bi-journal-plus"></i> Đăng Bài Viết Mới
            </button>
        }
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-success alert-dismissible fade show py-2 small mb-3">
        <i class="bi bi-check-circle-fill me-1"></i> @statusMessage
        <button type="button" class="btn-close py-2" @onclick="() => statusMessage = null"></button>
    </div>
}

@if (showAttractionForm && CanManageContent)
{
    <div class="hotel-card mb-4 border-primary">
        <div class="hotel-card-header bg-light">
            <div class="hotel-card-title">
                <i class="bi bi-geo-alt-fill text-primary"></i>
                <span>Thêm Địa Điểm Check-in / Tham Quan Mới</span>
            </div>
        </div>
        <div class="hotel-card-body">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-bold">Tên Địa Điểm *</label>
                    <input class="form-control hotel-input" placeholder="VD: Đỉnh Bàn Cờ Sơn Trà" @bind="attName" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold">Khoảng cách (km)</label>
                    <input type="number" step="0.5" class="form-control hotel-input" @bind="attDist" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold">Khu vực / Địa chỉ</label>
                    <input class="form-control hotel-input" placeholder="Sơn Trà, Đà Nẵng" @bind="attAddress" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-bold">Gu Trải Nghiệm (AI Tag)</label>
                    <input class="form-control hotel-input" placeholder="songao,thugian,phieuluu" @bind="attVibe" />
                </div>
                <div class="col-12 col-md-9">
                    <label class="form-label small fw-bold">Mô tả điểm nổi bật</label>
                    <input class="form-control hotel-input" placeholder="Điểm ngắm toàn cảnh thành phố và săn mây tuyệt đẹp..." @bind="attDesc" />
                </div>
                <div class="col-12 col-md-3 d-flex align-items-end gap-2">
                    <button class="hotel-btn hotel-btn-primary w-100" @onclick="AddAttractionAsync">Lưu Địa Điểm</button>
                    <button class="hotel-btn hotel-btn-outline" @onclick="() => showAttractionForm = false">Hủy</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showArticleForm && CanManageContent)
{
    <div class="hotel-card mb-4 border-primary">
        <div class="hotel-card-header bg-light">
            <div class="hotel-card-title">
                <i class="bi bi-journal-richtext text-primary"></i>
                <span>Đăng Bài Viết Cẩm Nang Du Lịch (Tự động tạo Slug không dấu)</span>
            </div>
        </div>
        <div class="hotel-card-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-bold">Tiêu Đề Bài Viết *</label>
                    <input class="form-control hotel-input" placeholder="VD: Top 5 Quán Cà Phê Sống Ảo Đẹp Nhất Đà Nẵng" @bind="artTitle" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold">Chuyên Mục</label>
                    <select class="form-select hotel-input" @bind="artCategory">
                        <option value="TravelGuide">Cẩm Nang Du Lịch</option>
                        <option value="FoodAndDrink">Ẩm Thực Địa Phương</option>
                        <option value="Promotion">Tin Khuyến Mãi</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold">Slug Dự Kiến</label>
                    <input class="form-control hotel-input bg-light" readonly value="@GioVN.TaoSlug(artTitle)" />
                </div>
                <div class="col-12 col-md-9">
                    <label class="form-label small fw-bold">Nội dung tóm tắt</label>
                    <textarea class="form-control hotel-input" rows="2" @bind="artContent"></textarea>
                </div>
                <div class="col-12 col-md-3 d-flex align-items-end gap-2">
                    <button class="hotel-btn hotel-btn-primary w-100" @onclick="AddArticleAsync">Đăng Bài</button>
                    <button class="hotel-btn hotel-btn-outline" @onclick="() => showArticleForm = false">Hủy</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Cột trái: Điểm tham quan -->
    <div class="col-12 col-lg-6">
        <div class="hotel-card h-100">
            <div class="hotel-card-header">
                <div class="hotel-card-title">
                    <i class="bi bi-geo-alt-fill text-danger"></i>
                    <span>Điểm Tham Quan & Check-in (@attractions.Count)</span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="hotel-table">
                    <thead>
                        <tr>
                            <th>Địa điểm</th>
                            <th>Khoảng cách</th>
                            <th>Gu AI</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in attractions)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@d.Ten</div>
                                    <small class="text-muted">@d.DiaChi</small>
                                </td>
                                <td>@(d.KhoangCachKm ?? 2.5m) km</td>
                                <td><span class="badge bg-light text-primary border">@(d.PhongCach ?? "songao,thugian")</span></td>
                                <td class="text-end">
                                    @if (CanManageContent)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => HideAttractionAsync(d.MaId)">Ẩn</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Cột phải: Bài viết cẩm nang -->
    <div class="col-12 col-lg-6">
        <div class="hotel-card h-100">
            <div class="hotel-card-header">
                <div class="hotel-card-title">
                    <i class="bi bi-newspaper text-primary"></i>
                    <span>Bài Viết Cẩm Nang Du Lịch (@articles.Count)</span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="hotel-table">
                    <thead>
                        <tr>
                            <th>Tiêu đề & Slug</th>
                            <th>Danh mục</th>
                            <th>Ngày đăng</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in articles)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@b.TieuDe</div>
                                    <small class="text-muted font-monospace">/@b.DuongDanRutGon</small>
                                </td>
                                <td><span class="hotel-badge hotel-badge-info">@b.DanhMuc</span></td>
                                <td class="small">@((b.NgayDang ?? b.NgayTao).ToString("dd/MM/yyyy"))</td>
                                <td class="text-end">
                                    @if (CanManageContent)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => HideArticleAsync(b.MaId)">Ẩn</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<DiaDiemThamQuan> attractions = new();
    private List<BaiViet> articles = new();

    private bool showAttractionForm = false;
    private string attName = "";
    private decimal attDist = 3.0m;
    private string attAddress = "Đà Nẵng";
    private string attVibe = "songao,thugian";
    private string attDesc = "";

    private bool showArticleForm = false;
    private string artTitle = "";
    private string artCategory = "TravelGuide";
    private string artContent = "";

    private string? statusMessage;

    private bool CanManageContent => Session.HasPermission(Quyen.ManageArticles) || Session.HasPermission(Quyen.ManageAIData);

    protected override async Task OnInitializedAsync()
    {
        if (!CanManageContent)
        {
            Nav.NavigateTo("/admin/dashboard");
            return;
        }
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        attractions = await Db.DiaDiemThamQuans.AsNoTracking().Where(d => d.DangHoatDong).OrderBy(d => d.KhoangCachKm).ToListAsync();
        articles = await Db.BaiViets.AsNoTracking().Where(b => b.DangHoatDong).OrderByDescending(b => b.NgayTao).ToListAsync();
    }

    private async Task AddAttractionAsync()
    {
        if (!CanManageContent || string.IsNullOrWhiteSpace(attName)) return;
        var item = new DiaDiemThamQuan
        {
            Ten = attName.Trim(),
            KhoangCachKm = attDist,
            DiaChi = attAddress,
            PhongCach = attVibe,
            MoTa = attDesc,
            DangHoatDong = true
        };
        Db.DiaDiemThamQuans.Add(item);
        await Db.SaveChangesAsync();
        await AuditService.GhiNhanAsync("TAO_DIA_DIEM", "DiaDiemThamQuan", item.MaId.ToString(), $"Thêm địa điểm '{item.Ten}'", Session.CurrentUser.Id, Session.CurrentUser.Email, "127.0.0.1", true);

        attName = "";
        attDesc = "";
        showAttractionForm = false;
        statusMessage = $"Đã thêm địa điểm '{item.Ten}'!";
        await LoadDataAsync();
    }

    private async Task HideAttractionAsync(int id)
    {
        if (!CanManageContent) return;
        var item = await Db.DiaDiemThamQuans.FindAsync(id);
        if (item == null) return;
        item.DangHoatDong = false;
        await Db.SaveChangesAsync();
        await LoadDataAsync();
    }

    private async Task AddArticleAsync()
    {
        if (!CanManageContent || string.IsNullOrWhiteSpace(artTitle)) return;
        var baseSlug = GioVN.TaoSlug(artTitle);
        var slug = await Db.BaiViets.AnyAsync(b => b.DuongDanRutGon == baseSlug)
            ? $"{baseSlug}-{DateTime.UtcNow:HHmmss}"
            : baseSlug;

        var bv = new BaiViet
        {
            TieuDe = artTitle.Trim(),
            DanhMuc = artCategory,
            DuongDanRutGon = slug,
            NoiDung = artContent,
            MaTacGia = Session.CurrentUser.Id,
            NgayDang = DateTime.UtcNow,
            NgayTao = DateTime.UtcNow,
            DangHoatDong = true
        };
        Db.BaiViets.Add(bv);
        await Db.SaveChangesAsync();
        await AuditService.GhiNhanAsync("TAO_BAI_VIET", "BaiViet", bv.MaId.ToString(), $"Đăng bài '{bv.TieuDe}'", Session.CurrentUser.Id, Session.CurrentUser.Email, "127.0.0.1", true);

        artTitle = "";
        artContent = "";
        showArticleForm = false;
        statusMessage = $"Đã đăng bài viết '{bv.TieuDe}' (Slug: /{bv.DuongDanRutGon})!";
        await LoadDataAsync();
    }

    private async Task HideArticleAsync(int id)
    {
        if (!CanManageContent) return;
        var bv = await Db.BaiViets.FindAsync(id);
        if (bv == null) return;
        bv.DangHoatDong = false;
        await Db.SaveChangesAsync();
        await LoadDataAsync();
    }
}
