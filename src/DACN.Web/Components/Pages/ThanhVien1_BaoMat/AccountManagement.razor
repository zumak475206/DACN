@page "/admin/accounts"
@page "/admin"
@inject DACNContext Db
@inject UserSessionService Session
@inject IAuditService AuditService

<PageTitle>Quản Lý Tài Khoản — TV1</PageTitle>

<PageHeader Title="Quản Lý Tài Khoản Người Dùng"
            Subtitle="Quản trị danh sách nhân sự, khách hàng, phân vai trò RBAC và khóa/mở khóa bảo mật"
            Icon="bi bi-people-fill"
            MemberTag="TV1 — QUẢN LÝ TÀI KHOẢN"
            MemberTagClass="member-tag-tv1">
</PageHeader>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small mb-3">
        <i class="bi @(isError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-1"></i> @statusMessage
        <button type="button" class="btn-close py-2" @onclick="() => statusMessage = null"></button>
    </div>
}

<!-- Thống kê nhanh -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <StatCard Label="Tổng Tài Khoản" Value="@users.Count.ToString()" Icon="bi bi-people-fill" Variant="primary" Subtext="Toàn hệ thống" />
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <StatCard Label="Đang Hoạt Động" Value="@users.Count(u => u.TrangThai).ToString()" Icon="bi bi-person-check-fill" Variant="success" Subtext="Đủ quyền truy cập" />
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <StatCard Label="Tài Khoản Nhân Sự" Value="@users.Count(u => u.LoaiNguoiDung == "staff").ToString()" Icon="bi bi-person-workspace" Variant="info" Subtext="Nội bộ khách sạn" />
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <StatCard Label="Đã Khóa / Tạm Ngưng" Value="@users.Count(u => !u.TrangThai).ToString()" Icon="bi bi-person-Fill-lock" Variant="danger" Subtext="Đã thu hồi token" />
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="hotel-card mb-4">
    <div class="hotel-card-body py-3">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-5">
                <input class="form-control hotel-input" placeholder="Tìm theo họ tên, email, số điện thoại..." @bind="searchKeyword" @bind:event="oninput" />
            </div>
            <div class="col-6 col-md-4">
                <select class="form-select hotel-input" @bind="filterRoleId">
                    <option value="0">-- Tất cả vai trò --</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r.MaId">@r.Ten</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select class="form-select hotel-input" @bind="filterStatus">
                    <option value="all">Tất cả trạng thái</option>
                    <option value="active">Đang hoạt động</option>
                    <option value="locked">Đã khóa</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Bảng danh sách người dùng -->
<div class="hotel-card">
    <div class="hotel-card-header">
        <div class="hotel-card-title">
            <i class="bi bi-table text-primary"></i>
            <span>Danh Sách Tài Khoản (@FilteredUsers.Count() kết quả)</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="hotel-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Họ và Tên</th>
                    <th>Email / SĐT</th>
                    <th>Loại</th>
                    <th>Vai Trò (Đổi trực tiếp)</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Bảo Mật</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in FilteredUsers)
                {
                    <tr>
                        <td class="fw-bold">#@u.MaId</td>
                        <td>
                            <div class="fw-semibold text-dark">@u.HoTen</div>
                            <small class="text-muted">Điểm tích lũy: @u.TongDiem</small>
                        </td>
                        <td>
                            <div>@u.Email</div>
                            <small class="text-muted">@(u.SoDienThoai ?? "Chưa cập nhật")</small>
                        </td>
                        <td>
                            <span class="hotel-badge @(u.LoaiNguoiDung == "staff" ? "hotel-badge-info" : "hotel-badge-neutral")">
                                @(u.LoaiNguoiDung == "staff" ? "Nhân sự" : "Khách hàng")
                            </span>
                        </td>
                        <td style="min-width: 170px;">
                            @if (Session.HasPermission(Quyen.ManageUsers))
                            {
                                <select class="form-select form-select-sm"
                                        value="@u.MaVaiTro"
                                        disabled="@(u.MaId == Session.CurrentUser.Id)"
                                        @onchange='(e) => ChangeUserRoleAsync(u, int.Parse(e.Value?.ToString() ?? "6"))'>
                                    @foreach (var r in roles)
                                    {
                                        <option value="@r.MaId">@r.Ten</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@(u.MaVaiTroNavigation?.Ten ?? "Customer")</span>
                            }
                        </td>
                        <td>
                            <StatusBadge Status="@(u.TrangThai ? "Active" : "Locked")" />
                        </td>
                        <td class="text-end">
                            @if (Session.HasPermission(Quyen.ManageUsers) && u.MaId != Session.CurrentUser.Id)
                            {
                                <button class="btn btn-sm @(u.TrangThai ? "btn-outline-danger" : "btn-outline-success")"
                                        @onclick="() => ToggleUserStatusAsync(u)">
                                    <i class="bi @(u.TrangThai ? "bi-lock-fill" : "bi-unlock-fill") me-1"></i>
                                    @(u.TrangThai ? "Khóa" : "Mở khóa")
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<NguoiDung> users = new();
    private List<VaiTro> roles = new();
    private string searchKeyword = "";
    private int filterRoleId = 0;
    private string filterStatus = "all";
    private string? statusMessage;
    private bool isError = false;

    private IEnumerable<NguoiDung> FilteredUsers => users.Where(u =>
        (string.IsNullOrWhiteSpace(searchKeyword) ||
         u.HoTen.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) ||
         u.Email.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) ||
         (u.SoDienThoai != null && u.SoDienThoai.Contains(searchKeyword))) &&
        (filterRoleId == 0 || u.MaVaiTro == filterRoleId) &&
        (filterStatus == "all" || (filterStatus == "active" ? u.TrangThai : !u.TrangThai)));

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        roles = await Db.VaiTros.AsNoTracking().OrderBy(r => r.MaId).ToListAsync();
        users = await Db.NguoiDungs
            .AsNoTracking()
            .Include(u => u.MaVaiTroNavigation)
            .OrderBy(u => u.MaId)
            .ToListAsync();
    }

    private async Task ChangeUserRoleAsync(NguoiDung target, int newRoleId)
    {
        if (!Session.HasPermission(Quyen.ManageUsers)) return;

        var entity = await Db.NguoiDungs.Include(x => x.MaVaiTroNavigation).FirstOrDefaultAsync(x => x.MaId == target.MaId);
        var role = await Db.VaiTros.FindAsync(newRoleId);
        if (entity == null || role == null) return;

        entity.MaVaiTro = role.MaId;
        var isCustomer = role.Ten.Equals("Customer", StringComparison.OrdinalIgnoreCase);
        entity.LoaiNguoiDung = isCustomer ? "customer" : "staff";

        await Db.SaveChangesAsync();
        await AuditService.GhiNhanAsync("CAP_NHAT_VAI_TRO_NGUOI_DUNG", "NguoiDung", entity.MaId.ToString(), $"Đổi vai trò của '{entity.HoTen}' sang '{role.Ten}'", Session.CurrentUser.Id, Session.CurrentUser.Email, "127.0.0.1", true);

        await LoadDataAsync();
        isError = false;
        statusMessage = $"Đã cập nhật vai trò của '{entity.HoTen}' thành '{role.Ten}'.";
    }

    private async Task ToggleUserStatusAsync(NguoiDung target)
    {
        if (!Session.HasPermission(Quyen.ManageUsers)) return;

        var entity = await Db.NguoiDungs.FindAsync(target.MaId);
        if (entity == null) return;

        entity.TrangThai = !entity.TrangThai;
        if (!entity.TrangThai)
        {
            var tokens = await Db.RefreshTokens.Where(t => t.MaNguoiDung == entity.MaId && !t.DaThuHoi).ToListAsync();
            foreach (var t in tokens)
            {
                t.DaThuHoi = true;
                t.NgayThuHoi = DateTime.UtcNow;
                t.LyDoThuHoi = "Khóa tài khoản từ trang Quản trị";
            }
        }

        await Db.SaveChangesAsync();
        await AuditService.GhiNhanAsync(entity.TrangThai ? "KICH_HOAT_TAI_KHOAN" : "VO_HIEU_HOA_TAI_KHOAN", "NguoiDung", entity.MaId.ToString(), $"{(entity.TrangThai ? "Mở khóa" : "Khóa")} tài khoản '{entity.Email}'", Session.CurrentUser.Id, Session.CurrentUser.Email, "127.0.0.1", true);

        await LoadDataAsync();
        isError = false;
        statusMessage = $"Đã {(entity.TrangThai ? "kích hoạt lại" : "khóa và thu hồi phiên đăng nhập của")} tài khoản '{entity.HoTen}'.";
    }
}
