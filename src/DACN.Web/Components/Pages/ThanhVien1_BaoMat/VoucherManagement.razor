@page "/admin/vouchers"
@inject DACNContext Db
@inject UserSessionService Session
@inject IAuditService AuditService

<PageTitle>Quản Trị Kho Voucher — TV1</PageTitle>

<PageHeader Title="Quản Trị Kho Mã Giảm Giá (Vouchers)"
            Subtitle="Thiết lập chiến dịch khuyến mãi theo mùa, giới hạn lượt dùng và mức giảm tối đa"
            Icon="bi bi-ticket-perforated-fill"
            MemberTag="TV1 — KHO VOUCHER"
            MemberTagClass="member-tag-tv1">
    <Actions>
        @if (Session.HasPermission(Quyen.ManageVouchers))
        {
            <button class="hotel-btn hotel-btn-primary" @onclick="() => showForm = !showForm">
                <i class="bi bi-plus-lg"></i> Phát Hành Voucher Mới
            </button>
        }
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small mb-3">
        <i class="bi @(isError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-1"></i> @statusMessage
        <button type="button" class="btn-close py-2" @onclick="() => statusMessage = null"></button>
    </div>
}

@if (showForm && Session.HasPermission(Quyen.ManageVouchers))
{
    <div class="hotel-card mb-4 border-primary">
        <div class="hotel-card-header bg-light">
            <div class="hotel-card-title">
                <i class="bi bi-plus-circle-fill text-primary"></i>
                <span>Phát Hành Mã Giảm Giá Mới</span>
            </div>
        </div>
        <div class="hotel-card-body">
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-bold">Mã Code *</label>
                    <input class="form-control hotel-input text-uppercase" placeholder="VD: SUMMER2026" @bind="formCode" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold">Loại Giảm</label>
                    <select class="form-select hotel-input" @bind="formType">
                        <option value="percent">Phần trăm (%)</option>
                        <option value="fixed">Số tiền cố định (đ)</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold">Giá Trị Giảm *</label>
                    <input type="number" class="form-control hotel-input" @bind="formValue" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold">Đơn Tối Thiểu (đ)</label>
                    <input type="number" class="form-control hotel-input" @bind="formMinOrder" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold">Giảm Tối Đa (đ, cho %)</label>
                    <input type="number" class="form-control hotel-input" @bind="formMaxDiscount" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold">Hiệu Lực Từ</label>
                    <input type="date" class="form-control hotel-input" @bind="formStart" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold">Hiệu Lực Đến</label>
                    <input type="date" class="form-control hotel-input" @bind="formEnd" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold">Giới Hạn Lượt Dùng</label>
                    <input type="number" class="form-control hotel-input" @bind="formLimit" />
                </div>
                <div class="col-6 col-md-3 d-flex align-items-end gap-2">
                    <button class="hotel-btn hotel-btn-primary w-100" @onclick="CreateVoucherAsync">Lưu Voucher</button>
                    <button class="hotel-btn hotel-btn-outline" @onclick="() => showForm = false">Hủy</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Bảng danh sách Voucher -->
<div class="hotel-card">
    <div class="hotel-card-header">
        <div class="hotel-card-title">
            <i class="bi bi-tags-fill text-warning"></i>
            <span>Danh Sách Mã Giảm Giá (@vouchers.Count mã)</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="hotel-table">
            <thead>
                <tr>
                    <th>Mã Code</th>
                    <th>Mức Giảm</th>
                    <th>Đơn Tối Thiểu</th>
                    <th>Giảm Tối Đa</th>
                    <th>Thời Hạn</th>
                    <th>Lượt Sử Dụng</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in vouchers)
                {
                    <tr>
                        <td><span class="badge bg-dark font-monospace fs-6 px-2 py-1">@v.MaCode</span></td>
                        <td class="fw-bold text-primary">
                            @(StatusMapper.IsPercentDiscount(v.LoaiGiamGia) ? $"{v.GiaTriGiamGia:N0}%" : $"{v.GiaTriGiamGia:N0} ₫")
                        </td>
                        <td>@((v.GiaTriDatPhongToiThieu ?? 0).ToString("N0")) ₫</td>
                        <td>@(v.GiamToiDa.HasValue ? $"{v.GiamToiDa.Value:N0} ₫" : "Không giới hạn")</td>
                        <td class="small">@v.HieuLucTu.ToString("dd/MM/yyyy") — @v.HieuLucDen.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-semibold">@v.SoLanDaDung / @v.GioiHanSuDung</span>
                            </div>
                        </td>
                        <td>
                            <StatusBadge Status="@(v.DangHoatDong && v.HieuLucDen >= GioVN.Now ? "Active" : "Cancelled")" />
                        </td>
                        <td class="text-end">
                            @if (Session.HasPermission(Quyen.ManageVouchers))
                            {
                                <button class="btn btn-sm @(v.DangHoatDong ? "btn-outline-danger" : "btn-outline-success")"
                                        @onclick="() => ToggleVoucherAsync(v)">
                                    @(v.DangHoatDong ? "Vô hiệu hóa" : "Kích hoạt")
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<MaGiamGium> vouchers = new();
    private bool showForm = false;
    private string formCode = "";
    private string formType = "percent";
    private decimal formValue = 15;
    private decimal formMinOrder = 1_000_000;
    private decimal? formMaxDiscount = 500_000;
    private DateTime formStart = DateTime.Today;
    private DateTime formEnd = DateTime.Today.AddMonths(2);
    private int formLimit = 100;
    private string? statusMessage;
    private bool isError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadVouchersAsync();
    }

    private async Task LoadVouchersAsync()
    {
        vouchers = await Db.MaGiamGia.AsNoTracking().OrderByDescending(v => v.NgayTao).ToListAsync();
    }

    private async Task CreateVoucherAsync()
    {
        if (!Session.HasPermission(Quyen.ManageVouchers)) return;

        var code = (formCode ?? "").Trim().ToUpperInvariant().Replace(" ", "");
        if (string.IsNullOrWhiteSpace(code))
        {
            statusMessage = "Mã code không được để trống.";
            isError = true;
            return;
        }

        if (formStart >= formEnd)
        {
            statusMessage = "Ngày bắt đầu hiệu lực phải trước ngày kết thúc.";
            isError = true;
            return;
        }

        if (formType == "percent" && (formValue <= 0 || formValue > 100))
        {
            statusMessage = "Mức giảm phần trăm phải từ 1% đến 100%.";
            isError = true;
            return;
        }

        if (await Db.MaGiamGia.AnyAsync(x => x.MaCode.ToUpper() == code))
        {
            statusMessage = "Mã voucher này đã tồn tại.";
            isError = true;
            return;
        }

        var v = new MaGiamGium
        {
            MaCode = code,
            LoaiGiamGia = StatusMapper.NormalizeLoaiGiamGia(formType),
            GiaTriGiamGia = formValue,
            GiaTriDatPhongToiThieu = formMinOrder,
            GiamToiDa = formMaxDiscount,
            HieuLucTu = formStart,
            HieuLucDen = formEnd,
            GioiHanSuDung = Math.Max(1, formLimit),
            SoLanDaDung = 0,
            DangHoatDong = true,
            NgayTao = DateTime.UtcNow
        };

        Db.MaGiamGia.Add(v);
        await Db.SaveChangesAsync();
        await AuditService.GhiNhanAsync("TAO_VOUCHER", "MaGiamGia", v.MaId.ToString(), $"Phát hành mã '{v.MaCode}'", Session.CurrentUser.Id, Session.CurrentUser.Email, "127.0.0.1", true);

        formCode = "";
        showForm = false;
        await LoadVouchersAsync();
        isError = false;
        statusMessage = $"Đã phát hành mã '{v.MaCode}' thành công!";
    }

    private async Task ToggleVoucherAsync(MaGiamGium item)
    {
        var entity = await Db.MaGiamGia.FindAsync(item.MaId);
        if (entity == null) return;
        entity.DangHoatDong = !entity.DangHoatDong;
        await Db.SaveChangesAsync();
        await AuditService.GhiNhanAsync(entity.DangHoatDong ? "KICH_HOAT_VOUCHER" : "VO_HIEU_HOA_VOUCHER", "MaGiamGia", entity.MaId.ToString(), $"Đổi trạng thái mã '{entity.MaCode}'", Session.CurrentUser.Id, Session.CurrentUser.Email, "127.0.0.1", true);
        await LoadVouchersAsync();
    }
}
