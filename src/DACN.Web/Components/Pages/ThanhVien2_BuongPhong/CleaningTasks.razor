@page "/housekeeping/tasks"
@inject DACNContext Db
@inject UserSessionService Session

<PageTitle>Nhật Ký Dọn Phòng — PMS</PageTitle>

<PageHeader Title="Nhật Ký Dọn Phòng"
            Subtitle="Theo dõi nhiệm vụ dọn phòng phát sinh sau check-out, cập nhật bắt đầu và hoàn tất vệ sinh"
            Icon="bi bi-brush-fill"
            MemberTag="TV2 — LỄ TÂN & BUỒNG PHÒNG"
            MemberTagClass="member-tag-tv2">
    <Actions>
        <button class="hotel-btn hotel-btn-outline" @onclick="LoadDataAsync"><i class="bi bi-arrow-clockwise"></i> Làm mới</button>
        <button class="hotel-btn hotel-btn-success" disabled="@isSaving" @onclick="CreateMissingTasksAsync">
            <i class="bi bi-plus-circle"></i> Tạo nhiệm vụ phòng chờ dọn
        </button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (Session.CurrentUser.Role is "Admin" or "Manager")
{
    <div class="d-flex align-items-center gap-2 mb-3 p-2 bg-white rounded-3 shadow-sm border flex-wrap">
        <span class="small fw-bold text-dark"><i class="bi bi-buildings-fill text-primary me-1"></i> Chi nhánh:</span>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn @(selectedBranchId == 0 ? "btn-dark fw-bold" : "btn-outline-secondary")" @onclick="() => FilterBranchAsync(0)">🏨 Toàn Chuỗi</button>
            <button type="button" class="btn @(selectedBranchId == 1 ? "btn-primary fw-bold" : "btn-outline-primary")" @onclick="() => FilterBranchAsync(1)">🌊 Đà Nẵng</button>
            <button type="button" class="btn @(selectedBranchId == 2 ? "btn-info text-white fw-bold" : "btn-outline-info")" @onclick="() => FilterBranchAsync(2)">🌴 Phú Quốc</button>
            <button type="button" class="btn @(selectedBranchId == 3 ? "btn-success fw-bold" : "btn-outline-success")" @onclick="() => FilterBranchAsync(3)">🌲 Đà Lạt</button>
        </div>
    </div>
}
else
{
    <div class="mb-3 px-3 py-2 bg-white border-start border-4 border-success rounded shadow-sm d-flex align-items-center justify-content-between">
        <span class="small text-muted"><i class="bi bi-geo-alt-fill text-success me-1"></i> Ca buồng phòng tại: <strong class="text-dark">@Session.CurrentUser.TenChiNhanh</strong></span>
        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small">Housekeeping Isolation</span>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4"><StatCard Title="Chờ Dọn" Value="@assignedCount.ToString()" Description="Đã có nhiệm vụ, chưa bắt đầu" Icon="bi bi-exclamation-circle" Variant="warning" /></div>
    <div class="col-6 col-md-4"><StatCard Title="Đang Dọn" Value="@inProgressCount.ToString()" Description="Nhân viên đang xử lý" Icon="bi bi-hourglass-split" Variant="primary" /></div>
    <div class="col-12 col-md-4"><StatCard Title="Hoàn Tất Hôm Nay" Value="@completedTodayCount.ToString()" Description="Nhật ký đã ghi nhận" Icon="bi bi-check2-circle" Variant="success" /></div>
</div>

<div class="hotel-card">
    <div class="hotel-card-header">
        <div class="hotel-card-title"><i class="bi bi-list-task text-success"></i><span>Lịch Sử & Nhiệm Vụ Buồng Phòng</span></div>
        <input type="search" class="hotel-input" placeholder="Tìm số phòng, ghi chú..." @bind="searchTask" @bind:event="oninput" />
    </div>
    <div class="px-3 pt-2 small text-muted">Hiển thị 100 nhật ký gần nhất và toàn bộ nhiệm vụ đang mở.</div>
    <div class="hotel-table-container">
        <table class="hotel-table">
            <thead><tr><th>Phòng / Tầng</th><th>Nhân viên</th><th>Phân công</th><th>Bắt đầu</th><th>Hoàn tất</th><th>Ghi chú</th><th>Trạng thái</th><th class="text-end">Cập nhật</th></tr></thead>
            <tbody>
                @if (isLoading)
                {
                    <tr><td colspan="8" class="text-center py-4">Đang tải nhật ký...</td></tr>
                }
                else if (!FilteredTasks.Any())
                {
                    <tr><td colspan="8" class="text-center py-4 text-muted">Chưa có nhật ký phù hợp.</td></tr>
                }
                else
                {
                    @foreach (var task in FilteredTasks)
                    {
                        <tr>
                            <td><strong>Phòng @task.MaPhongNavigation.SoPhong</strong><div class="small text-muted">Tầng @(task.MaPhongNavigation.Tang?.ToString() ?? "—") · @task.MaPhongNavigation.MaLoaiPhongNavigation.Ten</div></td>
                            <td>@(task.MaNhanVienNavigation?.HoTen ?? "Chưa phân công")</td>
                            <td>@task.ThoiGianPhanCong.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            <td>@(task.ThoiGianBatDau?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")</td>
                            <td>@(task.ThoiGianHoanTat?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")</td>
                            <td>@(task.GhiChuKiemTra ?? "—")</td>
                            <td><StatusBadge Status="@task.TrangThai" /></td>
                            <td class="text-end">
                                @if (task.TrangThai == "assigned")
                                {
                                    <button class="hotel-btn hotel-btn-primary py-1 px-2" disabled="@isSaving" @onclick='() => UpdateTaskAsync(task.MaId, "in_progress")'>
                                        <i class="bi bi-play-fill"></i> Bắt đầu
                                    </button>
                                }
                                else if (task.TrangThai == "in_progress")
                                {
                                    <button class="hotel-btn hotel-btn-success py-1 px-2" disabled="@isSaving" @onclick='() => UpdateTaskAsync(task.MaId, "done")'>
                                        <i class="bi bi-check-lg"></i> Hoàn tất
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">Đã ghi nhận</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private bool isLoading = true;
    private bool isSaving;
    private string searchTask = "";
    private string? errorMessage;
    private string? successMessage;
    private List<NhatKyBuongPhong> tasks = [];
    private int assignedCount;
    private int inProgressCount;
    private int completedTodayCount;

    private IEnumerable<NhatKyBuongPhong> FilteredTasks => tasks.Where(task =>
        string.IsNullOrWhiteSpace(searchTask)
        || task.MaPhongNavigation.SoPhong.Contains(searchTask, StringComparison.OrdinalIgnoreCase)
        || (task.GhiChuKiemTra?.Contains(searchTask, StringComparison.OrdinalIgnoreCase) ?? false));

    private int selectedBranchId = 0;

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentUser.Role is not ("Admin" or "Manager"))
        {
            selectedBranchId = Session.CurrentUser.MaChiNhanh;
        }
        await LoadDataAsync();
    }

    private async Task FilterBranchAsync(int branchId)
    {
        selectedBranchId = branchId;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        tasks = [];
        assignedCount = 0;
        inProgressCount = 0;
        completedTodayCount = 0;
        try
        {
            var effectiveBranchId = (Session.CurrentUser.Role is "Admin" or "Manager")
                ? selectedBranchId
                : Session.CurrentUser.MaChiNhanh;

            var localDayStart = DateTime.Today;
            var utcDayStart = TimeZoneInfo.ConvertTimeToUtc(localDayStart, TimeZoneInfo.Local);
            var utcNextDayStart = TimeZoneInfo.ConvertTimeToUtc(localDayStart.AddDays(1), TimeZoneInfo.Local);

            var query = Db.NhatKyBuongPhongs.AsNoTracking().AsQueryable();
            if (effectiveBranchId > 0)
            {
                query = query.Where(t => t.MaPhongNavigation.MaChiNhanh == effectiveBranchId);
            }

            assignedCount = await query.CountAsync(task => task.TrangThai == "assigned");
            inProgressCount = await query.CountAsync(task => task.TrangThai == "in_progress");
            completedTodayCount = await query.CountAsync(task =>
                (task.TrangThai == "done" || task.TrangThai == "inspected")
                && task.ThoiGianHoanTat.HasValue
                && task.ThoiGianHoanTat >= utcDayStart
                && task.ThoiGianHoanTat < utcNextDayStart);

            var recentTasks = await query
                .Include(task => task.MaPhongNavigation).ThenInclude(room => room.MaLoaiPhongNavigation)
                .Include(task => task.MaNhanVienNavigation)
                .OrderByDescending(task => task.NgayTao)
                .Take(100)
                .ToListAsync();
            var openTasks = await query
                .Include(task => task.MaPhongNavigation).ThenInclude(room => room.MaLoaiPhongNavigation)
                .Include(task => task.MaNhanVienNavigation)
                .Where(task => task.TrangThai == "assigned" || task.TrangThai == "in_progress")
                .OrderByDescending(task => task.NgayTao)
                .ToListAsync();
            tasks = recentTasks.Concat(openTasks)
                .GroupBy(task => task.MaId)
                .Select(group => group.First())
                .OrderByDescending(task => task.NgayTao)
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể tải nhật ký dọn phòng: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateMissingTasksAsync()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            await using (var transaction = await Db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable))
            {
            var effectiveBranchId = (Session.CurrentUser.Role is "Admin" or "Manager")
                ? (selectedBranchId > 0 ? selectedBranchId : Session.CurrentUser.MaChiNhanh)
                : Session.CurrentUser.MaChiNhanh;

            var dirtyRoomQuery = Db.Phongs
                .Where(room =>
                    (room.TrangThaiVeSinh == "Dirty"
                        || room.TrangThaiVeSinh == "dirty"
                        || room.TrangThaiVeSinh == "ban"
                        || room.TrangThaiVeSinh == "can_don"
                        || room.TrangThaiVeSinh == "Inspecting"
                        || room.TrangThaiVeSinh == "dang_don"
                        || room.TrangThaiVeSinh == "don_dep"
                        || room.TrangThaiVeSinh == "chua_don")
                    && room.TrangThai != "Occupied"
                    && room.TrangThai != "occupied"
                    && room.TrangThai != "dang_o"
                    && room.TrangThai != "Maintenance"
                    && room.TrangThai != "maintenance"
                    && room.TrangThai != "sua_chua");

            if (effectiveBranchId > 0)
            {
                dirtyRoomQuery = dirtyRoomQuery.Where(r => r.MaChiNhanh == effectiveBranchId);
            }

            var dirtyRooms = await dirtyRoomQuery.ToListAsync();
            var openRoomIds = await Db.NhatKyBuongPhongs
                .Where(task => task.TrangThai == "assigned" || task.TrangThai == "in_progress")
                .Select(task => task.MaPhong)
                .Distinct()
                .ToListAsync();
            var now = DateTime.UtcNow;
            var newTasks = dirtyRooms.Where(room => !openRoomIds.Contains(room.MaId))
                .Select(room => new NhatKyBuongPhong
                {
                    MaPhong = room.MaId,
                    TrangThai = "assigned",
                    ThoiGianPhanCong = now,
                    GhiChuKiemTra = "Phòng cần vệ sinh sau lưu trú.",
                    NgayTao = now
                }).ToList();
            if (newTasks.Count > 0)
            {
                Db.NhatKyBuongPhongs.AddRange(newTasks);
                await Db.SaveChangesAsync();
            }
            await transaction.CommitAsync();
            successMessage = newTasks.Count == 0
                ? "Không có phòng chờ dọn mới."
                : $"Đã tạo {newTasks.Count} nhiệm vụ dọn phòng.";
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể tạo nhiệm vụ dọn phòng: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UpdateTaskAsync(int taskId, string status)
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            await using (var transaction = await Db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable))
            {
            var task = await Db.NhatKyBuongPhongs.Include(item => item.MaPhongNavigation)
                .FirstOrDefaultAsync(item => item.MaId == taskId);
            if (task == null)
                throw new InvalidOperationException("Không tìm thấy nhiệm vụ dọn phòng.");
            var room = task.MaPhongNavigation;
            if (status == "in_progress")
            {
                if (task.TrangThai != "assigned")
                    throw new InvalidOperationException("Chỉ có thể bắt đầu nhiệm vụ đang chờ xử lý.");
                if (IsRoomOccupied(room.TrangThai) || IsRoomMaintenance(room.TrangThai) || !IsRoomDirty(room.TrangThaiVeSinh))
                    throw new InvalidOperationException("Phòng không còn ở trạng thái phù hợp để bắt đầu dọn.");
                if (Session.CurrentUser.IsLoggedIn && Session.CurrentUser.Id > 0)
                {
                    task.MaNhanVien ??= Session.CurrentUser.Id;
                }
                task.TrangThai = "in_progress";
                task.ThoiGianBatDau ??= DateTime.UtcNow;
                room.TrangThaiVeSinh = "Inspecting";
            }
            else if (status == "done")
            {
                if (task.TrangThai != "in_progress")
                    throw new InvalidOperationException("Chỉ có thể hoàn tất nhiệm vụ đang được xử lý.");
                if (IsRoomOccupied(room.TrangThai) || IsRoomMaintenance(room.TrangThai))
                    throw new InvalidOperationException("Không thể hoàn tất vệ sinh khi phòng đang có khách hoặc bảo trì.");
                if (!IsRoomDirty(room.TrangThaiVeSinh))
                    throw new InvalidOperationException("Phòng không còn ở trạng thái chờ vệ sinh.");
                if (Session.CurrentUser.IsLoggedIn && Session.CurrentUser.Id > 0)
                {
                    task.MaNhanVien ??= Session.CurrentUser.Id;
                }
                task.TrangThai = "done";
                task.ThoiGianHoanTat = DateTime.UtcNow;
                room.TrangThaiVeSinh = "Clean";
                if (!IsRoomOccupied(room.TrangThai) && !IsRoomReserved(room.TrangThai) && !IsRoomMaintenance(room.TrangThai))
                    room.TrangThai = "Available";
            }
            else
            {
                throw new InvalidOperationException("Trạng thái nhiệm vụ không hợp lệ.");
            }

            await Db.SaveChangesAsync();
            await transaction.CommitAsync();
            }
            successMessage = status == "done" ? "Đã hoàn tất dọn phòng." : "Đã ghi nhận bắt đầu dọn phòng.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể cập nhật nhật ký: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static bool IsRoomOccupied(string? status) =>
        status is "Occupied" or "occupied" or "dang_o";

    private static bool IsRoomReserved(string? status) =>
        status is "Reserved" or "reserved" or "da_dat";

    private static bool IsRoomMaintenance(string? status) =>
        status is "Maintenance" or "maintenance" or "sua_chua";

    private static bool IsRoomDirty(string? status) =>
        status is "Dirty" or "dirty" or "ban" or "can_don" or "Inspecting" or "dang_don" or "don_dep" or "chua_don";
}
