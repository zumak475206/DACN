@page "/housekeeping/tasks"
@inject DACNContext Db

<PageTitle>Nhật Ký & Phân Công Dọn Phòng — TV2</PageTitle>

<PageHeader Title="Nhật Ký & Phân Công Dọn Buồng Phòng"
            Subtitle="Phân công nhân viên dọn phòng theo ca, ghi nhận thời gian bắt đầu và duyệt kết quả làm sạch"
            Icon="bi bi-brush-fill"
            MemberTag="TV2 — NHẬT KÝ DỌN PHÒNG"
            MemberTagClass="member-tag-tv2">
    <Actions>
        <button class="hotel-btn hotel-btn-outline" @onclick="LoadDataAsync">
            <i class="bi bi-arrow-clockwise"></i> Tải lại
        </button>
        <button class="hotel-btn hotel-btn-success">
            <i class="bi bi-plus-circle"></i> Tạo Ca Dọn Mới
        </button>
    </Actions>
</PageHeader>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <StatCard Title="Phòng Cần Dọn" Value="@tasksNeedClean.Count.ToString()" Description="Ưu tiên xử lý trước 14h" Icon="bi bi-exclamation-circle-fill" Variant="warning" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Đang Dọn Dẹp" Value="@tasksInProgress.ToString()" Description="Nhân viên đang trong phòng" Icon="bi bi-hourglass-split" Variant="primary" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Đã Hoàn Tất Ca" Value="@tasksDoneCount.ToString()" Description="Đã duyệt kiểm tra sạch sẽ" Icon="bi bi-check2-circle" Variant="success" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Nhân Lực Buồng Phòng" Value="6 nhân viên" Description="Ca sáng (06h - 14h)" Icon="bi bi-people" Variant="info" />
    </div>
</div>

<div class="hotel-card mb-4">
    <div class="hotel-card-header">
        <div class="hotel-card-title">
            <i class="bi bi-list-task text-success"></i>
            <span>Bảng Nhiệm Vụ Dọn Phòng Trong Ca</span>
        </div>
        <div class="d-flex gap-2">
            <input type="text" class="hotel-input" placeholder="Tìm theo số phòng, nhân viên..." @bind="searchTask" @bind:event="oninput" style="width: 240px;" />
        </div>
    </div>
    <div class="hotel-card-body p-0">
        <div class="table-responsive">
            <table class="hotel-table">
                <thead>
                    <tr>
                        <th>Số Phòng</th>
                        <th>Loại Phòng</th>
                        <th>Nhân Viên Đảm Nhận</th>
                        <th>Thời Điểm Nhận</th>
                        <th>Ghi Chú Vệ Sinh</th>
                        <th>Trạng Thái</th>
                        <th class="text-end">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!tasksNeedClean.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Tuyệt vời! Tất cả các phòng trong ca trực đều đã được dọn sạch sẽ.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var room in tasksNeedClean)
                        {
                            <tr>
                                <td>
                                    <strong class="fs-6">Phòng @room.SoPhong</strong>
                                    <div class="text-muted small">Tầng @room.SoPhong.ToString().Substring(0, 1)</div>
                                </td>
                                <td>@room.MaLoaiPhongNavigation?.Ten</td>
                                <td>
                                    <span class="badge bg-warning text-dark"><i class="bi bi-person-fill"></i> Nguyễn Thị Buồng Phòng</span>
                                </td>
                                <td><small class="text-muted">11:30 (Khách vừa trả)</small></td>
                                <td>
                                    <span class="text-danger small"><i class="bi bi-exclamation-triangle"></i> Thay toàn bộ ga giường, lau sàn & kiểm tra minibar</span>
                                </td>
                                <td>
                                    <StatusBadge Status="@(room.TrangThaiVeSinh == "Dirty" || room.TrangThaiVeSinh == "Inspecting" ? room.TrangThaiVeSinh : room.TrangThai)" />
                                </td>
                                <td class="text-end">
                                    <button class="hotel-btn hotel-btn-success py-1 px-3" style="font-size: 0.8rem;" @onclick="() => HoanTatVeSinh(room.MaId)">
                                        <i class="bi bi-check-lg"></i> Duyệt Hoàn Tất
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string searchTask = "";
    private List<Phong> allRooms = new();
    private int tasksDoneCount = 14;
    private int tasksInProgress = 2;

    private List<Phong> tasksNeedClean => allRooms
        .Where(r => r.TrangThaiVeSinh == "Dirty" || r.TrangThaiVeSinh == "Inspecting" || r.TrangThai == "don_dep" || r.TrangThai == "chua_don")
        .Where(r => string.IsNullOrWhiteSpace(searchTask) || r.SoPhong.ToString().Contains(searchTask))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            allRooms = await Db.Phongs
                .AsNoTracking()
                .Include(p => p.MaLoaiPhongNavigation)
                .OrderBy(p => p.SoPhong)
                .ToListAsync();
        }
        catch { }
    }

    private async Task HoanTatVeSinh(int roomId)
    {
        var room = await Db.Phongs.FindAsync(roomId);
        if (room != null)
        {
            if (room.TrangThai != "Occupied" && room.TrangThai != "Reserved")
                room.TrangThai = "Available";
            room.TrangThaiVeSinh = "Clean";
            await Db.SaveChangesAsync();
            tasksDoneCount++;
            await LoadDataAsync();
        }
    }
}
