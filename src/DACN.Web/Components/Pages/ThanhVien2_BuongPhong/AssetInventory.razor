@page "/housekeeping/assets"
@inject DACNContext Db

<PageTitle>Kiểm Kê Tiện Nghi & Tài Sản — TV2</PageTitle>

<PageHeader Title="Kiểm Kê Tiện Nghi & Tài Sản Phòng"
            Subtitle="Tra cứu danh mục tài sản và các ghi nhận hư hỏng từ dữ liệu hệ thống"
            Icon="bi bi-box-seam-fill"
            MemberTag="TV2 — TÀI SẢN & TIỆN NGHI"
            MemberTagClass="member-tag-tv2">
    <Actions>
        <button class="hotel-btn hotel-btn-outline" disabled="@isLoading" @onclick="LoadDataAsync">
            <i class="bi bi-arrow-clockwise"></i> Làm mới
        </button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <StatCard Title="Danh Mục Đang Hoạt Động" Value="@assets.Count.ToString()" Description="Số loại tài sản theo phòng" Icon="bi bi-boxes" Variant="info" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Tổng Số Lượng" Value="@assets.Sum(asset => asset.SoLuong).ToString()" Description="Theo danh mục đang hoạt động" Icon="bi bi-check-circle" Variant="success" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Ghi Nhận Hư Hỏng 7 Ngày" Value="@recentDamageCount.ToString()" Description="Lượt ghi nhận trong hệ thống" Icon="bi bi-exclamation-octagon" Variant="warning" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Tiền Phạt Được Ghi Nhận" Value="@($"{recentDamageAmount:N0} đ")" Description="Không đồng nghĩa đã thu tiền" Icon="bi bi-cash-coin" Variant="accent" />
    </div>
</div>

<div class="hotel-card">
    <div class="hotel-card-header">
        <div class="hotel-card-title">
            <i class="bi bi-card-checklist text-success"></i>
            <span>Danh Mục Tài Sản Phòng</span>
        </div>
        <input type="search" class="hotel-input" placeholder="Tìm tài sản, phòng..." @bind="searchAsset" @bind:event="oninput" />
    </div>
    <div class="hotel-table-container">
        <table class="hotel-table">
            <thead>
                <tr>
                    <th>Phòng</th>
                    <th>Tên Tài Sản</th>
                    <th>Loại</th>
                    <th>Số Lượng</th>
                    <th>Đơn Giá Đền Bù</th>
                    <th>Ghi Chú</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr><td colspan="7" class="text-center py-4">Đang tải danh mục tài sản...</td></tr>
                }
                else if (!FilteredAssets.Any())
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">Không có tài sản phù hợp trong danh mục.</td></tr>
                }
                else
                {
                    @foreach (var asset in FilteredAssets)
                    {
                        <tr>
                            <td><strong>P.@asset.MaPhongNavigation.SoPhong</strong></td>
                            <td class="fw-bold">@asset.TenTaiSan</td>
                            <td>@(asset.LoaiTaiSan ?? "—")</td>
                            <td>@asset.SoLuong</td>
                            <td class="fw-bold">@asset.GiaDenBu.ToString("N0") đ</td>
                            <td>@(asset.GhiChu ?? "—")</td>
                            <td><StatusBadge Status="Active" /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private bool isLoading = true;
    private string searchAsset = "";
    private string? errorMessage;
    private int recentDamageCount;
    private decimal recentDamageAmount;
    private List<TaiSanPhong> assets = [];

    private IEnumerable<TaiSanPhong> FilteredAssets => assets.Where(asset =>
        string.IsNullOrWhiteSpace(searchAsset)
        || asset.TenTaiSan.Contains(searchAsset, StringComparison.OrdinalIgnoreCase)
        || asset.MaPhongNavigation.SoPhong.Contains(searchAsset, StringComparison.OrdinalIgnoreCase)
        || (asset.LoaiTaiSan?.Contains(searchAsset, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override Task OnInitializedAsync() => LoadDataAsync();

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        assets = [];
        try
        {
            assets = await Db.TaiSanPhongs.AsNoTracking()
                .Include(asset => asset.MaPhongNavigation)
                .Where(asset => asset.DangHoatDong)
                .OrderBy(asset => asset.MaPhongNavigation.SoPhong)
                .ThenBy(asset => asset.TenTaiSan)
                .ToListAsync();

            var lastSevenDays = DateTime.UtcNow.AddDays(-7);
            var recentDamageAmounts = await Db.MatMatHuHongs.AsNoTracking()
                .Where(report => report.NgayTao >= lastSevenDays)
                .Select(report => report.TienPhat)
                .ToListAsync();
            recentDamageCount = recentDamageAmounts.Count;
            recentDamageAmount = recentDamageAmounts.Sum();
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể tải dữ liệu tài sản: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
