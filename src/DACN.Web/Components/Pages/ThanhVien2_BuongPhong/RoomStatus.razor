@page "/housekeeping/rooms"
@inject DACNContext Db

<PageTitle>Trạng Thái Buồng Phòng — TV2</PageTitle>

<PageHeader Title="Trạng Thái Buồng Phòng"
            Subtitle="Tra cứu sơ đồ theo tầng, nhận biết phòng sẵn sàng và đồng bộ yêu cầu vệ sinh vào nhật ký"
            Icon="bi bi-door-closed-fill"
            MemberTag="TV2 — FRONT-DESK & VẬN HÀNH"
            MemberTagClass="member-tag-tv2">
    <Actions>
        <a href="/frontdesk/bookings" class="hotel-btn hotel-btn-primary">
            <i class="bi bi-grid-3x3-gap-fill"></i> Sơ Đồ Lễ Tân
        </a>
        <a href="/housekeeping/tasks" class="hotel-btn hotel-btn-outline">
            <i class="bi bi-brush"></i> Nhật Ký Dọn
        </a>
        <button class="hotel-btn hotel-btn-outline" @onclick="LoadDataAsync">
            <i class="bi bi-arrow-clockwise"></i> Làm mới
        </button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <StatCard Title="Trống & Sạch" Value="@cleanCount.ToString()" Description="Sẵn sàng nhận khách" Icon="bi bi-shield-check" Variant="success" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Chờ Dọn / Đang Dọn" Value="@cleaningNeededCount.ToString()" Description="Có thể xem trong nhật ký" Icon="bi bi-brush" Variant="warning" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Đang Có Khách" Value="@occupiedCount.ToString()" Description="Đang lưu trú" Icon="bi bi-person-fill" Variant="info" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Bảo Trì" Value="@maintenanceCount.ToString()" Description="Không thể xếp khách" Icon="bi bi-tools" Variant="danger" />
    </div>
</div>

<div class="hotel-card mb-4">
    <div class="hotel-card-header">
        <div class="hotel-card-title">
            <i class="bi bi-grid-fill text-success"></i>
            <span>Sơ Đồ Buồng Phòng</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <select class="hotel-select" @bind="floorFilter" aria-label="Lọc theo tầng">
                <option value="">Tất cả tầng</option>
                @foreach (var floor in floors)
                {
                    <option value="@floor">Tầng @floor</option>
                }
            </select>
            <select class="hotel-select" @bind="filterStatus" aria-label="Lọc theo trạng thái">
                <option value="">Tất cả trạng thái</option>
                <option value="ready">Trống sạch</option>
                <option value="occupied">Đang ở</option>
                <option value="dirty">Chờ dọn</option>
                <option value="maintenance">Bảo trì</option>
            </select>
        </div>
    </div>
    <div class="hotel-card-body">
        @if (isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2">Đang tải sơ đồ buồng phòng...</div>
            </div>
        }
        else if (!FilteredRooms.Any())
        {
            <div class="text-center py-4 text-muted">Không có phòng phù hợp với bộ lọc.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var room in FilteredRooms)
                {
                    <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                        <article class="room-box h-100">
                            <div class="room-box-header">
                                <span class="room-box-number">P.@room.SoPhong</span>
                                <span class="room-status-indicator @RoomStatusClass(room)"></span>
                            </div>
                            <div class="room-box-type text-truncate">@room.MaLoaiPhongNavigation?.Ten</div>
                            <div class="small text-muted mt-1">Tầng @(room.Tang?.ToString() ?? "—")</div>
                            <div class="mt-2"><StatusBadge Status="@RoomBadgeStatus(room)" /></div>
                            <div class="mt-2">
                                @if (IsRoomDirty(room) && !IsRoomOccupied(room.TrangThai) && !IsRoomMaintenance(room.TrangThai))
                                {
                                    <button class="hotel-btn hotel-btn-success py-1 px-2 w-100"
                                            disabled="@isSaving"
                                            @onclick="() => XacNhanSachAsync(room.MaId)">
                                        <i class="bi bi-check-lg"></i> Hoàn tất dọn
                                    </button>
                                }
                                else if (IsReady(room))
                                {
                                    <button class="hotel-btn hotel-btn-outline py-1 px-2 w-100"
                                            disabled="@isSaving"
                                            @onclick="() => BaoCanDonAsync(room.MaId)">
                                        <i class="bi bi-brush"></i> Báo cần dọn
                                    </button>
                                }
                                else
                                {
                                    <span class="d-block text-muted small text-center">Không khả dụng</span>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private bool isSaving;
    private string filterStatus = "";
    private string floorFilter = "";
    private string? errorMessage;
    private string? successMessage;
    private List<Phong> rooms = [];

    private int cleanCount => rooms.Count(IsReady);
    private int cleaningNeededCount => rooms.Count(IsRoomDirty);
    private int occupiedCount => rooms.Count(room => IsRoomOccupied(room.TrangThai));
    private int maintenanceCount => rooms.Count(room => IsRoomMaintenance(room.TrangThai));
    private IEnumerable<int> floors => rooms.Where(room => room.Tang.HasValue)
        .Select(room => room.Tang!.Value)
        .Distinct()
        .OrderBy(floor => floor);

    private IEnumerable<Phong> FilteredRooms => rooms.Where(room =>
        (string.IsNullOrEmpty(floorFilter) || room.Tang?.ToString() == floorFilter)
        && (string.IsNullOrEmpty(filterStatus)
            || (filterStatus == "ready" && IsReady(room))
            || (filterStatus == "occupied" && IsRoomOccupied(room.TrangThai))
            || (filterStatus == "dirty" && IsRoomDirty(room))
            || (filterStatus == "maintenance" && IsRoomMaintenance(room.TrangThai))));

    protected override Task OnInitializedAsync() => LoadDataAsync();

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        rooms = [];
        try
        {
            rooms = await Db.Phongs.AsNoTracking()
                .Include(room => room.MaLoaiPhongNavigation)
                .OrderBy(room => room.Tang)
                .ThenBy(room => room.SoPhong)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể tải sơ đồ buồng phòng: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task BaoCanDonAsync(int roomId)
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            await using (var transaction = await Db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable))
            {
            var room = await Db.Phongs.FirstOrDefaultAsync(item => item.MaId == roomId);
            if (room == null || !IsReady(room))
                throw new InvalidOperationException("Phòng không còn ở trạng thái trống sạch. Vui lòng tải lại sơ đồ.");

            var hasOpenTask = await Db.NhatKyBuongPhongs.AnyAsync(task =>
                task.MaPhong == roomId && (task.TrangThai == "assigned" || task.TrangThai == "in_progress"));
            if (hasOpenTask)
                throw new InvalidOperationException("Phòng đã có nhiệm vụ dọn đang mở.");

            var now = DateTime.UtcNow;
            room.TrangThaiVeSinh = "Dirty";
            Db.NhatKyBuongPhongs.Add(new NhatKyBuongPhong
            {
                MaPhong = roomId,
                TrangThai = "assigned",
                ThoiGianPhanCong = now,
                GhiChuKiemTra = $"Yêu cầu dọn phòng {room.SoPhong} từ màn trạng thái buồng phòng.",
                NgayTao = now
            });
            await Db.SaveChangesAsync();
            await transaction.CommitAsync();
            successMessage = $"Đã tạo nhiệm vụ dọn phòng {room.SoPhong}.";
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể tạo yêu cầu dọn phòng: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task XacNhanSachAsync(int roomId)
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            await using (var transaction = await Db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable))
            {
            var room = await Db.Phongs.FirstOrDefaultAsync(item => item.MaId == roomId);
            if (room == null || IsRoomOccupied(room.TrangThai) || IsRoomMaintenance(room.TrangThai))
                throw new InvalidOperationException("Không thể hoàn tất vệ sinh cho phòng đang có khách, bảo trì hoặc không tồn tại.");
            if (!IsRoomDirty(room))
                throw new InvalidOperationException("Phòng không còn ở trạng thái chờ dọn.");

            var openTask = await Db.NhatKyBuongPhongs
                .Where(task => task.MaPhong == roomId && (task.TrangThai == "assigned" || task.TrangThai == "in_progress"))
                .OrderByDescending(task => task.ThoiGianPhanCong)
                .FirstOrDefaultAsync();
            var now = DateTime.UtcNow;
            if (openTask == null)
            {
                openTask = new NhatKyBuongPhong
                {
                    MaPhong = roomId,
                    TrangThai = "done",
                    ThoiGianPhanCong = now,
                    ThoiGianBatDau = now,
                    ThoiGianHoanTat = now,
                    GhiChuKiemTra = $"Hoàn tất vệ sinh phòng {room.SoPhong}.",
                    NgayTao = now
                };
                Db.NhatKyBuongPhongs.Add(openTask);
            }
            else
            {
                openTask.TrangThai = "done";
                openTask.ThoiGianBatDau ??= now;
                openTask.ThoiGianHoanTat = now;
            }

            room.TrangThaiVeSinh = "Clean";
            if (!IsRoomOccupied(room.TrangThai) && !IsRoomReserved(room.TrangThai) && !IsRoomMaintenance(room.TrangThai))
                room.TrangThai = "Available";

            await Db.SaveChangesAsync();
            await transaction.CommitAsync();
            successMessage = $"Đã hoàn tất vệ sinh phòng {room.SoPhong} và cập nhật nhật ký.";
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể hoàn tất dọn phòng: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static bool IsReady(Phong room) =>
        IsRoomAvailable(room.TrangThai) && IsRoomClean(room.TrangThaiVeSinh);

    private static bool IsRoomAvailable(string? status) =>
        status is "Available" or "available" or "trong";

    private static bool IsRoomOccupied(string? status) =>
        status is "Occupied" or "occupied" or "dang_o";

    private static bool IsRoomReserved(string? status) =>
        status is "Reserved" or "reserved" or "da_dat";

    private static bool IsRoomMaintenance(string? status) =>
        status is "Maintenance" or "maintenance" or "sua_chua";

    private static bool IsRoomClean(string? status) =>
        status is "Clean" or "clean" or "sach_se" or "da_don";

    private static bool IsRoomDirty(Phong room) =>
        room.TrangThaiVeSinh is "Dirty" or "dirty" or "ban" or "can_don" or "Inspecting" or "dang_don" or "don_dep" or "chua_don";

    private static string RoomStatusClass(Phong room) =>
        IsReady(room) ? "trong" :
        IsRoomOccupied(room.TrangThai) ? "dang_o" :
        IsRoomMaintenance(room.TrangThai) ? "sua_chua" : "don_dep";

    private static string RoomBadgeStatus(Phong room) =>
        IsReady(room) ? "Available" :
        IsRoomOccupied(room.TrangThai) ? "Occupied" :
        IsRoomMaintenance(room.TrangThai) ? "Maintenance" : "Dirty";
}
