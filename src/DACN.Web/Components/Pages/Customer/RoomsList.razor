@page "/rooms"
@layout CustomerLayout
@inject DACNContext Db

<PageTitle>Hệ Thống Hạng Phòng Nghỉ — BookingStay.AI</PageTitle>

<div class="container my-5">
    <div class="text-center mb-5">
        <span class="text-primary fw-bold small text-uppercase" style="letter-spacing: 1px;">Khám Phá Phòng Nghỉ Chuẩn 5 Sao Toàn Chuỗi</span>
        <h2 class="fw-bold text-dark">Danh Mục Hạng Phòng Nghỉ Dưỡng</h2>
        <p class="text-muted small mx-auto" style="max-width: 600px;">
            Mỗi căn phòng trong hệ thống BookingStay.AI đều được thiết kế tỉ mỉ với nội thất cao cấp, ban công ngắm nhìn biển Mỹ Khê (Đà Nẵng), đón hoàng hôn lãng mạn tại Bãi Trường (Phú Quốc) hoặc ngắm rừng thông thơ mộng (Đà Lạt).
        </p>

        <!-- Thanh chọn Điểm đến / Chi nhánh -->
        <div class="d-inline-flex gap-2 p-1 bg-white border rounded-pill shadow-sm mt-3 flex-wrap justify-content-center">
            <button type="button" class="btn btn-sm rounded-pill px-3 @(selectedBranchFilter == 0 ? "btn-primary fw-bold" : "btn-light text-muted")" @onclick="() => selectedBranchFilter = 0">
                🏨 Tất Cả Điểm Đến
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 @(selectedBranchFilter == 1 ? "btn-primary fw-bold" : "btn-light text-muted")" @onclick="() => selectedBranchFilter = 1">
                🌊 GrandStay Đà Nẵng
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 @(selectedBranchFilter == 2 ? "btn-info text-white fw-bold" : "btn-light text-muted")" @onclick="() => selectedBranchFilter = 2">
                🌴 GrandStay Phú Quốc
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 @(selectedBranchFilter == 3 ? "btn-success fw-bold" : "btn-light text-muted")" @onclick="() => selectedBranchFilter = 3">
                🌲 GrandStay Đà Lạt
            </button>
        </div>
    </div>

    <!-- Bộ lọc phòng -->
    <div class="hotel-card p-3 mb-5 border shadow-sm">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-5">
                <input type="text" class="hotel-input w-100" placeholder="Tìm theo tên phòng, tiện nghi, view..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            <div class="col-6 col-md-4">
                <select class="hotel-select w-100" @bind="priceFilter">
                    <option value="0">Tất cả mức giá</option>
                    <option value="1">Dưới 1.000.000 đ / đêm</option>
                    <option value="2">Từ 1.000.000 đ trở lên</option>
                </select>
            </div>
            <div class="col-6 col-md-3 text-md-end text-muted small">
                Hiển thị <strong>@FilteredRooms.Count()</strong> hạng phòng
            </div>
        </div>
    </div>

    <!-- Grid danh sách phòng -->
    <div class="row g-4">
        @if (!FilteredRooms.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted fs-1 mb-2"><i class="bi bi-building-x"></i></div>
                <h5 class="fw-bold text-secondary">Không tìm thấy hạng phòng phù hợp</h5>
                <p class="text-muted small">Vui lòng thử đổi bộ lọc điểm đến hoặc mức giá khác.</p>
            </div>
        }
        @foreach (var room in FilteredRooms)
        {
            <div class="col-12 col-md-6">
                <div class="hotel-card border shadow-sm overflow-hidden h-100 d-flex flex-column flex-md-row">
                    <div style="min-width: 240px; height: 220px; overflow: hidden;" class="position-relative">
                        <img src="@room.Image" alt="@room.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                        <span class="badge position-absolute top-0 start-0 m-2 bg-primary">
                            @room.Size m²
                        </span>
                        <span class="badge position-absolute top-0 end-0 m-2 bg-dark bg-opacity-75 text-white border border-light">
                            <i class="bi bi-geo-alt-fill me-1 text-warning"></i>@room.Destination
                        </span>
                    </div>
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h5 class="fw-bold text-dark mb-0">@room.Title</h5>
                            <span class="fw-bold text-primary" style="font-size: 1.1rem;">@room.Price.ToString("N0") đ</span>
                        </div>
                        <div class="small text-muted mb-1"><i class="bi bi-building me-1"></i>@room.BranchName</div>
                        <small class="text-muted d-block mb-2">Giá cho 1 đêm (đã gồm thuế & phí)</small>
                        <p class="small text-muted mb-3" style="line-height: 1.4;">@room.Desc</p>

                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var amenity in room.Amenities)
                            {
                                <span class="badge bg-light text-secondary border small">@amenity</span>
                            }
                        </div>

                        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                            <small class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Miễn phí hủy trước 48h</small>
                            <a href="/#dat-phong" class="hotel-btn hotel-btn-accent py-1 px-3 small">
                                Đặt Phòng Ngay
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "branch")]
    public int? QueryBranchId { get; set; }

    private string searchQuery = "";
    private string priceFilter = "0";
    private int selectedBranchFilter = 0;

    protected override void OnParametersSet()
    {
        if (QueryBranchId is >= 1 and <= 3)
        {
            selectedBranchFilter = QueryBranchId.Value;
        }
    }

    private record RoomCatalog(int Id, string Title, decimal Price, int Size, string Image, string Desc, List<string> Amenities, int BranchId, string BranchName, string Destination);

    private List<RoomCatalog> roomsList = new();

    private static readonly string[] DefaultImages =
    {
        "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80",
        "https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=600&q=80",
        "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=600&q=80",
        "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=600&q=80"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dbRoomTypes = await Db.LoaiPhongs
                .AsNoTracking()
                .Include(l => l.MaChiNhanhNavigation)
                .Include(l => l.AnhPhongs)
                .Include(l => l.MaTienNghis)
                .Where(l => l.DangHoatDong)
                .OrderBy(l => l.MaChiNhanh)
                .ThenByDescending(l => l.GiaCoBan)
                .ToListAsync();

            if (dbRoomTypes.Any())
            {
                roomsList = dbRoomTypes.Select((lp, idx) =>
                {
                    var img = lp.AnhPhongs.FirstOrDefault()?.DuongDanAnh ?? DefaultImages[idx % DefaultImages.Length];
                    var amenities = lp.MaTienNghis.Any()
                        ? lp.MaTienNghis.Select(t => t.Ten).ToList()
                        : new List<string>
                        {
                            !string.IsNullOrWhiteSpace(lp.LoaiGiuong) ? lp.LoaiGiuong : "Giường King cao cấp",
                            !string.IsNullOrWhiteSpace(lp.HuongNhin) ? $"View {lp.HuongNhin}" : "View thoáng đãng",
                            $"Tối đa {lp.SoNguoiLonToiDa} người lớn",
                            "Wifi 6 & Smart TV"
                        };
                    var desc = !string.IsNullOrWhiteSpace(lp.MoTa)
                        ? lp.MoTa
                        : "Không gian nghỉ dưỡng chuẩn 5 sao với nội thất sang trọng và tiện nghi đầy đủ.";
                    var branchId = lp.MaChiNhanh;
                    var branchName = lp.MaChiNhanhNavigation?.TenChiNhanh ?? "GrandStay Đà Nẵng Beach Resort";
                    var destination = lp.MaChiNhanhNavigation?.TinhThanh ?? (branchId == 2 ? "Phú Quốc" : branchId == 3 ? "Đà Lạt" : "Đà Nẵng");

                    return new RoomCatalog(lp.MaId, lp.Ten, lp.GiaCoBan, lp.DienTichM2 ?? 32, img, desc, amenities, branchId, branchName, destination);
                }).ToList();
            }
        }
        catch { }
    }

    private IEnumerable<RoomCatalog> FilteredRooms => roomsList
        .Where(r => selectedBranchFilter == 0 || r.BranchId == selectedBranchFilter)
        .Where(r => string.IsNullOrWhiteSpace(searchQuery) || r.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || r.Desc.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || r.Destination.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(r => priceFilter == "0" || (priceFilter == "1" && r.Price < 1000000) || (priceFilter == "2" && r.Price >= 1000000));
}
