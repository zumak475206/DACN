@page "/my-bookings"
@layout CustomerLayout
@inject DACNContext Db
@inject UserSessionService Session
@inject IAuditService AuditService
@implements IDisposable

<PageTitle>Lịch Sử Đặt Phòng — Grand Hotel Da Nang</PageTitle>

<div class="container my-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <span class="text-primary fw-bold small text-uppercase" style="letter-spacing: 1px;">Khách Hàng Quản Trị</span>
            <h2 class="fw-bold text-dark mb-0">Đơn Đặt Phòng Của Tôi</h2>
        </div>
        <a href="/#dat-phong" class="hotel-btn hotel-btn-accent mt-3 mt-md-0">
            <i class="bi bi-plus-circle me-1"></i> Đặt Thêm Phòng Mới
        </a>
    </div>

    @if (cancelSuccess)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> Đã gửi yêu cầu hủy phòng thành công! Bộ phận Tiền sảnh sẽ xử lý hoàn cọc theo chính sách trong 24h.
            <button type="button" class="btn-close" @onclick="() => cancelSuccess = false"></button>
        </div>
    }

    <div class="hotel-card border shadow-sm">
        <div class="hotel-card-header">
            <div class="hotel-card-title">
                <i class="bi bi-clock-history text-primary"></i>
                <span>Danh Sách Kỳ Nghỉ Của Quý Khách</span>
            </div>
            <span class="hotel-badge hotel-badge-info">
                @(Session.CurrentUser.IsLoggedIn ? $"{Session.CurrentUser.HoTen} ({Session.CurrentUser.Email})" : "Khách chưa đăng nhập")
            </span>
        </div>
        <div class="hotel-card-body p-0">
            <div class="table-responsive">
                <table class="hotel-table">
                    <thead>
                        <tr>
                            <th>Mã Đơn</th>
                            <th>Loại Phòng</th>
                            <th>Ngày Nhận - Trả</th>
                            <th>Số Khách</th>
                            <th>Tổng Tiền</th>
                            <th>Đã Đặt Cọc</th>
                            <th>Trạng Thái</th>
                            <th class="text-end">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!myBookings.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    Quý khách chưa có đơn đặt phòng nào. Hãy chọn phòng tại Trang chủ để bắt đầu kỳ nghỉ!
                                </td>
                            </tr>
                        }
                        @foreach (var b in myBookings)
                        {
                            <tr>
                                <td>
                                    <strong class="font-monospace text-primary fs-6">@b.BookingCode</strong>
                                    <div class="small text-muted">#DP-@b.Id.ToString("D4")</div>
                                </td>
                                <td>
                                    <div class="fw-bold">@b.RoomType</div>
                                    <small class="text-muted">Kèm bữa sáng buffet Á - Âu</small>
                                </td>
                                <td>
                                    <div><i class="bi bi-box-arrow-in-right text-success me-1"></i> @b.Checkin</div>
                                    <div><i class="bi bi-box-arrow-left text-danger me-1"></i> @b.Checkout</div>
                                </td>
                                <td>@b.Guests người</td>
                                <td class="fw-bold">@b.Total.ToString("N0") đ</td>
                                <td class="fw-bold text-success">@b.Deposit.ToString("N0") đ</td>
                                <td>
                                    @if (b.Status == "da_xac_nhan")
                                    {
                                        <span class="hotel-badge hotel-badge-success">Chờ nhận phòng</span>
                                    }
                                    else if (b.Status == "da_nhan_phong")
                                    {
                                        <span class="hotel-badge hotel-badge-info">Đang lưu trú</span>
                                    }
                                    else if (b.Status == "da_tra_phong")
                                    {
                                        <span class="hotel-badge hotel-badge-neutral">Đã hoàn tất</span>
                                    }
                                    else
                                    {
                                        <span class="hotel-badge hotel-badge-danger">Đã hủy đơn</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (b.Status == "da_xac_nhan")
                                    {
                                        <button class="hotel-btn hotel-btn-outline text-danger py-1 px-2" style="font-size: 0.8rem;" @onclick="() => CancelBookingAsync(b.Id)">
                                            <i class="bi bi-x-circle me-1"></i> Hủy Phòng
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="hotel-btn hotel-btn-outline py-1 px-2" style="font-size: 0.8rem;">
                                            <i class="bi bi-receipt"></i> Hóa đơn
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private bool cancelSuccess = false;

    private class MyBookingItem
    {
        public int Id { get; set; }
        public string BookingCode { get; set; } = "";
        public string RoomType { get; set; } = "";
        public string Checkin { get; set; } = "";
        public string Checkout { get; set; } = "";
        public int Guests { get; set; }
        public decimal Total { get; set; }
        public decimal Deposit { get; set; }
        public string Status { get; set; } = "";
    }

    private List<MyBookingItem> myBookings = new();

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += OnSessionChanged;
        await LoadMyBookingsAsync();
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadMyBookingsAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
    }

    private async Task LoadMyBookingsAsync()
    {
        try
        {
            var query = Db.DatPhongs
                .AsNoTracking()
                .Include(b => b.ChiTietDatPhongs)
                    .ThenInclude(ct => ct.MaLoaiPhongNavigation)
                .AsQueryable();

            if (Session.CurrentUser.IsLoggedIn && Session.CurrentUser.Role == "Customer")
            {
                var userId = Session.CurrentUser.Id;
                var email = Session.CurrentUser.Email.Trim().ToLowerInvariant();
                query = query.Where(b =>
                    b.MaNguoiDung == userId
                    || (b.EmailKhach != null && b.EmailKhach.ToLower() == email));
            }
            else if (!Session.CurrentUser.IsLoggedIn)
            {
                query = query.Where(b => b.KenhDatPhong == "web");
            }

            var dbList = await query
                .OrderByDescending(b => b.NgayTao)
                .Take(20)
                .ToListAsync();

            myBookings = dbList.Select(b =>
            {
                var firstDetail = b.ChiTietDatPhongs.FirstOrDefault();
                var roomName = firstDetail?.MaLoaiPhongNavigation?.Ten ?? "Deluxe Sea View (Hướng Biển)";
                var guests = firstDetail?.MaLoaiPhongNavigation?.SoNguoiLonToiDa ?? 2;
                var checkin = firstDetail?.NgayNhanPhongDuKien.ToString("dd/MM/yyyy") ?? b.NgayTao.ToLocalTime().ToString("dd/MM/yyyy");
                var checkout = firstDetail?.NgayTraPhongDuKien.ToString("dd/MM/yyyy") ?? b.NgayTao.AddDays(1).ToLocalTime().ToString("dd/MM/yyyy");
                var normStatus = StatusMapper.NormalizeDatPhongTrangThai(b.TrangThai);
                var uiStatus = normStatus switch
                {
                    "Pending" or "Confirmed" => "da_xac_nhan",
                    "CheckedIn" => "da_nhan_phong",
                    "CheckedOut" => "da_tra_phong",
                    _ => "da_huy"
                };

                return new MyBookingItem
                {
                    Id = b.MaId,
                    BookingCode = b.MaDatPhong,
                    RoomType = roomName,
                    Checkin = checkin,
                    Checkout = checkout,
                    Guests = guests,
                    Total = b.TongTien,
                    Deposit = b.TienDatCoc,
                    Status = uiStatus
                };
            }).ToList();
        }
        catch { }
    }

    private async Task CancelBookingAsync(int id)
    {
        try
        {
            var booking = await Db.DatPhongs
                .Include(b => b.ChiTietDatPhongs)
                    .ThenInclude(ct => ct.MaPhongNavigation)
                .FirstOrDefaultAsync(b => b.MaId == id);

            if (booking == null) return;
            var norm = StatusMapper.NormalizeDatPhongTrangThai(booking.TrangThai);
            if (norm is not ("Pending" or "Confirmed")) return;

            booking.TrangThai = "Cancelled";
            booking.LyDoHuy = "Khách hàng yêu cầu hủy trực tuyến trên Cổng Khách Hàng";
            booking.NgayCapNhat = DateTime.UtcNow;

            foreach (var ct in booking.ChiTietDatPhongs)
            {
                ct.TrangThai = "Cancelled";
                if (ct.MaPhongNavigation != null && ct.MaPhongNavigation.TrangThai == "Reserved")
                {
                    ct.MaPhongNavigation.TrangThai = "Available";
                }
            }

            await Db.SaveChangesAsync();

            await AuditService.GhiNhanAsync(
                "HUY_DAT_PHONG_WEB",
                "DatPhong",
                booking.MaId.ToString(),
                $"Khách hàng hủy đơn đặt phòng {booking.MaDatPhong} trên Cổng Khách Hàng",
                Session.CurrentUser.IsLoggedIn ? Session.CurrentUser.Id : null,
                booking.EmailKhach,
                "127.0.0.1",
                true);

            cancelSuccess = true;
            await LoadMyBookingsAsync();
        }
        catch { }
    }
}
