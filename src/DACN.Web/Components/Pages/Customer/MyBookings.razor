@page "/my-bookings"
@layout CustomerLayout
@inject DACNContext Db

<PageTitle>Lịch Sử Đặt Phòng — Grand Hotel Da Nang</PageTitle>

<div class="container my-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <span class="text-primary fw-bold small text-uppercase" style="letter-spacing: 1px;">Khách Hàng Quản Trị</span>
            <h2 class="fw-bold text-dark mb-0">Đơn Đặt Phòng Của Tôi</h2>
        </div>
        <a href="/#dat-phong" class="hotel-btn hotel-btn-accent mt-3 mt-md-0">
            <i class="bi bi-plus-circle me-1"></i> Đặt Thêm Phòng Mới
        </a>
    </div>

    @if (cancelSuccess)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> Đã gửi yêu cầu hủy phòng thành công! Bộ phận Tiền sảnh sẽ xử lý hoàn cọc theo chính sách trong 24h.
            <button type="button" class="btn-close" @onclick="() => cancelSuccess = false"></button>
        </div>
    }

    <div class="hotel-card border shadow-sm">
        <div class="hotel-card-header">
            <div class="hotel-card-title">
                <i class="bi bi-clock-history text-primary"></i>
                <span>Danh Sách Kỳ Nghỉ Của Quý Khách</span>
            </div>
            <span class="hotel-badge hotel-badge-info">Email: khachhang@gmail.com</span>
        </div>
        <div class="hotel-card-body p-0">
            <div class="table-responsive">
                <table class="hotel-table">
                    <thead>
                        <tr>
                            <th>Mã Đơn</th>
                            <th>Loại Phòng</th>
                            <th>Ngày Nhận - Trả</th>
                            <th>Số Khách</th>
                            <th>Tổng Tiền</th>
                            <th>Đã Đặt Cọc</th>
                            <th>Trạng Thái</th>
                            <th class="text-end">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in myBookings)
                        {
                            <tr>
                                <td><strong class="font-monospace text-primary fs-6">#DP-@b.Id.ToString("D4")</strong></td>
                                <td>
                                    <div class="fw-bold">@b.RoomType</div>
                                    <small class="text-muted">Kèm bữa sáng buffet Á - Âu</small>
                                </td>
                                <td>
                                    <div><i class="bi bi-box-arrow-in-right text-success me-1"></i> @b.Checkin</div>
                                    <div><i class="bi bi-box-arrow-left text-danger me-1"></i> @b.Checkout</div>
                                </td>
                                <td>@b.Guests người</td>
                                <td class="fw-bold">@b.Total.ToString("N0") đ</td>
                                <td class="fw-bold text-success">@b.Deposit.ToString("N0") đ</td>
                                <td>
                                    @if (b.Status == "da_xac_nhan")
                                    {
                                        <span class="hotel-badge hotel-badge-success">Đã xác nhận cọc</span>
                                    }
                                    else if (b.Status == "da_nhan_phong")
                                    {
                                        <span class="hotel-badge hotel-badge-info">Đang lưu trú</span>
                                    }
                                    else
                                    {
                                        <span class="hotel-badge hotel-badge-danger">Đã hủy đơn</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (b.Status == "da_xac_nhan")
                                    {
                                        <button class="hotel-btn hotel-btn-outline text-danger py-1 px-2" style="font-size: 0.8rem;" @onclick="() => CancelBooking(b.Id)">
                                            <i class="bi bi-x-circle me-1"></i> Hủy Phòng
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="hotel-btn hotel-btn-outline py-1 px-2" style="font-size: 0.8rem;">
                                            <i class="bi bi-receipt"></i> Hóa đơn
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private bool cancelSuccess = false;

    private class MyBookingItem
    {
        public int Id { get; set; }
        public string RoomType { get; set; } = "";
        public string Checkin { get; set; } = "";
        public string Checkout { get; set; } = "";
        public int Guests { get; set; }
        public decimal Total { get; set; }
        public decimal Deposit { get; set; }
        public string Status { get; set; } = "";
    }

    private List<MyBookingItem> myBookings = new()
    {
        new() { Id = 1002, RoomType = "Deluxe Sea View (Hướng Biển)", Checkin = "20/11/2026", Checkout = "22/11/2026", Guests = 2, Total = 2000000, Deposit = 500000, Status = "da_xac_nhan" },
        new() { Id = 1001, RoomType = "Suite Gia Đình 2 Phòng Ngủ", Checkin = "10/10/2026", Checkout = "12/10/2026", Guests = 4, Total = 3000000, Deposit = 3000000, Status = "da_nhan_phong" }
    };

    private void CancelBooking(int id)
    {
        var item = myBookings.FirstOrDefault(x => x.Id == id);
        if (item != null)
        {
            item.Status = "da_huy";
            cancelSuccess = true;
        }
    }
}
