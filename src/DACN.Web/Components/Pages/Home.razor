            "Chi phí ăn ở cực kỳ hợp lý, mọi góc tường vàng phố cổ và sông Hoài đều lên hình lung linh.",
            "Chùa Cầu, Sông Hoài thả hoa đăng, Rừng dừa Bảy Mẫu",
            "https://images.unsplash.com/photo-1557750255-c76072a7aad1?auto=format&fit=crop&w=700&q=80")
    };

    private IEnumerable<AiTravelSuggestion> FilteredAiSuggestions => aiSuggestions
        .Where(s => aiSeasonFilter == "all" || s.VibeCode == aiSeasonFilter || (aiSeasonFilter == "tiet-kiem" && s.RoomPriceFrom <= 650000));

    private List<RoomTypeItem> allRoomTypes = new()
    {
        new(1, "GrandStay Deluxe Sea View", "Đà Nẵng", 1000000, "9.4 Xuất sắc", "📸 Góc ban công sống ảo", "song-ao",
            "Ban công hướng thẳng biển Mỹ Khê, ngắm bình minh trên giường ngủ, cách bãi tắm 2 phút đi bộ.",
            "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80",
            new() { "View Biển", "Ban công sống ảo", "Bồn tắm nằm", "Buffet sáng" }),
        new(2, "GrandStay Suite Family Resort", "Phú Quốc", 1500000, "9.6 Tuyệt hảo", "👨‍👩‍👧‍👦 Gia đình & Nhóm bạn", "gia-dinh",
            "Không gian 65m² với 2 phòng ngủ riêng biệt, hồ bơi vô cực ngắm hoàng hôn biển đảo.",
            "https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=600&q=80",
            new() { "2 Phòng ngủ", "Hồ bơi vô cực", "Đón sân bay", "Smart TV" }),
        new(3, "Pine Hill Retreat Superior", "Đà Lạt", 750000, "9.2 Tuyệt vời", "🌿 Thư giãn Chữa lành", "thu-gian",
            "Phòng gỗ ấm áp nhìn ra thung lũng thông xanh mướt, yên tĩnh tuyệt đối để nghỉ ngơi đọc sách.",
            "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=600&q=80",
            new() { "View Đồi thông", "Săn mây sáng sớm", "Trà chiều", "Lò sưởi ấm" }),
        new(4, "Old Town Boutique Standard", "Hội An", 500000, "8.9 Rất tốt", "💸 Tiết kiệm • Gần phố cổ", "song-ao",
            "Phòng thiết kế Indochine ấm cúng, miễn phí xe đạp dạo phố cổ Hội An và bãi biển An Bàng.",
            "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=600&q=80",
