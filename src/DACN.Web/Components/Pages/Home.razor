    // Dữ liệu mẫu Khung AI Gợi ý Du lịch theo Mùa & Ngân sách (TV4 sẽ nối với DB MuaDuLich, GoiYDiaDiemTheoMua_AI, GoiYTour_AI)
    private List<AiTravelSuggestion> aiSuggestions = new()
    {
        new("Đà Nẵng", "Đà Nẵng • Miền Trung", "Biển Xanh Nắng Vàng & Check-in Cầu Vàng", "Tháng 3 - Tháng 9", 98, "1.5 - 3 triệu", 500000, "song-ao", "📸 Check-in Sống ảo",
            "Thời tiết nắng đẹp, biển trong vắt, tập trung nhiều tọa độ sống ảo nổi tiếng từ biển lên núi.",
