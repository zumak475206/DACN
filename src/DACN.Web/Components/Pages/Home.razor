<!-- 8. MODAL ĐẶT PHÒNG TRỰC TUYẾN -->
@if (isBookingModalOpen && selectedRoom != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.55); z-index: 2500;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header text-white" style="background: #003B95;">
                    <h5 class="modal-title fw-bold d-flex align-items-center flex-wrap gap-2">
                        <span><i class="bi bi-calendar-check me-2"></i> Hoàn Tất Đặt Phòng: @selectedRoom.TenLoai</span>
                        <span class="badge bg-warning text-dark fs-6 fw-normal"><i class="bi bi-building me-1"></i> @selectedRoom.TenChiNhanh</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isBookingModalOpen = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (bookingSuccess)
                    {
                        <div class="text-center py-4">
                            <div class="text-success display-3 mb-2"><i class="bi bi-check-circle-fill"></i></div>
                            <h4 class="fw-bold text-success mb-2">Đặt Phòng Thành Công!</h4>
                            <p class="text-muted mb-3">Mã xác nhận đặt phòng của bạn: <strong class="text-dark fs-5">@bookingCodeText (#DP-@bookingCode)</strong></p>
                            <p class="small text-muted">Thông tin đơn đặt đã được lưu vào CSDL và chuyển về Phân hệ Tiền sảnh (TV3) để xếp phòng đón tiếp quý khách.</p>
                            <div class="mt-4">
                                <a href="/my-bookings" class="btn btn-primary px-4 py-2 me-2 fw-bold">Xem Đơn Đặt Của Tôi</a>
                                <button class="btn btn-outline-secondary px-4 py-2" @onclick="() => isBookingModalOpen = false">Đóng</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(bookingErrorMessage))
                        {
                            <div class="alert alert-danger py-2 small mb-3">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> @bookingErrorMessage
                            </div>
                        }
                        <div class="row g-3">
                            <!-- 1. Chọn ngày nhận phòng & ngày trả phòng -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold">
                                    <i class="bi bi-calendar-check text-primary me-1"></i> Ngày nhận phòng *
                                </label>
                                <input type="date" class="form-control hotel-input"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       value="@checkinDate.ToString("yyyy-MM-dd")"
                                       @onchange="OnCheckinDateChanged" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-calendar-x text-danger me-1"></i> Ngày trả phòng *</span>
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 fw-semibold px-2 py-1">
                                        <i class="bi bi-moon-stars-fill me-1"></i>@totalNights đêm
                                    </span>
                                </label>
                                <input type="date" class="form-control hotel-input"
                                       min="@checkinDate.AddDays(1).ToString("yyyy-MM-dd")"
                                       value="@checkoutDate.ToString("yyyy-MM-dd")"
                                       @onchange="OnCheckoutDateChanged" />
                            </div>

                            <!-- 2. Thông tin khách & Voucher -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold">Họ và tên người nhận phòng *</label>
                                <input type="text" class="hotel-input w-100" @bind="guestName" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold">Số điện thoại liên hệ *</label>
                                <input type="text" class="hotel-input w-100" @bind="guestPhone" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold">Địa chỉ Email nhận xác nhận *</label>
                                <input type="email" class="hotel-input w-100" @bind="guestEmail" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold">Mã Voucher ưu đãi</label>
                                <div class="input-group">
                                    <input type="text" class="form-control hotel-input" placeholder="VD: WELCOME2026, HE2026" @bind="appliedVoucherCode" />
                                    <button class="btn btn-outline-primary fw-semibold" type="button" @onclick="ApplyVoucher">Áp Dụng</button>
                                </div>
                                <div class="mt-1 d-flex flex-wrap gap-1 align-items-center">
                                    <small class="text-muted" style="font-size: 0.72rem;">Mã nhanh:</small>
                                    <button type="button" class="btn btn-sm btn-light border py-0 px-2 fw-semibold" style="font-size: 0.75rem;" @onclick='() => QuickApplyVoucher("WELCOME2026")'>WELCOME2026 (-15%)</button>
                                    <button type="button" class="btn btn-sm btn-light border py-0 px-2 fw-semibold" style="font-size: 0.75rem;" @onclick='() => QuickApplyVoucher("HE2026")'>HE2026 (-15%)</button>
                                    <button type="button" class="btn btn-sm btn-light border py-0 px-2 fw-semibold" style="font-size: 0.75rem;" @onclick='() => QuickApplyVoucher("SUMMERLUXURY")'>SUMMERLUXURY (-300K)</button>
                                </div>
                                @if (!string.IsNullOrEmpty(voucherMessage))
                                {
                                    <small class="@(discountAmount > 0 ? "text-success fw-bold" : "text-danger fw-semibold") d-block mt-1">
                                        <i class="bi @(discountAmount > 0 ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i> @voucherMessage
                                    </small>
                                }
                            </div>

                            <div class="col-12">
                                <div class="p-3 rounded-3 border mt-1" style="background: #F8FAFC;">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span>Đơn giá phòng:</span>
                                        <span>@selectedRoom.GiaMoiDem.ToString("N0") VND / đêm</span>
                                    </div>
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span>Thời gian lưu trú:</span>
                                        <span class="fw-semibold text-dark">
                                            @checkinDate.ToString("dd/MM/yyyy") → @checkoutDate.ToString("dd/MM/yyyy")
                                            <span class="text-primary ms-1">(@totalNights đêm)</span>
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span>Tạm tính tiền phòng (@totalNights đêm):</span>
                                        <span>@roomSubtotal.ToString("N0") VND</span>
                                    </div>
                                    @if (discountAmount > 0)
                                    {
                                        <div class="d-flex justify-content-between small mb-1 text-success">
                                            <span>Voucher giảm giá (@appliedVoucherCode):</span>
                                            <span>-@discountAmount.ToString("N0") VND</span>
                                        </div>
                                    }
                                    <hr class="my-2" />
                                    <div class="d-flex justify-content-between fw-bold text-primary fs-6">
                                        <span>Tổng cộng thanh toán:</span>
                                        <span>VND @finalTotal.ToString("N0")</span>
                                    </div>
                                    <div class="d-flex justify-content-between small fw-semibold text-success mt-1">
                                        <span>Tiền cọc giữ phòng (30%):</span>
                                        <span>VND @depositRequired.ToString("N0")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-bold mb-2">Phương thức đặt cọc &amp; Giữ phòng *</label>
                                <div class="row g-2">
                                    <div class="col-12 col-md-6">
                                        <div class="p-3 rounded-3 border h-100 @(payDepositNow ? "border-primary bg-primary bg-opacity-10" : "bg-white")"
                                             style="cursor: pointer;"
                                             @onclick="() => payDepositNow = true">
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <span class="fw-bold small text-dark"><i class="bi bi-qr-code-scan text-primary me-1"></i> Thanh toán cọc 30% (VietQR / VNPAY)</span>
                                                <input type="radio" class="form-check-input" checked="@payDepositNow" @onchange="() => payDepositNow = true" />
                                            </div>
                                            <small class="text-muted d-block">Xác nhận giữ phòng chắc chắn ngay lập tức (@depositRequired.ToString("N0") đ).</small>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="p-3 rounded-3 border h-100 @(!payDepositNow ? "border-warning bg-warning bg-opacity-10" : "bg-white")"
                                             style="cursor: pointer;"
                                             @onclick="() => payDepositNow = false">
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <span class="fw-bold small text-dark"><i class="bi bi-hourglass-split text-warning me-1"></i> Giữ chỗ tạm thời 15 phút</span>
                                                <input type="radio" class="form-check-input" checked="@(!payDepositNow)" @onchange="() => payDepositNow = false" />
                                            </div>
                                            <small class="text-muted d-block">Giữ phòng miễn phí trong 15 phút, thanh toán cọc sau tại mục Đơn Đặt Của Tôi.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top text-end">
                            <button class="btn btn-outline-secondary me-2" disabled="@isSubmittingBooking" @onclick="() => isBookingModalOpen = false">Hủy</button>
                            <button class="btn btn-primary fw-bold px-4" style="background: #006CE4;" disabled="@isSubmittingBooking" @onclick="SubmitBookingAsync">
                                <i class="bi bi-check2-circle me-1"></i> @(isSubmittingBooking ? "Đang xử lý..." : (payDepositNow ? $"Thanh Toán Cọc {depositRequired:N0} đ & Đặt Phòng" : "Xác Nhận Giữ Chỗ 15 Phút"))
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

