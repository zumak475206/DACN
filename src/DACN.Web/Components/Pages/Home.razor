    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dbRooms = await Db.LoaiPhongs.AsNoTracking().Where(x => x.DangHoatDong).Take(4).ToListAsync();
            if (dbRooms.Any())
            {
                for (int i = 0; i < Math.Min(dbRooms.Count, allRoomTypes.Count); i++)
                {
                    allRoomTypes[i] = allRoomTypes[i] with
                    {
                        Id = dbRooms[i].MaId,
                        GiaMoiDem = dbRooms[i].GiaCoBan
                    };
                }
            }

            var dbAiGoiY = await AiService.GoiYDuLichAsync(new GoiYDuLichRequest
            {
                ThangDi = checkinDate.Month,
                SoDem = Math.Max(1, (int)(checkoutDate - checkinDate).TotalDays)
            });

            if (dbAiGoiY.Count >= 3)
            {
                aiSuggestions = dbAiGoiY.Take(3).Select(g =>
                {
                    var hasSongAo = g.DanhSachGu.Contains("songao");
                    var hasThuGian = g.DanhSachGu.Contains("thugian");
                    var vibeCode = g.ChiPhiDuKienTu <= 1_800_000m ? "tiet-kiem" : hasSongAo ? "song-ao" : hasThuGian ? "thu-gian" : "song-ao";
                    var vibeLabel = vibeCode == "tiet-kiem" ? "💸 Tiết kiệm & Sống ảo" : vibeCode == "thu-gian" ? "🌿 Thư giãn Chữa lành" : "📸 Check-in Sống ảo";
                    return new AiTravelSuggestion(
                        g.DiemDen,
                        $"{g.DiemDen} • {g.TenMuaDepNhat}",
                        g.TieuDe,
                        g.ThoiDiemDepNhat,
                        g.PhanTramPhuHop,
                        $"{g.ChiPhiDuKienTu / 1_000_000m:0.#} - {g.ChiPhiDuKienDen / 1_000_000m:0.#} triệu",
                        g.GiaPhongMoiDem ?? 650_000m,
                        vibeCode,
                        vibeLabel,
                        g.LyDoAiGoiY,
                        g.DiemCheckInNoiBat,
                        g.DuongDanAnh ?? "https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?auto=format&fit=crop&w=700&q=80");
                }).ToList();
            }
        }
        catch { }
    }

    private IEnumerable<RoomTypeItem> DisplayRoomTypes => allRoomTypes
        .Where(r => string.IsNullOrWhiteSpace(selectedDestination) || r.DiaDiem.Contains(selectedDestination, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrWhiteSpace(selectedVibe) || r.VibeCode == selectedVibe)
        .Where(r => selectedBudget switch
        {
            "low" => r.GiaMoiDem < 800000,
            "mid" => r.GiaMoiDem >= 800000 && r.GiaMoiDem <= 1200000,
            "high" => r.GiaMoiDem > 1200000,
            _ => true
        });

    private decimal finalTotal => Math.Max(0, (selectedRoom?.GiaMoiDem ?? 0) - discountAmount);

    private void SearchRooms() { }

    private void ResetFilters()
    {
        selectedDestination = "";
        selectedBudget = "all";
        selectedVibe = "";
    }

    private void SelectDestinationAndScroll(string destination)
    {
        selectedDestination = destination;
    }

    private void OpenBookingModal(RoomTypeItem room)
    {
        selectedRoom = room;
        discountAmount = 0;
        appliedVoucherCode = "";
        bookingSuccess = false;
        if (Session.CurrentUser.IsLoggedIn)
        {
            guestName = Session.CurrentUser.HoTen;
            guestEmail = Session.CurrentUser.Email;
        }
        isBookingModalOpen = true;
    }

    private async Task ApplyVoucher()
    {
        if (selectedRoom == null) return;
        var code = (appliedVoucherCode ?? "").Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(code))
        {
            discountAmount = 0;
            return;
        }

        try
        {
            var now = GioVN.Now;
            var v = await Db.MaGiamGia.AsNoTracking()
                .FirstOrDefaultAsync(x => x.MaCode.ToUpper() == code && x.DangHoatDong && x.HieuLucDen >= now && x.SoLanDaDung < x.GioiHanSuDung);

            if (v != null && (!v.GiaTriDatPhongToiThieu.HasValue || selectedRoom.GiaMoiDem >= v.GiaTriDatPhongToiThieu.Value))
            {
                var raw = StatusMapper.IsPercentDiscount(v.LoaiGiamGia)
                    ? selectedRoom.GiaMoiDem * v.GiaTriGiamGia / 100m
                    : v.GiaTriGiamGia;
                if (StatusMapper.IsPercentDiscount(v.LoaiGiamGia) && v.GiamToiDa.HasValue && raw > v.GiamToiDa.Value)
                    raw = v.GiamToiDa.Value;
                discountAmount = Math.Min(raw, selectedRoom.GiaMoiDem);
                return;
            }
        }
        catch { }

        if (code.Equals("WELCOME2026", StringComparison.OrdinalIgnoreCase))
            discountAmount = selectedRoom.GiaMoiDem * 0.15m;
        else if (code.Equals("SUMMERLUXURY", StringComparison.OrdinalIgnoreCase))
            discountAmount = 300000;
        else
            discountAmount = 0;
    }

    private void CopyVoucher(string code)
    {
        appliedVoucherCode = code;
    }

    private void SubmitBooking()
    {
        bookingCode = System.Security.Cryptography.RandomNumberGenerator.GetInt32(1005, 9999);
        bookingSuccess = true;
    }
}
