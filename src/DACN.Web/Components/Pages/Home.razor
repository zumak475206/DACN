@page "/"
@layout CustomerLayout
@inject DACNContext Db
@inject GoiYDuLichService AiService
@inject UserSessionService Session
@inject IAuditService AuditService
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage LocalStorage

<PageTitle>BookingStay.AI — Đặt Phòng Khách Sạn & AI Gợi Ý Du Lịch Đi Muôn Nơi</PageTitle>

<!-- 1. HERO BANNER PHONG CÁCH BOOKING.COM -->
<section class="text-white position-relative" style="background: linear-gradient(180deg, #003B95 0%, #00224F 100%); padding: 48px 0 75px 0;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-12 col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(255, 183, 0, 0.18); border: 1px solid #FFB700; color: #FFD166; font-size: 0.82rem; font-weight: 600;">
                    <i class="bi bi-stars"></i> NỀN TẢNG BOOKING KẾT HỢP TRỢ LÝ AI DU LỊCH THÔNG MINH
                </div>
                <h1 class="display-5 fw-bold text-white mb-2" style="letter-spacing: -0.5px;">
                    Tìm chỗ nghỉ tiếp theo, <span style="color: #FFB700;">đi muôn nơi cùng AI</span>
                </h1>
                <p class="lead text-light opacity-90 mb-0" style="font-size: 1.08rem; max-width: 680px;">
                    Chỉ cần chọn <strong>Ngân sách</strong>, <strong>Gu sống ảo / Thư giãn</strong> và <strong>Thời gian đi</strong> — Hệ thống sẽ tìm ngay điểm đến có thời tiết đẹp nhất và hạng phòng vừa túi tiền của bạn.
                </p>
            </div>
            <div class="col-12 col-lg-4 d-none d-lg-block text-end">
                <div class="p-3 rounded-4 text-start d-inline-block" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.2); max-width: 320px;">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-warning text-dark">AI Gợi Ý Hôm Nay</span>
                        <small class="text-light opacity-75">Độ khớp 98%</small>
                    </div>
                    <div class="fw-bold text-white small">🌤️ Đà Nẵng & Hội An đang vào mùa đẹp nhất!</div>
                    <small class="text-light opacity-75 d-block mt-1" style="font-size: 0.76rem;">
                        Nắng nhẹ 26°C, cực hợp check-in biển Mỹ Khê & săn hoàng hôn Sơn Trà chỉ từ 500.000đ/đêm.
                    </small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. THANH TÌM KIẾM VIỀN VÀNG ĐẶC TRƯNG CỦA BOOKING.COM -->
<!-- TODO [TV3 & TV4]: Nối nút Tìm kiếm với API GET /api/v1/loai-phong/tim-kiem và bộ lọc AI -->
<div class="container position-relative" style="margin-top: -42px; z-index: 100;" id="dat-phong">
    <div class="p-2 rounded-3 shadow-lg" style="background: #FFB700;">
        <div class="row g-2 align-items-stretch">
            <!-- Ô 1: Điểm đến / Khu vực -->
            <div class="col-12 col-md-3">
                <div class="bg-white rounded-2 p-2 h-100 d-flex flex-column justify-content-center">
                    <label class="small text-muted fw-bold mb-1" style="font-size: 0.72rem;">
                        <i class="bi bi-geo-alt-fill text-primary me-1"></i> Bạn muốn đi đâu?
                    </label>
                    <select class="form-select border-0 p-0 fw-semibold text-dark shadow-none" style="font-size: 0.9rem;" @bind="selectedDestination">
                        <option value="">Tất cả điểm đến (Toàn quốc)</option>
                        <option value="Đà Nẵng">Đà Nẵng — Biển Mỹ Khê & Sơn Trà</option>
                        <option value="Đà Lạt">Đà Lạt — Săn mây & Đồi thông</option>
                        <option value="Phú Quốc">Phú Quốc — Sunset Town & Biển đảo</option>
                        <option value="Sa Pa">Sa Pa — Đỉnh Fansipan & Bản Cát Cát</option>
                        <option value="Hội An">Hội An — Phố cổ & Rừng dừa</option>
                    </select>
                </div>
            </div>

            <!-- Ô 2: Ngày nhận - trả phòng -->
            <div class="col-12 col-md-3">
                <div class="bg-white rounded-2 p-2 h-100 d-flex flex-column justify-content-center">
                    <label class="small text-muted fw-bold mb-1" style="font-size: 0.72rem;">
                        <i class="bi bi-calendar-range text-primary me-1"></i> Ngày nhận — Ngày trả phòng
                    </label>
                    <div class="d-flex align-items-center gap-1">
                        <input type="date" class="form-control border-0 p-0 fw-semibold shadow-none" style="font-size: 0.84rem;"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind="checkinDate" @bind:after="SyncDates" />
                        <span class="text-muted">→</span>
                        <input type="date" class="form-control border-0 p-0 fw-semibold shadow-none" style="font-size: 0.84rem;"
                               min="@checkinDate.AddDays(1).ToString("yyyy-MM-dd")" @bind="checkoutDate" @bind:after="SyncDates" />
                    </div>
                </div>
            </div>

            <!-- Ô 3: Ngân sách & Gu du lịch (Đặc trưng AI của đồ án) -->
            <div class="col-12 col-md-4">
                <div class="bg-white rounded-2 p-2 h-100 d-flex flex-column justify-content-center">
                    <label class="small text-muted fw-bold mb-1" style="font-size: 0.72rem;">
                        <i class="bi bi-magic text-warning me-1"></i> Ngân sách & Gu trải nghiệm (AI Lọc)
                    </label>
                    <div class="d-flex gap-2">
                        <select class="form-select border-0 p-0 fw-semibold text-dark shadow-none" style="font-size: 0.85rem;" @bind="selectedBudget">
                            <option value="all">Mọi ngân sách</option>
                            <option value="low">Tiết kiệm (&lt; 800k/đêm)</option>
                            <option value="mid">Vừa phải (800k - 1.2tr)</option>
                            <option value="high">Thượng lưu (&gt; 1.2tr)</option>
                        </select>
                        <span class="text-muted">|</span>
                        <select class="form-select border-0 p-0 fw-semibold text-primary shadow-none" style="font-size: 0.85rem;" @bind="selectedVibe">
                            <option value="">Mọi gu du lịch</option>
                            <option value="song-ao">📸 Check-in Sống ảo</option>
                            <option value="thu-gian">🌿 Thư giãn Chữa lành</option>
                            <option value="gia-dinh">👨‍👩‍👧‍👦 Gia đình & Nhóm bạn</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Ô 4: Nút Tìm kiếm -->
            <div class="col-12 col-md-2">
                <button class="btn w-100 h-100 fw-bold text-white fs-6 rounded-2 d-flex align-items-center justify-content-center gap-2"
                        style="background: #006CE4; min-height: 54px;" @onclick="SearchRooms">
                    <i class="bi bi-search"></i> Tìm Kiếm
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 3. TRỢ LÝ AI TƯ VẤN LỊCH TRÌNH: ĐI ĐÂU ĐẸP NHẤT THEO NGÂN SÁCH & MÙA (KHUNG CHO TV4 & TV1) -->
<!-- TODO [TV4]: Nối dữ liệu từ bảng MuaDuLich, GoiYDiaDiemTheoMua_AI và GoiYTour_AI -->
<section class="container my-5 pt-2" id="ai-goi-y">
    <div class="p-4 rounded-4 border shadow-sm" style="background: linear-gradient(135deg, #EFF6FF 0%, #F5F3FF 100%); border-color: #BFDBFE !important;">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-primary"><i class="bi bi-stars me-1"></i> TRỢ LÝ DU LỊCH THÔNG MINH AI</span>
                    <span class="text-muted small">Gợi ý cá nhân hóa theo thời tiết mùa, ngân sách &amp; phong cách trải nghiệm</span>
                </div>
                <h3 class="fw-bold text-dark mb-1">Chưa biết đi đâu? Chọn Gu &amp; Ngân sách để AI gợi ý nơi đẹp nhất!</h3>
                <p class="text-muted small mb-0">AI phân tích thời tiết theo mùa, ngân sách và điểm check-in sống ảo để đề xuất lịch trình tối ưu nhất cho bạn.</p>
            </div>

            <!-- Bộ chọn nhanh Gu & Mùa -->
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-sm @(aiSeasonFilter == "all" ? "btn-primary" : "btn-outline-primary") rounded-pill px-3" @onclick='() => aiSeasonFilter = "all"'>
                    ✨ Tất cả mùa
                </button>
                <button class="btn btn-sm @(aiSeasonFilter == "song-ao" ? "btn-primary" : "btn-outline-primary") rounded-pill px-3" @onclick='() => aiSeasonFilter = "song-ao"'>
                    📸 Đẹp Check-in Sống ảo
                </button>
                <button class="btn btn-sm @(aiSeasonFilter == "thu-gian" ? "btn-primary" : "btn-outline-primary") rounded-pill px-3" @onclick='() => aiSeasonFilter = "thu-gian"'>
                    🌿 Nghỉ dưỡng Thư giãn
                </button>
                <button class="btn btn-sm @(aiSeasonFilter == "tiet-kiem" ? "btn-primary" : "btn-outline-primary") rounded-pill px-3" @onclick='() => aiSeasonFilter = "tiet-kiem"'>
                    💸 Dưới 2 Triệu Trọn Gói
                </button>
            </div>
        </div>

        <div class="row g-3">
            @foreach (var sug in FilteredAiSuggestions)
            {
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden hover-card">
                        <div class="position-relative" style="height: 175px;">
                            <img src="@sug.ImageUrl" alt="@sug.Destination" style="width: 100%; height: 100%; object-fit: cover;" />
                            <span class="badge position-absolute top-0 start-0 m-2 px-2 py-1" style="background: #003B95; color: white;">
                                <i class="bi bi-geo-alt-fill text-warning me-1"></i> @sug.Destination
                            </span>
                            <span class="badge position-absolute top-0 end-0 m-2 px-2 py-1 bg-success text-white">
                                AI Match: @sug.MatchScore%
                            </span>
                            <span class="badge position-absolute bottom-0 start-0 m-2 px-2 py-1 bg-dark bg-opacity-75 text-warning">
                                🌤️ Thời điểm đẹp nhất: @sug.BestMonths
                            </span>
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-light text-primary border" style="font-size: 0.72rem;">@sug.VibeLabel</span>
                                <span class="fw-bold text-danger small">Ngân sách: @sug.BudgetRange</span>
                            </div>
                            <h6 class="fw-bold text-dark mt-1 mb-1">@sug.Title</h6>
                            <p class="small text-muted mb-2" style="font-size: 0.8rem;">@sug.Reason</p>
                            <div class="small text-dark mb-3" style="font-size: 0.78rem;">
                                <strong>📸 Điểm check-in nổi bật:</strong> @sug.CheckinSpots
                            </div>
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center gap-1">
                                <small class="text-muted">Phòng từ <strong class="text-primary">@sug.RoomPriceFrom.ToString("N0")đ</strong>/đêm</small>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-primary fw-semibold px-2" @onclick="() => SelectDestinationAndScroll(sug.CityKey)">
                                        Lọc phòng
                                    </button>
                                    <button class="btn btn-sm btn-primary fw-semibold px-2" @onclick="() => BookFromAiSuggestion(sug.CityKey)">
                                        Đặt Ngay <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- 4. ĐIỂM ĐẾN THỊNH HÀNH TẠI VIỆT NAM (PHONG CÁCH BOOKING.COM) -->
<section class="container my-5">
    <div class="mb-3">
        <h3 class="fw-bold text-dark mb-1">Điểm đến thịnh hành tại Việt Nam</h3>
        <p class="text-muted small mb-0">Các thành phố du lịch được lựa chọn nhiều nhất bởi du khách tại Việt Nam</p>
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <div class="position-relative rounded-4 overflow-hidden shadow-sm hover-card" style="height: 230px; cursor: pointer;" @onclick='() => SelectDestinationAndScroll("Đà Nẵng")'>
                <img src="https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?auto=format&fit=crop&w=900&q=80" class="w-100 h-100" style="object-fit: cover;" alt="Đà Nẵng" />
                <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.1) 55%, rgba(0,0,0,0.7) 100%);"></div>
                <div class="position-absolute top-0 start-0 p-3 text-white">
                    <h4 class="fw-bold mb-0">Đà Nẵng 🇻🇳</h4>
                    <small class="text-warning fw-semibold">Thiên đường biển Mỹ Khê • Cầu Rồng • Bà Nà Hills</small>
                </div>
                <div class="position-absolute bottom-0 start-0 p-3 text-white">
                    <span class="badge bg-warning text-dark fw-bold">Giá trung bình: 750.000 VND/đêm</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="position-relative rounded-4 overflow-hidden shadow-sm hover-card" style="height: 230px; cursor: pointer;" @onclick='() => SelectDestinationAndScroll("Đà Lạt")'>
                <img src="https://images.unsplash.com/photo-1583417319070-4a69db38a482?auto=format&fit=crop&w=900&q=80" class="w-100 h-100" style="object-fit: cover;" alt="Đà Lạt" />
                <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.1) 55%, rgba(0,0,0,0.7) 100%);"></div>
                <div class="position-absolute top-0 start-0 p-3 text-white">
                    <h4 class="fw-bold mb-0">Đà Lạt 🇻🇳</h4>
                    <small class="text-warning fw-semibold">Săn mây Cầu Đất • Hồ Tuyền Lâm • Quán Cafe Sống Ảo</small>
                </div>
                <div class="position-absolute bottom-0 start-0 p-3 text-white">
                    <span class="badge bg-warning text-dark fw-bold">Giá trung bình: 650.000 VND/đêm</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="position-relative rounded-4 overflow-hidden shadow-sm hover-card" style="height: 185px; cursor: pointer;" @onclick='() => SelectDestinationAndScroll("Phú Quốc")'>
                <img src="https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=600&q=80" class="w-100 h-100" style="object-fit: cover;" alt="Phú Quốc" />
                <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.2) 100%);"></div>
                <div class="position-absolute top-0 start-0 p-3 text-white">
                    <h5 class="fw-bold mb-0">Phú Quốc 🇻🇳</h5>
                    <small>Thị trấn Hoàng Hôn • Cáp treo Hòn Thơm</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="position-relative rounded-4 overflow-hidden shadow-sm hover-card" style="height: 185px; cursor: pointer;" @onclick='() => SelectDestinationAndScroll("Sa Pa")'>
                <img src="https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=600&q=80" class="w-100 h-100" style="object-fit: cover;" alt="Sa Pa" />
                <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.2) 100%);"></div>
                <div class="position-absolute top-0 start-0 p-3 text-white">
                    <h5 class="fw-bold mb-0">Sa Pa 🇻🇳</h5>
                    <small>Đỉnh Fansipan • Ruộng bậc thang Mường Hoa</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="position-relative rounded-4 overflow-hidden shadow-sm hover-card" style="height: 185px; cursor: pointer;" @onclick='() => SelectDestinationAndScroll("Hội An")'>
                <img src="https://images.unsplash.com/photo-1557750255-c76072a7aad1?auto=format&fit=crop&w=600&q=80" class="w-100 h-100" style="object-fit: cover;" alt="Hội An" />
                <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.2) 100%);"></div>
                <div class="position-absolute top-0 start-0 p-3 text-white">
                    <h5 class="fw-bold mb-0">Hội An 🇻🇳</h5>
                    <small>Phố cổ đèn lồng • Chùa Cầu • Biển An Bàng</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 5. DANH SÁCH CHỖ NGHỈ & HẠNG PHÒNG NỔI BẬT (DỮ LIỆU THẬT TỪ DB + MOCK ĐA ĐIỂM ĐẾN) -->
<!-- TODO [TV3]: Nối thao tác Đặt phòng với API POST /api/v1/dat-phong -->
<section class="container my-5 py-2" id="danh-sach-phong">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4">
        <div>
            <span class="text-primary fw-bold small text-uppercase">Chỗ Nghỉ Được Đánh Giá Cao Nhất</span>
            <h3 class="fw-bold text-dark mb-0">
                Chỗ Nghỉ &amp; Hạng Phòng Nổi Bật @(string.IsNullOrEmpty(selectedDestination) ? "Toàn Hệ Thống" : $"Tại {selectedDestination}")
            </h3>
        </div>
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            @if (!string.IsNullOrEmpty(selectedDestination) || selectedBudget != "all" || !string.IsNullOrEmpty(selectedVibe))
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilters">
                    <i class="bi bi-x-circle me-1"></i> Xóa bộ lọc
                </button>
            }
            <a href="rooms" class="text-decoration-none fw-semibold text-primary">
                Xem toàn bộ phòng <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var room in DisplayRoomTypes)
        {
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 d-flex flex-column shadow-sm border rounded-4 overflow-hidden hover-card">
                    <div class="position-relative" style="height: 190px; background: #CBD5E1; overflow: hidden;">
                        <img src="@room.ImageUrl" alt="@room.TenLoai" style="width: 100%; height: 100%; object-fit: cover;" />
                        <span class="badge position-absolute top-0 start-0 m-2 px-2 py-1 bg-dark bg-opacity-75 text-white" style="font-size: 0.72rem;">
                            <i class="bi bi-geo-alt-fill text-warning me-1"></i> @room.DiaDiem • @room.TenChiNhanh
                        </span>
                        <div class="position-absolute top-0 end-0 m-2 d-flex align-items-center gap-1">
                            <span class="badge px-2 py-1 fw-bold" style="background: #003B95; color: white; font-size: 0.78rem;">@room.DiemDanhGia</span>
                        </div>
                        <span class="badge position-absolute bottom-0 start-0 m-2 px-2 py-1 bg-warning text-dark fw-semibold" style="font-size: 0.7rem;">
                            @room.GuDuLichTag
                        </span>
                    </div>
                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                        <h6 class="fw-bold text-dark mb-1" style="font-size: 1rem;">@room.TenLoai</h6>
                        <small class="text-success fw-semibold mb-2" style="font-size: 0.75rem;">
                            <i class="bi bi-check2-circle me-1"></i> Miễn phí hủy phòng • Bao gồm bữa sáng
                        </small>
                        <p class="small text-muted mb-2" style="font-size: 0.8rem; line-height: 1.4;">@room.MoTa</p>

                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var feature in room.TienNghi)
                            {
                                <span class="badge bg-light text-secondary border" style="font-size: 0.68rem;">@feature</span>
                            }
                        </div>

                        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-end">
                            <div>
                                <small class="text-muted d-block" style="font-size: 0.7rem;">Giá 1 đêm (đã gồm thuế)</small>
                                <span class="fw-bold text-primary" style="font-size: 1.08rem;">VND @room.GiaMoiDem.ToString("N0")</span>
                            </div>
                            <button class="btn btn-sm text-white fw-bold px-3 py-1" style="background: #006CE4; border-radius: 6px;" @onclick="() => OpenBookingModal(room)">
                                Đặt Ngay
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- 6. ƯU ĐÃI VOUCHER & KHUYẾN MÃI THEO MÙA (KHUNG CHO TV1) -->
<!-- TODO [TV1]: Nối danh sách Voucher với API GET /api/v1/voucher và POST /api/v1/voucher/kiem-tra -->
<section class="container my-5" id="uu-dai">
    <div class="p-4 p-md-5 rounded-4" style="background: linear-gradient(135deg, #003B95 0%, #00224F 100%); color: white;">
        <div class="row align-items-center">
            <div class="col-12 col-md-7">
                <span class="badge bg-warning text-dark px-3 py-1 fw-bold mb-2">ƯU ĐÃI DU LỊCH &amp; NGHỈ DƯỠNG 2026</span>
