    // D? li?u m?u Khung AI G?i ? Du l?ch theo Mùa & Ngân sách (TV4 s? n?i v?i DB MuaDuLich, GoiYDiaDiemTheoMua_AI, GoiYTour_AI)
    private List<AiTravelSuggestion> aiSuggestions = new()
    {
        new("Ðà N?ng", "Ðà N?ng • Mi?n Trung", "Bi?n Xanh N?ng Vàng & Check-in C?u Vàng", "Tháng 3 - Tháng 9", 98, "1.5 - 3 tri?u", 500000, "song-ao", "?? Check-in S?ng ?o",
            "Th?i ti?t n?ng ð?p, bi?n trong v?t, t?p trung nhi?u t?a ð? s?ng ?o n?i ti?ng t? bi?n lên núi.",
            "C?u Vàng Bà Nà, Bán ð?o Sõn Trà, B?i bi?n M? Khê, C?u R?ng",
            "https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?auto=format&fit=crop&w=700&q=80"),
        new("Ðà L?t", "Ðà L?t • Tây Nguyên", "Sãn Mây Ð?i Thông & Ngh? Dý?ng Ch?a Lành", "Tháng 10 - Tháng 3", 96, "1.2 - 2.5 tri?u", 650000, "thu-gian", "?? Thý gi?n Ch?a lành",
            "Không khí se l?nh 16-22°C, sýõng mù bu?i s?m và r?ng thông yên t?nh giúp tái t?o nãng lý?ng.",
            "Ð?i chè C?u Ð?t, H? Tuy?n Lâm, Thung l?ng T?nh Yêu",
            "https://images.unsplash.com/photo-1583417319070-4a69db38a482?auto=format&fit=crop&w=700&q=80"),
        new("H?i An", "H?i An • Qu?ng Nam", "Ph? C? Ðèn L?ng & Ngh? Dý?ng Ti?t Ki?m", "Tháng 2 - Tháng 8", 95, "Dý?i 2 tri?u", 550000, "tiet-kiem", "?? Ti?t ki?m & S?ng ?o",
            "Chi phí ãn ? c?c k? h?p l?, m?i góc tý?ng vàng ph? c? và sông Hoài ð?u lên h?nh lung linh.",
            "Chùa C?u, Sông Hoài th? hoa ðãng, R?ng d?a B?y M?u",
            "https://images.unsplash.com/photo-1557750255-c76072a7aad1?auto=format&fit=crop&w=700&q=80")
    };

    private IEnumerable<AiTravelSuggestion> FilteredAiSuggestions => aiSuggestions
        .Where(s => aiSeasonFilter == "all" || s.VibeCode == aiSeasonFilter || (aiSeasonFilter == "tiet-kiem" && s.RoomPriceFrom <= 650000));

    private List<RoomTypeItem> allRoomTypes = new()
    {
        new(1, "GrandStay Deluxe Sea View", "Ðà N?ng", 1000000, "9.4 Xu?t s?c", "?? Góc ban công s?ng ?o", "song-ao",
            "Ban công hý?ng th?ng bi?n M? Khê, ng?m b?nh minh trên giý?ng ng?, cách b?i t?m 2 phút ði b?.",
            "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80",
            new() { "View Bi?n", "Ban công s?ng ?o", "B?n t?m n?m", "Buffet sáng" }),
        new(2, "GrandStay Suite Family Resort", "Phú Qu?c", 1500000, "9.6 Tuy?t h?o", "??????????? Gia ð?nh & Nhóm b?n", "gia-dinh",
            "Không gian 65m² v?i 2 ph?ng ng? riêng bi?t, h? bõi vô c?c ng?m hoàng hôn bi?n ð?o.",
            "https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=600&q=80",
            new() { "2 Ph?ng ng?", "H? bõi vô c?c", "Ðón sân bay", "Smart TV" }),
        new(3, "Pine Hill Retreat Superior", "Ðà L?t", 750000, "9.2 Tuy?t v?i", "?? Thý gi?n Ch?a lành", "thu-gian",
            "Ph?ng g? ?m áp nh?n ra thung l?ng thông xanh mý?t, yên t?nh tuy?t ð?i ð? ngh? ngõi ð?c sách.",
            "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=600&q=80",
            new() { "View Ð?i thông", "Sãn mây sáng s?m", "Trà chi?u", "L? sý?i ?m" }),
        new(4, "Old Town Boutique Standard", "H?i An", 500000, "8.9 R?t t?t", "?? Ti?t ki?m • G?n ph? c?", "song-ao",
            "Ph?ng thi?t k? Indochine ?m cúng, mi?n phí xe ð?p d?o ph? c? H?i An và b?i bi?n An Bàng.",
            "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=600&q=80",
            new() { "Xe ð?p mi?n phí", "Cách Ph? c? 400m", "H? bõi sân vý?n", "Wifi 6" })
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dbRooms = await Db.LoaiPhongs.AsNoTracking().Where(x => x.DangHoatDong).Take(4).ToListAsync();
            if (dbRooms.Any())
            {
                for (int i = 0; i < Math.Min(dbRooms.Count, allRoomTypes.Count); i++)
                {
                    allRoomTypes[i] = allRoomTypes[i] with
                    {
                        Id = dbRooms[i].MaId,
                        GiaMoiDem = dbRooms[i].GiaCoBan
                    };
                }
            }

            var dbAiGoiY = await AiService.GoiYDuLichAsync(new GoiYDuLichRequest
            {
                ThangDi = checkinDate.Month,
                SoDem = Math.Max(1, (int)(checkoutDate - checkinDate).TotalDays)
            });

            if (dbAiGoiY.Count >= 3)
            {
                aiSuggestions = dbAiGoiY.Take(3).Select(g =>
                {
                    var hasSongAo = g.DanhSachGu.Contains("songao");
                    var hasThuGian = g.DanhSachGu.Contains("thugian");
                    var vibeCode = g.ChiPhiDuKienTu <= 1_800_000m ? "tiet-kiem" : hasSongAo ? "song-ao" : hasThuGian ? "thu-gian" : "song-ao";
                    var vibeLabel = vibeCode == "tiet-kiem" ? "?? Ti?t ki?m & S?ng ?o" : vibeCode == "thu-gian" ? "?? Thý gi?n Ch?a lành" : "?? Check-in S?ng ?o";
                    return new AiTravelSuggestion(
                        g.DiemDen,
                        $"{g.DiemDen} • {g.TenMuaDepNhat}",
                        g.TieuDe,
                        g.ThoiDiemDepNhat,
                        g.PhanTramPhuHop,
                        $"{g.ChiPhiDuKienTu / 1_000_000m:0.#} - {g.ChiPhiDuKienDen / 1_000_000m:0.#} tri?u",
                        g.GiaPhongMoiDem ?? 650_000m,
                        vibeCode,
                        vibeLabel,
                        g.LyDoAiGoiY,
                        g.DiemCheckInNoiBat,
                        g.DuongDanAnh ?? "https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?auto=format&fit=crop&w=700&q=80");
                }).ToList();
            }
        }
        catch { }
    }

    private IEnumerable<RoomTypeItem> DisplayRoomTypes => allRoomTypes
        .Where(r => string.IsNullOrWhiteSpace(selectedDestination) || r.DiaDiem.Contains(selectedDestination, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrWhiteSpace(selectedVibe) || r.VibeCode == selectedVibe)
        .Where(r => selectedBudget switch
        {
            "low" => r.GiaMoiDem < 800000,
            "mid" => r.GiaMoiDem >= 800000 && r.GiaMoiDem <= 1200000,
            "high" => r.GiaMoiDem > 1200000,
            _ => true
        });

    private decimal finalTotal => Math.Max(0, (selectedRoom?.GiaMoiDem ?? 0) - discountAmount);

    private void SearchRooms() { }

    private void ResetFilters()
    {
        selectedDestination = "";
        selectedBudget = "all";
        selectedVibe = "";
    }

    private void SelectDestinationAndScroll(string destination)
    {
        selectedDestination = destination;
    }

    private void OpenBookingModal(RoomTypeItem room)
    {
        selectedRoom = room;
        discountAmount = 0;
        appliedVoucherCode = "";
        bookingSuccess = false;
        if (Session.CurrentUser.IsLoggedIn)
        {
            guestName = Session.CurrentUser.HoTen;
            guestEmail = Session.CurrentUser.Email;
        }
        isBookingModalOpen = true;
    }

    private async Task ApplyVoucher()
    {
        if (selectedRoom == null) return;
        var code = (appliedVoucherCode ?? "").Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(code))
        {
            discountAmount = 0;
            return;
        }

        try
        {
            var now = GioVN.Now;
            var v = await Db.MaGiamGia.AsNoTracking()
                .FirstOrDefaultAsync(x => x.MaCode.ToUpper() == code && x.DangHoatDong && x.HieuLucDen >= now && x.SoLanDaDung < x.GioiHanSuDung);

            if (v != null && (!v.GiaTriDatPhongToiThieu.HasValue || selectedRoom.GiaMoiDem >= v.GiaTriDatPhongToiThieu.Value))
            {
                var raw = StatusMapper.IsPercentDiscount(v.LoaiGiamGia)
                    ? selectedRoom.GiaMoiDem * v.GiaTriGiamGia / 100m
                    : v.GiaTriGiamGia;
                if (StatusMapper.IsPercentDiscount(v.LoaiGiamGia) && v.GiamToiDa.HasValue && raw > v.GiamToiDa.Value)
                    raw = v.GiamToiDa.Value;
                discountAmount = Math.Min(raw, selectedRoom.GiaMoiDem);
                return;
            }
        }
        catch { }

        if (code.Equals("WELCOME2026", StringComparison.OrdinalIgnoreCase))
            discountAmount = selectedRoom.GiaMoiDem * 0.15m;
        else if (code.Equals("SUMMERLUXURY", StringComparison.OrdinalIgnoreCase))
            discountAmount = 300000;
        else
            discountAmount = 0;
    }

    private void CopyVoucher(string code)
    {
        appliedVoucherCode = code;
    }

    private void SubmitBooking()
    {
        bookingCode = System.Security.Cryptography.RandomNumberGenerator.GetInt32(1005, 9999);
        bookingSuccess = true;
    }
}
