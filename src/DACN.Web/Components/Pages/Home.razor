    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dbRooms = await Db.LoaiPhongs.AsNoTracking().Where(x => x.DangHoatDong).Take(4).ToListAsync();
            if (dbRooms.Any())
            {
                for (int i = 0; i < Math.Min(dbRooms.Count, allRoomTypes.Count); i++)
                {
                    allRoomTypes[i] = allRoomTypes[i] with
                    {
                        Id = dbRooms[i].MaId,
                        GiaMoiDem = dbRooms[i].GiaCoBan,
                        MaChiNhanh = dbRooms[i].MaChiNhanh > 0 ? dbRooms[i].MaChiNhanh : allRoomTypes[i].MaChiNhanh
                    };
                }
            }

            var dbAiGoiY = await AiService.GoiYDuLichAsync(new GoiYDuLichRequest
            {
                ThangDi = checkinDate.Month,
                SoDem = Math.Max(1, (int)(checkoutDate - checkinDate).TotalDays)
            });

            if (dbAiGoiY.Count >= 3)
            {
                // Chọn đa dạng 3 chi nhánh / điểm đến nổi bật để hiển thị trên Trang chủ
                var distinctByBranch = dbAiGoiY
                    .GroupBy(g => g.MaChiNhanh)
                    .Select(grp => grp.First())
                    .ToList();
                var displayPool = distinctByBranch.Count >= 3
                    ? distinctByBranch.Take(3).ToList()
                    : dbAiGoiY.Take(3).ToList();

                aiSuggestions = displayPool.Select(g =>
                {
                    var hasSongAo = g.DanhSachGu.Contains("songao");
                    var hasThuGian = g.DanhSachGu.Contains("thugian");
                    var vibeCode = g.ChiPhiDuKienTu <= 2_200_000m ? "tiet-kiem" : hasSongAo ? "song-ao" : hasThuGian ? "thu-gian" : "song-ao";
                    var vibeLabel = vibeCode == "tiet-kiem" ? "💸 Tiết kiệm & Sống ảo" : vibeCode == "thu-gian" ? "🌿 Thư giãn Chữa lành" : "📸 Check-in Sống ảo";
                    var cityKey = NormalizeCityKey(g.DiemDen, g.MaChiNhanh);
                    return new AiTravelSuggestion(
                        cityKey,
                        $"{cityKey} • {g.TenChiNhanh}",
                        g.TieuDe,
                        g.ThoiDiemDepNhat,
                        g.PhanTramPhuHop,
                        $"{g.ChiPhiDuKienTu / 1_000_000m:0.#} - {g.ChiPhiDuKienDen / 1_000_000m:0.#} triệu",
                        g.GiaPhongMoiDem ?? 650_000m,
                        vibeCode,
                        vibeLabel,
                        g.LyDoAiGoiY,
                        g.DiemCheckInNoiBat,
                        g.DuongDanAnh ?? "https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?auto=format&fit=crop&w=700&q=80");
                }).ToList();
            }
        }
        catch { }
    }

    private static string NormalizeCityKey(string? diemDen, int maChiNhanh)
    {
        var d = (diemDen ?? "").ToLowerInvariant();
        if (d.Contains("đà lạt") || maChiNhanh == 3) return "Đà Lạt";
        if (d.Contains("phú quốc") || maChiNhanh == 2) return "Phú Quốc";
        if (d.Contains("hội an")) return "Hội An";
        return "Đà Nẵng";
    }

    private IEnumerable<RoomTypeItem> DisplayRoomTypes => allRoomTypes
        .Where(r => string.IsNullOrWhiteSpace(selectedDestination) ||
                    r.DiaDiem.Contains(selectedDestination, StringComparison.OrdinalIgnoreCase) ||
                    selectedDestination.Contains(r.DiaDiem, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrWhiteSpace(selectedVibe) || r.VibeCode == selectedVibe)
        .Where(r => selectedBudget switch
        {
            "low" => r.GiaMoiDem < 800000,
            "mid" => r.GiaMoiDem >= 800000 && r.GiaMoiDem <= 1200000,
            "high" => r.GiaMoiDem > 1200000,
            _ => true
        });

    private int totalNights => Math.Max(1, (checkoutDate.Date - checkinDate.Date).Days);
    private decimal roomSubtotal => (selectedRoom?.GiaMoiDem ?? 0) * totalNights;
    private decimal finalTotal => Math.Max(0, roomSubtotal - discountAmount);
    private decimal depositRequired => Math.Round(finalTotal * 0.3m, 0);
    private bool payDepositNow = true;

    private void SearchRooms() { }

    private void ResetFilters()
    {
        selectedDestination = "";
        selectedBudget = "all";
        selectedVibe = "";
    }

    private void SelectDestinationAndScroll(string destination)
    {
        selectedDestination = NormalizeCityKey(destination, 0);
    }

    private void BookFromAiSuggestion(string cityKey)
    {
        var norm = NormalizeCityKey(cityKey, 0);
        selectedDestination = norm;
        var matchedRoom = allRoomTypes.FirstOrDefault(r => r.DiaDiem.Equals(norm, StringComparison.OrdinalIgnoreCase))
                          ?? allRoomTypes.FirstOrDefault();
        if (matchedRoom != null)
        {
            OpenBookingModal(matchedRoom);
        }
    }

    private string voucherMessage = "";

    private async Task QuickApplyVoucher(string code)
    {
        appliedVoucherCode = code;
        await ApplyVoucher();
    }

    private void OpenBookingModal(RoomTypeItem room)
    {
        selectedRoom = room;
        voucherMessage = "";
        bookingSuccess = false;
        bookingErrorMessage = null;
        if (checkinDate < DateTime.Today)
        {
            checkinDate = DateTime.Today;
        }
        if (checkoutDate <= checkinDate)
        {
            checkoutDate = checkinDate.AddDays(1);
        }
        if (Session.CurrentUser.IsLoggedIn)
        {
            guestName = Session.CurrentUser.HoTen;
            guestEmail = Session.CurrentUser.Email;
        }
        isBookingModalOpen = true;

        if (!string.IsNullOrWhiteSpace(appliedVoucherCode))
        {
            _ = ApplyVoucher();
        }
    }

    private async Task OnCheckinDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var newCheckin))
        {
            if (newCheckin < DateTime.Today)
            {
                newCheckin = DateTime.Today;
            }
            checkinDate = newCheckin;
            if (checkoutDate <= checkinDate)
            {
                checkoutDate = checkinDate.AddDays(1);
            }
            if (!string.IsNullOrWhiteSpace(appliedVoucherCode))
            {
                await ApplyVoucher();
            }
        }
    }

    private async Task OnCheckoutDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var newCheckout))
        {
            if (newCheckout <= checkinDate)
            {
                newCheckout = checkinDate.AddDays(1);
            }
            checkoutDate = newCheckout;
            if (!string.IsNullOrWhiteSpace(appliedVoucherCode))
            {
                await ApplyVoucher();
            }
        }
    }

    private void SyncDates()
    {
        if (checkinDate < DateTime.Today)
            checkinDate = DateTime.Today;
        if (checkoutDate <= checkinDate)
            checkoutDate = checkinDate.AddDays(1);
    }

    private async Task ApplyVoucher()
    {
        voucherMessage = "";
        if (selectedRoom == null) return;
        var code = (appliedVoucherCode ?? "").Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(code))
        {
            discountAmount = 0;
            return;
        }

        if (code == "WELCOM2026") code = "WELCOME2026";
        appliedVoucherCode = code;

        try
        {
            var now = GioVN.Now;
            var v = await Db.MaGiamGia.AsNoTracking()
                .Include(x => x.MaChiNhanhNavigation)
                .FirstOrDefaultAsync(x => x.MaCode.ToUpper() == code && x.DangHoatDong && x.HieuLucDen >= now && x.SoLanDaDung < x.GioiHanSuDung);

            if (v != null)
            {
                if (v.MaChiNhanh.HasValue && selectedRoom.MaChiNhanh > 0 && v.MaChiNhanh.Value != selectedRoom.MaChiNhanh)
                {
                    discountAmount = 0;
                    var branchName = v.MaChiNhanhNavigation?.TenChiNhanh ?? $"Chi nhánh #{v.MaChiNhanh.Value}";
                    voucherMessage = $"Mã giảm giá '{code}' chỉ áp dụng tại {branchName}.";
                    return;
                }

                if (v.GiaTriDatPhongToiThieu.HasValue && roomSubtotal < v.GiaTriDatPhongToiThieu.Value)
                {
                    discountAmount = 0;
                    voucherMessage = $"Đơn hàng tối thiểu {v.GiaTriDatPhongToiThieu.Value:N0} đ để dùng mã {code}.";
                    return;
                }

                var raw = StatusMapper.IsPercentDiscount(v.LoaiGiamGia)
                    ? roomSubtotal * v.GiaTriGiamGia / 100m
                    : v.GiaTriGiamGia;
                if (StatusMapper.IsPercentDiscount(v.LoaiGiamGia) && v.GiamToiDa.HasValue && raw > v.GiamToiDa.Value)
                    raw = v.GiamToiDa.Value;
                discountAmount = Math.Min(raw, roomSubtotal);
                voucherMessage = $"Áp dụng mã {code} thành công! Đã giảm -{discountAmount:N0} VND.";
                return;
            }
        }
        catch { }

        if (code.Equals("WELCOME2026", StringComparison.OrdinalIgnoreCase))
        {
            if (roomSubtotal < 1000000m)
            {
                discountAmount = 0;
                voucherMessage = "Đơn hàng tối thiểu 1.000.000 đ để dùng mã WELCOME2026.";
            }
            else
            {
                discountAmount = roomSubtotal * 0.15m;
                voucherMessage = $"Áp dụng mã WELCOME2026 thành công! Đã giảm -{discountAmount:N0} VND (-15%).";
            }
        }
        else if (code.Equals("SUMMERLUXURY", StringComparison.OrdinalIgnoreCase))
        {
            if (roomSubtotal < 2500000m)
            {
                discountAmount = 0;
                voucherMessage = "Đơn hàng tối thiểu 2.500.000 đ để dùng mã SUMMERLUXURY.";
            }
            else
            {
                discountAmount = 300000;
                voucherMessage = "Áp dụng mã SUMMERLUXURY thành công! Đã giảm -300.000 VND.";
            }
        }
        else
        {
            discountAmount = 0;
            voucherMessage = $"Mã giảm giá '{code}' không hợp lệ hoặc đã hết hạn.";
        }
    }

    private void CopyVoucher(string code)
    {
        appliedVoucherCode = code;
        if (selectedRoom != null)
        {
            _ = ApplyVoucher();
        }
    }

    private async Task SubmitBookingAsync()
    {
        bookingErrorMessage = null;
        if (selectedRoom == null)
        {
            bookingErrorMessage = "Vui lòng chọn hạng phòng.";
            return;
        }
        if (string.IsNullOrWhiteSpace(guestName) || string.IsNullOrWhiteSpace(guestPhone))
        {
            bookingErrorMessage = "Vui lòng nhập đầy đủ Họ tên và Số điện thoại người nhận phòng.";
            return;
        }
        if (checkinDate.Date < DateTime.Today || checkoutDate.Date <= checkinDate.Date)
        {
            bookingErrorMessage = "Ngày trả phòng phải sau ngày nhận phòng và không ở trong quá khứ.";
            return;
        }

        isSubmittingBooking = true;
        try
        {
            await using var transaction = await Db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);

            var now = DateTime.UtcNow;
            var holdExpiryCutoff = now.AddMinutes(-15);

            // Tự động giải phóng các đơn giữ chỗ tạm 0đ đã quá 15 phút chưa đặt cọc (Chống spam giữ phòng ảo)
            var expiredHolds = await Db.DatPhongs
                .Include(b => b.ChiTietDatPhongs)
                    .ThenInclude(ct => ct.MaPhongNavigation)
                .Where(b => b.TrangThai == "Pending" && b.TienDatCoc <= 0 && b.NgayTao < holdExpiryCutoff)
                .ToListAsync();

            foreach (var expired in expiredHolds)
            {
                expired.TrangThai = "Cancelled";
                expired.LyDoHuy = "Tự động hủy giữ chỗ do quá 15 phút chưa thanh toán tiền đặt cọc";
                expired.NgayCapNhat = now;
                foreach (var ct in expired.ChiTietDatPhongs)
                {
                    ct.TrangThai = "Cancelled";
                    if (ct.MaPhongNavigation != null && ct.MaPhongNavigation.TrangThai == "Reserved")
                    {
                        ct.MaPhongNavigation.TrangThai = "Available";
                    }
                }
            }
            if (expiredHolds.Any())
            {
                await Db.SaveChangesAsync();
            }

            var loaiPhong = await Db.LoaiPhongs.FirstOrDefaultAsync(l => l.MaId == selectedRoom.Id)
                ?? await Db.LoaiPhongs.FirstOrDefaultAsync(l => l.DangHoatDong);

            Phong? assignedRoom = null;
            if (loaiPhong != null)
            {
                var candidateRooms = await Db.Phongs
                    .Where(p => p.MaLoaiPhong == loaiPhong.MaId && (p.TrangThai == "Available" || p.TrangThai == "trong"))
                    .OrderBy(p => p.SoPhong)
                    .ToListAsync();

                foreach (var candidate in candidateRooms)
                {
                    var hasConflict = await Db.ChiTietDatPhongs.AnyAsync(ct =>
                        ct.MaPhong == candidate.MaId
                        && ct.TrangThai != "Cancelled" && ct.TrangThai != "cancelled"
                        && ct.TrangThai != "CheckedOut" && ct.TrangThai != "checked_out"
                        && ct.NgayNhanPhongDuKien < checkoutDate.Date
                        && ct.NgayTraPhongDuKien > checkinDate.Date);

                    if (!hasConflict)
                    {
                        assignedRoom = candidate;
                        break;
                    }
                }
            }

            int? voucherId = null;
            if (!string.IsNullOrWhiteSpace(appliedVoucherCode) && discountAmount > 0)
            {
                var code = appliedVoucherCode.Trim().ToUpperInvariant();
                var v = await Db.MaGiamGia.FirstOrDefaultAsync(x =>
                    x.MaCode.ToUpper() == code && x.DangHoatDong && x.HieuLucDen >= GioVN.Now && x.SoLanDaDung < x.GioiHanSuDung);
                if (v != null)
                {
                    if (v.MaChiNhanh.HasValue && selectedRoom.MaChiNhanh > 0 && v.MaChiNhanh.Value != selectedRoom.MaChiNhanh)
                    {
                        await transaction.RollbackAsync();
                        bookingErrorMessage = $"Mã giảm giá '{code}' chỉ áp dụng tại chi nhánh tương ứng.";
                        return;
                    }

                    if (v.GiaTriDatPhongToiThieu.HasValue && roomSubtotal < v.GiaTriDatPhongToiThieu.Value)
                    {
                        await transaction.RollbackAsync();
                        bookingErrorMessage = $"Đơn đặt phòng phải đạt tối thiểu {v.GiaTriDatPhongToiThieu.Value:N0} đ để dùng mã {code}.";
                        return;
                    }

                    if (Db.Database.IsRelational())
                    {
                        var rowsAffected = await Db.Database.ExecuteSqlInterpolatedAsync(
                            $"UPDATE MaGiamGia SET SoLanDaDung = SoLanDaDung + 1 WHERE MaId = {v.MaId} AND SoLanDaDung < GioiHanSuDung AND DangHoatDong = 1");
                        if (rowsAffected == 0)
                        {
                            await transaction.RollbackAsync();
                            bookingErrorMessage = "Mã giảm giá vừa hết lượt sử dụng. Vui lòng thử lại.";
                            return;
                        }
                    }
                    else
                    {
                        v.SoLanDaDung += 1;
                    }

                    voucherId = v.MaId;
                }
            }

            var userId = Session.CurrentUser.IsLoggedIn && Session.CurrentUser.Id > 0
                ? (int?)Session.CurrentUser.Id
                : null;

            var actualDeposit = payDepositNow ? depositRequired : 0m;
            var initialStatus = payDepositNow ? "Confirmed" : "Pending";

            var booking = new DatPhong
            {
                MaDatPhong = $"DP-WEB-{now:yyMMddHHmmss}",
                MaChiNhanh = selectedRoom.MaChiNhanh > 0 ? selectedRoom.MaChiNhanh : (loaiPhong?.MaChiNhanh ?? 1),
                MaNguoiDung = userId,
                NguoiTao = userId,
                TenKhach = guestName.Trim(),
                Sdtkhach = guestPhone.Trim(),
                EmailKhach = string.IsNullOrWhiteSpace(guestEmail) ? null : guestEmail.Trim(),
                MaGiamGia = voucherId,
                KenhDatPhong = "web",
                TrangThai = initialStatus,
                TongTien = finalTotal,
                TienDatCoc = actualDeposit,
                GhiChu = payDepositNow
                    ? $"Đặt phòng trực tuyến ({selectedRoom.TenLoai}, {totalNights} đêm) — Đã đặt cọc 30% qua VietQR/VNPAY"
                    : $"Đặt phòng trực tuyến ({selectedRoom.TenLoai}, {totalNights} đêm) — Giữ chỗ tạm thời 15 phút",
                NgayTao = now,
                NgayCapNhat = now
            };

            Db.DatPhongs.Add(booking);
            await Db.SaveChangesAsync();

            if (loaiPhong != null)
            {
                Db.ChiTietDatPhongs.Add(new ChiTietDatPhong
                {
                    MaDatPhong = booking.MaId,
                    MaPhong = assignedRoom?.MaId,
                    MaLoaiPhong = loaiPhong.MaId,
                    NgayNhanPhongDuKien = checkinDate.Date,
                    NgayTraPhongDuKien = checkoutDate.Date,
                    GiaMoiDem = selectedRoom.GiaMoiDem,
                    TrangThai = "Pending"
                });
            }

            var hoaDon = new HoaDon
            {
                MaDatPhong = booking.MaId,
                TongTienPhong = roomSubtotal,
                TongTienDichVu = 0,
                TienGiamGia = discountAmount,
                TienThue = 0,
                TienPhuThu = 0,
                TongThanhToan = finalTotal,
                TrangThai = "Pending",
                NgayTao = now
            };
            Db.HoaDons.Add(hoaDon);
            await Db.SaveChangesAsync();

            if (payDepositNow && actualDeposit > 0)
            {
                Db.ThanhToans.Add(new ThanhToan
                {
                    MaHoaDon = hoaDon.MaId,
                    PhuongThucThanhToan = "VNPay",
                    SoTienDaThanhToan = actualDeposit,
                    MaGiaoDich = $"COC-{booking.MaDatPhong}",
                    TrangThai = "Success",
                    NgayThanhToan = now
                });
            }

            if (assignedRoom != null && checkinDate.Date == DateTime.Today)
            {
                assignedRoom.TrangThai = "Reserved";
            }

            await Db.SaveChangesAsync();
            await transaction.CommitAsync();

            await AuditService.GhiNhanAsync(
                "DAT_PHONG_WEB",
                "DatPhong",
                booking.MaId.ToString(),
                $"Đặt phòng trực tuyến {booking.MaDatPhong} — Khách: {booking.TenKhach}, Tổng: {finalTotal:N0} đ",
                userId,
                booking.EmailKhach,
                "127.0.0.1",
                true);

            bookingCode = booking.MaId;
            bookingCodeText = booking.MaDatPhong;
            bookingSuccess = true;

            try
            {
                await LocalStorage.SetAsync("dacn_recent_code", booking.MaDatPhong);
                await LocalStorage.SetAsync("dacn_recent_contact", !string.IsNullOrWhiteSpace(booking.Sdtkhach) ? booking.Sdtkhach : (booking.EmailKhach ?? ""));
            }
            catch { }
        }
        catch (Exception ex)
        {
            var detail = ex.InnerException != null ? $"{ex.Message} -> {ex.InnerException.Message}" : ex.Message;
            bookingErrorMessage = $"Không thể lưu đơn đặt phòng: {detail}";
        }
        finally
        {
            isSubmittingBooking = false;
        }
    }
}
