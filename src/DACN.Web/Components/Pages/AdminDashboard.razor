                    <div class="hotel-card-title">
                        <i class="bi bi-receipt text-primary me-2"></i>
                        <span>Hóa Đơn Mới Phát Sinh Cần Đối Soát</span>
                    </div>
                    <a href="frontdesk/services-billing" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
                </div>
                <div class="hotel-card-body p-0">
                    <div class="table-responsive">
                        <table class="hotel-table">
                            <thead>
                                <tr>
                                    <th>Mã HĐ</th>
                                    <th>Mã Đặt Phòng</th>
                                    <th>Khách Hàng</th>
                                    <th>Tiền Phòng</th>
                                    <th>Tiền Dịch Vụ</th>
                                    <th>Tổng Thanh Toán</th>
                                    <th>Trạng Thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!recentInvoices.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">Chưa có hóa đơn nào phát sinh gần đây.</td>
                                    </tr>
                                }
                                @foreach (var inv in recentInvoices.Take(5))
                                {
                                    <tr>
                                        <td><span class="font-monospace fw-bold text-dark">#HD-@inv.Id.ToString("D4")</span></td>
                                        <td><span class="font-monospace text-primary">@inv.BookingCode</span></td>
                                        <td class="fw-semibold">@inv.GuestName</td>
                                        <td>@inv.RoomTotal.ToString("N0") đ</td>
                                        <td>@inv.ServiceTotal.ToString("N0") đ</td>
                                        <td class="fw-bold text-success">@inv.GrandTotal.ToString("N0") đ</td>
                                        <td>
                                            @if (inv.Status == "Paid" || inv.Status == "da_thanh_toan")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Đã thanh toán</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Chờ thanh toán</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Chi phí vận hành gần đây -->
            <div class="hotel-card shadow-sm">
                <div class="hotel-card-header d-flex justify-content-between align-items-center">
                    <div class="hotel-card-title">
                        <i class="bi bi-cash-coin text-danger me-2"></i>
                        <span>Phiếu Chi Phí Vận Hành Gần Đây</span>
                    </div>
                    <a href="frontdesk/expenses" class="btn btn-sm btn-outline-danger">Quản lý chi phí</a>
                </div>
                <div class="hotel-card-body p-0">
                    <div class="table-responsive">
                        <table class="hotel-table">
                            <thead>
                                <tr>
                                    <th>Danh Mục</th>
                                    <th>Nội Dung Chi</th>
                                    <th>Số Tiền</th>
                                    <th>Ngày Chi</th>
                                    <th>Trạng Thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!recentExpenses.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">Chưa có phiếu chi phí nào trong kỳ này.</td>
                                    </tr>
                                }
                                @foreach (var exp in recentExpenses.Take(5))
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark border">@exp.Category</span></td>
                                        <td class="small">@(exp.Description ?? "Chi phí nội bộ")</td>
                                        <td class="fw-bold text-danger">-@exp.Amount.ToString("N0") đ</td>
                                        <td>@exp.Date.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">@exp.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <!-- Cơ cấu thanh toán -->
            <div class="hotel-card mb-4 shadow-sm">
                <div class="hotel-card-header">
                    <div class="hotel-card-title">
                        <i class="bi bi-pie-chart-fill text-primary me-2"></i>
                        <span>Cơ Cấu Phương Thức Thanh Toán</span>
                    </div>
                </div>
                <div class="hotel-card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 p-2 rounded-2 bg-light">
                        <div>
                            <span class="fw-bold text-dark d-block"><i class="bi bi-qr-code text-primary me-1"></i> VNPay / VietQR</span>
                            <small class="text-muted">Cổng thanh toán online</small>
                        </div>
                        <span class="fw-bold text-primary">@vnpayRevenue.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 p-2 rounded-2 bg-light">
                        <div>
                            <span class="fw-bold text-dark d-block"><i class="bi bi-cash text-success me-1"></i> Tiền Mặt (Cash)</span>
                            <small class="text-muted">Thu trực tiếp tại quầy</small>
                        </div>
                        <span class="fw-bold text-success">@cashRevenue.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 p-2 rounded-2 bg-light">
                        <div>
                            <span class="fw-bold text-dark d-block"><i class="bi bi-bank text-info me-1"></i> Chuyển Khoản Ngân Hàng</span>
                            <small class="text-muted">Bank Transfer</small>
                        </div>
                        <span class="fw-bold text-info">@bankRevenue.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-light">
                        <div>
                            <span class="fw-bold text-dark d-block"><i class="bi bi-wallet-fill text-danger me-1"></i> Ví MoMo</span>
                            <small class="text-muted">Thanh toán di động</small>
                        </div>
                        <span class="fw-bold text-danger">@momoRevenue.ToString("N0") đ</span>
                    </div>
                </div>
            </div>

            <!-- Phím tắt kế toán -->
            <div class="hotel-card shadow-sm">
                <div class="hotel-card-header">
                    <div class="hotel-card-title">
                        <i class="bi bi-gear-fill text-secondary me-2"></i>
                        <span>Phím Tắt Kế Toán</span>
                    </div>
                </div>
                <div class="hotel-card-body d-flex flex-column gap-2">
                    <a href="frontdesk/services-billing" class="btn btn-light border text-start py-2 d-flex align-items-center">
                        <i class="bi bi-receipt text-primary fs-5 me-3"></i>
                        <div>
                            <div class="fw-bold small text-dark">Thu Tiền & Hóa Đơn Dịch Vụ</div>
                            <small class="text-muted">In hóa đơn VAT & xác nhận thanh toán</small>
                        </div>
                    </a>
                    <a href="frontdesk/expenses" class="btn btn-light border text-start py-2 d-flex align-items-center">
                        <i class="bi bi-wallet2 text-danger fs-5 me-3"></i>
                        <div>
                            <div class="fw-bold small text-dark">Quản Lý Chi Phí Vận Hành</div>
                            <small class="text-muted">Theo dõi xuất quỹ, hóa đơn mua hàng</small>
                        </div>
                    </a>
                    <a href="ai-analytics/dashboard" class="btn btn-light border text-start py-2 d-flex align-items-center">
                        <i class="bi bi-file-earmark-bar-graph text-success fs-5 me-3"></i>
                        <div>
                            <div class="fw-bold small text-dark">Báo Cáo Doanh Thu (BI)</div>
                            <small class="text-muted">Biểu đồ RevPAR, ADR và tăng trưởng</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

