@page "/admin/dashboard"
@page "/staff"
@inject DACNContext Db
@inject UserSessionService Session
@inject IAuditService AuditService
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@GetPageTitle() — Grand Hotel Da Nang</PageTitle>

<PageHeader Title="@GetHeaderTitle()" 
            Subtitle="@GetHeaderSubtitle()" 
            Icon="@GetHeaderIcon()">
    <Actions>
        <button class="hotel-btn hotel-btn-outline" @onclick="LoadStatsAsync">
            <i class="bi bi-arrow-clockwise"></i> Làm mới
        </button>
        @if (activePerspective == "FrontDesk" || activePerspective == "Admin")
        {
            <a href="frontdesk/bookings" class="hotel-btn hotel-btn-primary">
                <i class="bi bi-plus-circle"></i> Đặt Phòng Nhanh
            </a>
        }
        else if (activePerspective == "Housekeeping")
        {
            <a href="housekeeping/tasks" class="hotel-btn hotel-btn-primary">
                <i class="bi bi-journal-plus"></i> Giao Ca Dọn
            </a>
        }
        else if (activePerspective == "Accountant")
        {
            <a href="frontdesk/expenses" class="hotel-btn hotel-btn-primary">
                <i class="bi bi-plus-circle"></i> Lập Phiếu Chi
            </a>
        }
        else if (activePerspective == "Manager")
        {
            <a href="ai-analytics/dashboard" class="hotel-btn hotel-btn-primary">
                <i class="bi bi-pie-chart-fill"></i> Báo Cáo BI
            </a>
        }
    </Actions>
</PageHeader>

@if (actionSuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @actionSuccessMessage
        <button type="button" class="btn-close" @onclick="() => actionSuccessMessage = null"></button>
    </div>
}

<!-- THANH CHUYỂN ĐỔI GÓC NHÌN & CHI NHÁNH CHUỖI KHÁCH SẠN -->
@if (Session.CurrentUser.Role is "Admin" or "Manager")
{
    <div class="card border-0 shadow-sm rounded-3 mb-4 p-3 bg-white">
        <!-- BỘ LỌC CHI NHÁNH CHUỖI HỆ THỐNG -->
        <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom flex-wrap">
            <div class="fw-bold text-dark d-flex align-items-center me-2">
                <i class="bi bi-buildings-fill text-primary me-2"></i> Chi Nhánh Khách Sạn:
            </div>
            <div class="btn-group btn-group-sm flex-wrap" role="group">
                <button type="button" class="btn @(selectedBranchId == 0 ? "btn-dark fw-bold px-3" : "btn-outline-secondary px-3")" @onclick="() => SetBranch(0)">
                    🏨 Toàn Hệ Thống Chuỗi
                </button>
                <button type="button" class="btn @(selectedBranchId == 1 ? "btn-primary fw-bold px-3" : "btn-outline-primary px-3")" @onclick="() => SetBranch(1)">
                    🌊 GrandStay Đà Nẵng
                </button>
                <button type="button" class="btn @(selectedBranchId == 2 ? "btn-info text-white fw-bold px-3" : "btn-outline-info px-3")" @onclick="() => SetBranch(2)">
                    🌴 GrandStay Phú Quốc
                </button>
                <button type="button" class="btn @(selectedBranchId == 3 ? "btn-success fw-bold px-3" : "btn-outline-success px-3")" @onclick="() => SetBranch(3)">
                    🌲 GrandStay Đà Lạt
                </button>
            </div>
            @if (selectedBranchId > 0)
            {
                <span class="badge bg-warning text-dark px-2 py-1 ms-auto">
                    <i class="bi bi-funnel-fill me-1"></i> Đang xem: @(selectedBranchId == 2 ? "GrandStay Phú Quốc" : selectedBranchId == 3 ? "GrandStay Đà Lạt" : "GrandStay Đà Nẵng")
                </span>
            }
            else
            {
                <span class="badge bg-secondary text-white px-2 py-1 ms-auto">
                    <i class="bi bi-globe-americas me-1"></i> Số liệu tổng hợp toàn chuỗi
                </span>
            }
        </div>

        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
            <div class="d-flex align-items-center">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 me-2 px-2 py-1">
                    <i class="bi bi-eye-fill me-1"></i> Chế Độ Giám Sát Phân Hệ
                </span>
                <span class="small text-muted">
                    Tài khoản <strong>@Session.CurrentUser.RoleDisplayName</strong> có quyền xem bảng điều khiển của từng bộ phận ca trực:
                </span>
            </div>
            <div class="btn-group btn-group-sm flex-wrap" role="group">
                <button type="button" class="btn @(activePerspective == "Admin" ? "btn-primary fw-bold" : "btn-outline-secondary")" @onclick='() => SetPerspective("Admin")'>
                    <i class="bi bi-shield-lock-fill me-1"></i> Toàn Cảnh (Admin)
                </button>
                <button type="button" class="btn @(activePerspective == "FrontDesk" ? "btn-primary fw-bold" : "btn-outline-secondary")" @onclick='() => SetPerspective("FrontDesk")'>
                    <i class="bi bi-bell-fill me-1"></i> Tiền Sảnh (Lễ Tân)
                </button>
                <button type="button" class="btn @(activePerspective == "Housekeeping" ? "btn-primary fw-bold" : "btn-outline-secondary")" @onclick='() => SetPerspective("Housekeeping")'>
                    <i class="bi bi-brush-fill me-1"></i> Buồng Phòng
                </button>
                <button type="button" class="btn @(activePerspective == "Accountant" ? "btn-primary fw-bold" : "btn-outline-secondary")" @onclick='() => SetPerspective("Accountant")'>
                    <i class="bi bi-cash-coin me-1"></i> Kế Toán
                </button>
                <button type="button" class="btn @(activePerspective == "Manager" ? "btn-primary fw-bold" : "btn-outline-secondary")" @onclick='() => SetPerspective("Manager")'>
                    <i class="bi bi-graph-up-arrow me-1"></i> Giám Đốc (BI & AI)
                </button>
            </div>
        </div>
    </div>
}
else
{
    <!-- BANNER KHÓA CƠ SỞ CHO NHÂN VIÊN CA TRỰC -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 p-3 bg-white border-start border-4 border-primary">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary px-3 py-2 fs-6">
                    <i class="bi bi-geo-alt-fill me-1"></i> Chi nhánh công tác: @Session.CurrentUser.TenChiNhanh
                </span>
                <span class="text-muted small">
                    Hệ thống tự động khóa và bảo mật dữ liệu phòng, đơn khách và dịch vụ theo chi nhánh của bạn.
                </span>
            </div>
            <span class="badge bg-light text-dark border px-3 py-2">
                Mã Cơ Sở: <strong>CN-@(Session.CurrentUser.MaChiNhanh == 2 ? "PHUQUOC" : Session.CurrentUser.MaChiNhanh == 3 ? "DALAT" : "DANANG")</strong>
            </span>
        </div>
    </div>
}

@* ========================================================================= *@
@* 1. GIAO DIỆN TIỀN SẢNH & LỄ TÂN (FRONT DESK VIEW)                          *@
@* ========================================================================= *@
@if (activePerspective == "FrontDesk")
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Khách Check-in Hôm Nay" 
                      Value="@($"{frontDeskCheckIns.Count} Đơn")" 
                      Description="Dự kiến nhận phòng hôm nay" 
                      Icon="bi bi-box-arrow-in-right" 
                      Variant="info" />
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Khách Check-out Hôm Nay" 
                      Value="@($"{frontDeskCheckOuts.Count} Đơn")" 
                      Description="Dự kiến trả phòng hôm nay" 
                      Icon="bi bi-box-arrow-left" 
                      Variant="warning" />
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Phòng Sạch Sẵn Sàng" 
                      Value="@($"{cleanAvailableCount} / {rooms.Count}")" 
                      Description="Chìa khóa sẵn sàng bàn giao" 
                      Icon="bi bi-door-open-fill" 
                      Variant="success" />
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Tiền Thu Trong Ca" 
                      Value="@($"{todayRevenue:N0} đ")" 
                      Description="Thanh toán thành công hôm nay" 
                      Icon="bi bi-cash-stack" 
                      Variant="accent" />
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="hotel-card h-100 shadow-sm">
                <div class="hotel-card-header d-flex justify-content-between align-items-center">
                    <div class="hotel-card-title">
                        <i class="bi bi-calendar2-week text-primary me-2"></i>
                        <span>Danh Sách Khách Nhận & Trả Phòng Ca Trực</span>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn @(frontDeskFilter == "all" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => frontDeskFilter = "all"'>
                            Tất cả (@frontDeskBookings.Count)
                        </button>
                        <button type="button" class="btn @(frontDeskFilter == "checkin" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => frontDeskFilter = "checkin"'>
                            Đến (@frontDeskCheckIns.Count)
                        </button>
                        <button type="button" class="btn @(frontDeskFilter == "checkout" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => frontDeskFilter = "checkout"'>
                            Đi (@frontDeskCheckOuts.Count)
                        </button>
                    </div>
                </div>
                <div class="hotel-card-body p-0">
                    <div class="table-responsive">
                        <table class="hotel-table">
                            <thead>
                                <tr>
                                    <th>Mã Đơn</th>
                                    <th>Khách Hàng</th>
                                    <th>Phòng & Hạng</th>
                                    <th>Nghiệp Vụ</th>
                                    <th>Cọc / Tổng Tiền</th>
                                    <th class="text-end">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredFrontDeskBookings.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            Không có lượt khách nào cần nhận hoặc trả phòng theo bộ lọc hiện tại.
                                        </td>
                                    </tr>
                                }
                                @foreach (var item in FilteredFrontDeskBookings.Take(8))
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold font-monospace text-primary">@item.BookingCode</span>
                                        </td>
                                        <td>
                                            <div class="fw-bold">@item.GuestName</div>
                                            <small class="text-muted">@item.GuestPhone</small>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@(item.RoomNumber != null ? $"Phòng {item.RoomNumber}" : "Chưa xếp phòng")</div>
                                            <small class="text-muted">@item.RoomName</small>
                                        </td>
                                        <td>
                                            @if (item.Direction == "CheckIn")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="bi bi-box-arrow-in-right me-1"></i>Nhận phòng
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                    <i class="bi bi-box-arrow-left me-1"></i>Trả phòng
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@item.Total.ToString("N0") đ</div>
                                            <small class="text-success">Cọc: @item.Deposit.ToString("N0") đ</small>
                                        </td>
                                        <td class="text-end">
                                            @if (item.Direction == "CheckIn")
                                            {
                                                <a href="frontdesk/checkin-out" class="hotel-btn hotel-btn-primary py-1 px-2 small">
                                                    <i class="bi bi-check2-circle me-1"></i>Check-in
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="frontdesk/services-billing" class="hotel-btn hotel-btn-outline py-1 px-2 small">
                                                    <i class="bi bi-receipt me-1"></i>Hóa đơn
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <!-- Room Rack Mini -->
            <div class="hotel-card mb-4 shadow-sm">
                <div class="hotel-card-header">
                    <div class="hotel-card-title">
                        <i class="bi bi-grid-3x3-gap text-primary me-2"></i>
                        <span>Sơ Đồ Tình Trạng Buồng Phòng</span>
                    </div>
                </div>
                <div class="hotel-card-body">
                    <div class="d-flex justify-content-between mb-2 small">
                        <span>Đang có khách ở:</span>
                        <strong class="text-primary">@occupiedCount phòng (@(rooms.Count > 0 ? (occupiedCount * 100 / rooms.Count) : 0)%)</strong>
                    </div>
                    <div class="progress mb-3" style="height: 8px;">
                        <div class="progress-bar bg-primary" style="width: @(rooms.Count > 0 ? (occupiedCount * 100 / rooms.Count) : 0)%"></div>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span>Trống sạch đón khách:</span>
                        <strong class="text-success">@cleanAvailableCount phòng</strong>
                    </div>
                    <div class="progress mb-3" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: @(rooms.Count > 0 ? (cleanAvailableCount * 100 / rooms.Count) : 0)%"></div>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span>Chờ dọn vệ sinh:</span>
                        <strong class="text-warning">@cleaningCount phòng</strong>
                    </div>
                    <div class="progress mb-3" style="height: 8px;">
                        <div class="progress-bar bg-warning" style="width: @(rooms.Count > 0 ? (cleaningCount * 100 / rooms.Count) : 0)%"></div>
                    </div>

                    <a href="frontdesk/bookings" class="hotel-btn hotel-btn-outline w-100 text-center mt-2">
                        <i class="bi bi-calendar-check me-1"></i> Mở Sơ Đồ Room Rack Toàn Diện
                    </a>
                </div>
            </div>

            <!-- Phím tắt lễ tân -->
            <div class="hotel-card shadow-sm">
                <div class="hotel-card-header">
                    <div class="hotel-card-title">
                        <i class="bi bi-lightning-charge text-warning me-2"></i>
                        <span>Tác Vụ Lễ Tân Nhanh</span>
                    </div>
                </div>
                <div class="hotel-card-body d-flex flex-column gap-2">
                    <a href="frontdesk/bookings" class="btn btn-light border text-start py-2 d-flex align-items-center">
                        <i class="bi bi-plus-square-fill text-primary fs-5 me-3"></i>
                        <div>
                            <div class="fw-bold small text-dark">Đặt Phòng Trực Tiếp Tại Quầy</div>
                            <small class="text-muted">Nhập thông tin khách vãng lai nhận phòng ngay</small>
                        </div>
                    </a>
                    <a href="frontdesk/checkin-out" class="btn btn-light border text-start py-2 d-flex align-items-center">
                        <i class="bi bi-person-check-fill text-success fs-5 me-3"></i>
                        <div>
                            <div class="fw-bold small text-dark">Quầy Check-in / Check-out</div>
                            <small class="text-muted">Bàn giao chìa khóa và xác nhận trả phòng</small>
                        </div>
                    </a>
                    <a href="frontdesk/services-billing" class="btn btn-light border text-start py-2 d-flex align-items-center">
                        <i class="bi bi-receipt-cutoff text-info fs-5 me-3"></i>
                        <div>
                            <div class="fw-bold small text-dark">Lập Hóa Đơn Dịch Vụ & Thu Tiền</div>
                            <small class="text-muted">Minibar, giặt là, ẩm thực và thanh toán VNPay</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@* ========================================================================= *@
@* 2. GIAO DIỆN BUỒNG PHÒNG & VẬN HÀNH (HOUSEKEEPING VIEW)                    *@
@* ========================================================================= *@
else if (activePerspective == "Housekeeping")
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Phòng Cần Dọn Gấp" 
                      Value="@($"{cleaningCount} Phòng")" 
                      Description="Khách vừa trả / Cần dọn đón khách" 
                      Icon="bi bi-brush-fill" 
                      Variant="warning" />
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Đang Dọn / Kiểm Tra" 
                      Value="@($"{inspectingCount} Phòng")" 
                      Description="Nhân viên đang tiến hành dọn" 
                      Icon="bi bi-hourglass-split" 
                      Variant="info" />
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Phòng Đã Sạch Chuẩn" 
                      Value="@($"{cleanCount} / {rooms.Count}")" 
                      Description="Sẵn sàng đón khách nhận phòng" 
                      Icon="bi bi-check2-circle" 
                      Variant="success" />
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Sự Cố Tiện Nghi / Hư Hỏng" 
                      Value="@($"{openIncidentsCount} Sự Cố")" 
                      Description="Cần sửa chữa hoặc bồi hoàn" 
                      Icon="bi bi-exclamation-octagon-fill" 
                      Variant="danger" />
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="hotel-card h-100 shadow-sm">
                <div class="hotel-card-header d-flex justify-content-between align-items-center">
                    <div class="hotel-card-title">
                        <i class="bi bi-door-closed text-primary me-2"></i>
                        <span>Bảng Điều Phối Buồng Phòng Theo Tầng</span>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn @(housekeepingFilter == "all" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => housekeepingFilter = "all"'>
                            Tất cả (@housekeepingRooms.Count)
                        </button>
                        <button type="button" class="btn @(housekeepingFilter == "dirty" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => housekeepingFilter = "dirty"'>
                            Cần dọn (@cleaningCount)
                        </button>
                        <button type="button" class="btn @(housekeepingFilter == "clean" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => housekeepingFilter = "clean"'>
                            Đã sạch (@cleanCount)
                        </button>
                    </div>
                </div>
                <div class="hotel-card-body p-0">
                    <div class="table-responsive">
                        <table class="hotel-table">
                            <thead>
                                <tr>
                                    <th>Số Phòng</th>
                                    <th>Tầng & Hạng</th>
                                    <th>Lưu Trú</th>
                                    <th>Trạng Thái Vệ Sinh</th>
                                    <th class="text-end">Hành Động 1-Click</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var room in FilteredHousekeepingRooms.Take(10))
                                {
                                    <tr>
                                        <td>
                                            <span class="fs-6 fw-bold font-monospace text-primary">Phòng @room.RoomNumber</span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">Tầng @room.Floor</div>
                                            <small class="text-muted">@room.RoomType</small>
                                        </td>
                                        <td>
                                            @if (room.OccupancyStatus == "Đang ở")
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                    <i class="bi bi-person-fill me-1"></i>Đang ở
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Trống</span>
                                            }
                                        </td>
                                        <td>
                                            @if (room.CleanlinessStatus == "Dirty")
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Cần dọn (Dirty)
                                                </span>
                                            }
                                            else if (room.CleanlinessStatus == "Inspecting")
                                            {
                                                <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                                    <i class="bi bi-hourglass-split me-1"></i>Đang kiểm tra
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Đã sạch chuẩn
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (room.CleanlinessStatus == "Dirty")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-info py-1 px-2" @onclick='() => QuickUpdateCleaningStatusAsync(room.Id, "Inspecting")'>
                                                    <i class="bi bi-brush me-1"></i>Bắt đầu dọn
                                                </button>
                                            }
                                            else if (room.CleanlinessStatus == "Inspecting")
                                            {
                                                <button type="button" class="btn btn-sm btn-success py-1 px-2 fw-semibold" @onclick='() => QuickUpdateCleaningStatusAsync(room.Id, "Clean")'>
                                                    <i class="bi bi-check2-all me-1"></i>Nghiệm thu sạch
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-light border text-muted py-1 px-2" @onclick='() => QuickUpdateCleaningStatusAsync(room.Id, "Dirty")'>
                                                    <i class="bi bi-arrow-repeat me-1"></i>Đánh dấu dọn lại
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <!-- Quy chuẩn vệ sinh -->
            <div class="hotel-card mb-4 shadow-sm">
                <div class="hotel-card-header">
                    <div class="hotel-card-title">
                        <i class="bi bi-clipboard-check text-success me-2"></i>
                        <span>Tiêu Chuẩn Vệ Sinh Ca Trực</span>
                    </div>
                </div>
                <div class="hotel-card-body small">
                    <ul class="list-unstyled mb-0">
