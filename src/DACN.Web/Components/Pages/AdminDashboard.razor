                      Icon="bi bi-pie-chart-fill" 
                      Variant="info" />
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Doanh Thu Tích Lũy Tháng" 
                      Value="@($"{monthlyRevenue:N0} đ")" 
                      Description="@($"Doanh thu tháng {DateTime.Today.Month}")" 
                      Icon="bi bi-graph-up" 
                      Variant="success" />
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Dự Báo Nhu Cầu AI" 
                      Value="+32% Tăng" 
                      Description="Cao điểm du lịch cuối tuần" 
                      Icon="bi bi-cpu-fill" 
                      Variant="ai" />
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Đơn Nguy Cơ Hủy Cao" 
                      Value="@($"{highRiskBookings.Count} Đơn")" 
                      Description="Cần can thiệp chăm sóc khách" 
                      Icon="bi bi-shield-exclamation" 
                      Variant="danger" />
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <!-- Cảnh báo hủy phòng AI -->
            <div class="hotel-card mb-4 shadow-sm">
                <div class="hotel-card-header d-flex justify-content-between align-items-center">
                    <div class="hotel-card-title">
                        <i class="bi bi-cpu text-primary me-2"></i>
                        <span>Cảnh Báo AI: Khách Hàng Có Nguy Cơ Hủy Phòng (Churn Risk)</span>
                    </div>
                    <a href="ai-analytics/forecast" class="btn btn-sm btn-outline-primary">Xem chi tiết AI</a>
                </div>
                <div class="hotel-card-body p-0">
                    <div class="table-responsive">
                        <table class="hotel-table">
                            <thead>
                                <tr>
                                    <th>Mã Đơn</th>
                                    <th>Khách Hàng</th>
                                    <th>Ngày Đến</th>
                                    <th>Tổng Tiền</th>
                                    <th>Xác Suất Hủy</th>
                                    <th>Mức Rủi Ro</th>
                                    <th>Yếu Tố Chính</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!highRiskBookings.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            Hiện tại không có đơn đặt phòng nào bị xếp vào nhóm rủi ro hủy cao.
                                        </td>
                                    </tr>
                                }
                                @foreach (var item in highRiskBookings)
                                {
                                    <tr>
                                        <td><span class="font-monospace fw-bold text-primary">@item.BookingCode</span></td>
                                        <td class="fw-semibold">@item.GuestName</td>
                                        <td>@item.CheckinDate.ToString("dd/MM/yyyy")</td>
                                        <td class="fw-bold">@item.Total.ToString("N0") đ</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-1">
                                                <div class="progress flex-grow-1" style="height: 6px;">
                                                    <div class="progress-bar bg-danger" style="width: @(item.RiskProbability * 100)%"></div>
                                                </div>
                                                <small class="fw-bold text-danger">@((item.RiskProbability * 100).ToString("F0"))%</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @(item.RiskLevel == "Cao" ? "bg-danger" : "bg-warning text-dark")">
                                                @item.RiskLevel
                                            </span>
                                        </td>
                                        <td class="small text-muted">@item.MainFactor</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <!-- Tổng quan nhanh -->
            <div class="hotel-card mb-4 shadow-sm">
                <div class="hotel-card-header">
                    <div class="hotel-card-title">
                        <i class="bi bi-activity text-primary me-2"></i>
                        <span>Chỉ Số Vận Hành Trọng Yếu</span>
                    </div>
                </div>
                <div class="hotel-card-body small">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Tổng số buồng phòng:</span>
                        <strong class="text-dark">@rooms.Count phòng</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Phòng đang ở:</span>
                        <strong class="text-primary">@occupiedCount phòng</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Phòng sạch sẵn sàng đón khách:</span>
                        <strong class="text-success">@cleanAvailableCount phòng</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Phòng bẩn đang dọn:</span>
                        <strong class="text-warning">@cleaningCount phòng</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Hóa đơn công nợ chưa thu:</span>
                        <strong class="text-danger">@pendingInvoicesCount đơn</strong>
                    </div>
                </div>
            </div>

            <!-- Phím tắt quản lý -->
            <div class="hotel-card shadow-sm">
                <div class="hotel-card-header">
                    <div class="hotel-card-title">
                        <i class="bi bi-speedometer text-info me-2"></i>
                        <span>Phím Tắt Ban Quản Lý</span>
                    </div>
                </div>
                <div class="hotel-card-body d-flex flex-column gap-2">
                    <a href="ai-analytics/dashboard" class="btn btn-light border text-start py-2 d-flex align-items-center">
                        <i class="bi bi-pie-chart text-primary fs-5 me-3"></i>
                        <div>
                            <div class="fw-bold small text-dark">Báo Cáo Phân Tích (BI)</div>
                            <small class="text-muted">Doanh thu, RevPAR và tỷ lệ lấp đầy</small>
                        </div>
                    </a>
                    <a href="ai-analytics/forecast" class="btn btn-light border text-start py-2 d-flex align-items-center">
                        <i class="bi bi-graph-up-arrow text-success fs-5 me-3"></i>
                        <div>
                            <div class="fw-bold small text-dark">Dự Báo AI & Rủi Ro Hủy Phòng</div>
                            <small class="text-muted">Machine Learning dự đoán cao điểm</small>
                        </div>
                    </a>
                    <a href="frontdesk/expenses" class="btn btn-light border text-start py-2 d-flex align-items-center">
                        <i class="bi bi-cash-stack text-warning fs-5 me-3"></i>
                        <div>
                            <div class="fw-bold small text-dark">Giám Sát Chi Phí Vận Hành</div>
                            <small class="text-muted">Kiểm soát dòng tiền và biên lợi nhuận</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

