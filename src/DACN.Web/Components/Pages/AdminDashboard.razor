@* 3. GIAO DIỆN KẾ TOÁN & THU NGÂN (ACCOUNTANT VIEW)                          *@
@* ========================================================================= *@
else if (activePerspective == "Accountant")
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Doanh Thu Thu Tiền Hôm Nay" 
                      Value="@($"{todayRevenue:N0} đ")" 
                      Description="Tổng thanh toán thành công" 
                      Icon="bi bi-cash-stack" 
                      Variant="success" />
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Hóa Đơn Chờ Thu / Công Nợ" 
                      Value="@($"{pendingInvoicesCount} HĐ")" 
                      Description="@($"Tổng tiền: {pendingInvoicesTotal:N0} đ")" 
                      Icon="bi bi-clock-history" 
                      Variant="warning" />
