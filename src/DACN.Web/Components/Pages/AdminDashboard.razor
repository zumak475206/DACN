    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += OnSessionChanged;
        InitPerspective();
        await LoadStatsAsync();
    }

    private void InitPerspective()
    {
        activePerspective = Session.CurrentUser.Role switch
        {
            "FrontDesk" => "FrontDesk",
            "Housekeeping" => "Housekeeping",
            "Accountant" => "Accountant",
            "Manager" => "Manager",
            _ => "Admin"
        };
    }

    private void SetPerspective(string perspective)
    {
        activePerspective = perspective;
    }

    private int selectedBranchId = 0; // 0 = Toàn chuỗi, 1 = Đà Nẵng, 2 = Phú Quốc, 3 = Đà Lạt

    private async Task SetBranch(int branchId)
    {
        selectedBranchId = branchId;
        await LoadStatsAsync();
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            InitPerspective();
            await LoadStatsAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
    }

    private string GetPageTitle() => activePerspective switch
    {
        "FrontDesk" => "Tổng Quan Ca Trực Tiền Sảnh",
        "Housekeeping" => "Tổng Quan Buồng Phòng & Vận Hành",
        "Accountant" => "Tổng Quan Kế Toán & Thu Ngân",
        "Manager" => "Trung Tâm Giám Đốc & Phân Tích BI",
        _ => "Trung Tâm Điều Hành Ca Trực — Staff Hub"
    };

    private string GetHeaderTitle() => activePerspective switch
    {
        "FrontDesk" => "Tổng Quan Ca Trực Tiền Sảnh",
        "Housekeeping" => "Tổng Quan Buồng Phòng & Vận Hành",
        "Accountant" => "Tổng Quan Kế Toán & Dòng Tiền",
        "Manager" => "Trung Tâm Giám Đốc & Phân Tích BI",
        _ => "Tổng Quan Ca Trực Khách Sạn (Executive Hub)"
    };

    private string GetHeaderSubtitle() => activePerspective switch
    {
        "FrontDesk" => "Điều phối khách đến/đi, sơ đồ phòng sẵn sàng, đơn đặt cọc và thu tiền trong ca trực",
        "Housekeeping" => "Kiểm soát phòng bẩn cần dọn, ca trực vệ sinh, kiểm tra buồng và xử lý sự cố tài sản",
        "Accountant" => "Giám sát doanh thu hôm nay, hóa đơn công nợ, chi phí vận hành và đối soát thanh toán",
        "Manager" => "Hiệu suất công suất phòng, doanh thu tháng, dự báo nhu cầu du lịch AI và cảnh báo rủi ro hủy phòng",
        _ => "Trung tâm điều phối thông minh kết nối 4 phân hệ nghiệp vụ dành cho Ban Quản Lý & Nhân Viên"
    };

    private string GetHeaderIcon() => activePerspective switch
    {
        "FrontDesk" => "bi bi-bell-fill",
        "Housekeeping" => "bi bi-brush-fill",
        "Accountant" => "bi bi-cash-coin",
        "Manager" => "bi bi-graph-up-arrow",
        _ => "bi bi-grid-1x2-fill"
    };

    private async Task QuickUpdateCleaningStatusAsync(int roomId, string newStatus)
    {
        try
        {
            var room = await Db.Phongs.FirstOrDefaultAsync(p => p.MaId == roomId);
            if (room != null)
            {
                room.TrangThaiVeSinh = newStatus;
                await Db.SaveChangesAsync();

                await AuditService.GhiNhanAsync(
                    "CAP_NHAT_BUONG_PHONG",
                    "Phong",
                    room.MaId.ToString(),
                    $"Cập nhật trạng thái vệ sinh phòng {room.SoPhong} sang {newStatus}",
                    Session.CurrentUser.Id,
                    Session.CurrentUser.Email,
                    "127.0.0.1",
                    true);

                actionSuccessMessage = $"Đã cập nhật trạng thái phòng {room.SoPhong} sang {newStatus} thành công!";
                await LoadStatsAsync();
            }
        }
        catch (Exception ex)
        {
            actionSuccessMessage = $"Không thể cập nhật: {ex.Message}";
        }
    }

    private async Task LoadStatsAsync()
    {
        try
        {
            var today = DateTime.Today;
            var tomorrow = today.AddDays(1);

            var effectiveBranchId = (Session.CurrentUser.Role is "Admin" or "Manager")
                ? selectedBranchId
                : (Session.CurrentUser.MaChiNhanh > 0 ? Session.CurrentUser.MaChiNhanh : 1);

            // 1. Dữ liệu phòng
            var roomsQuery = Db.Phongs.AsNoTracking()
                .Include(p => p.MaLoaiPhongNavigation)
                .AsQueryable();

            if (effectiveBranchId > 0)
            {
                roomsQuery = roomsQuery.Where(p => p.MaChiNhanh == effectiveBranchId);
            }

            rooms = await roomsQuery.ToListAsync();

            if (rooms.Any())
            {
                occupiedCount = rooms.Count(r => StatusMapper.IsRoomOccupied(r.TrangThai));
                cleanAvailableCount = rooms.Count(r => (r.TrangThai == "Available" || r.TrangThai == "trong") && StatusMapper.NormalizePhongVeSinh(r.TrangThaiVeSinh) == "Clean");
                cleaningCount = rooms.Count(r => StatusMapper.NormalizePhongVeSinh(r.TrangThaiVeSinh) == "Dirty");
                inspectingCount = rooms.Count(r => StatusMapper.NormalizePhongVeSinh(r.TrangThaiVeSinh) == "Inspecting");
                cleanCount = rooms.Count(r => StatusMapper.NormalizePhongVeSinh(r.TrangThaiVeSinh) == "Clean");
                maintenanceCount = rooms.Count(r => r.TrangThai == "Maintenance" || r.TrangThai == "bao_tri");
                occupancyRate = rooms.Count > 0 ? (occupiedCount * 100 / rooms.Count) : 0;
            }
            else
            {
                occupiedCount = 0;
                cleanAvailableCount = 0;
                cleaningCount = 0;
                inspectingCount = 0;
                cleanCount = 0;
                maintenanceCount = 0;
                occupancyRate = 0;
            }

            // 2. Dữ liệu Tiền sảnh: Khách đến và đi
            var detailsQuery = Db.ChiTietDatPhongs.AsNoTracking()
                .Include(ct => ct.MaDatPhongNavigation)
                .Include(ct => ct.MaLoaiPhongNavigation)
                .Include(ct => ct.MaPhongNavigation)
                .Where(ct => ct.TrangThai != "Cancelled" && ct.TrangThai != "cancelled");

            if (effectiveBranchId > 0)
            {
                detailsQuery = detailsQuery.Where(ct => ct.MaDatPhongNavigation.MaChiNhanh == effectiveBranchId);
            }

            var allActiveDetails = await detailsQuery.ToListAsync();

            var todayBookings = allActiveDetails
                .Where(ct => (ct.NgayNhanPhongDuKien >= today && ct.NgayNhanPhongDuKien < tomorrow)
                          || (ct.NgayTraPhongDuKien >= today && ct.NgayTraPhongDuKien < tomorrow))
                .ToList();

            if (!todayBookings.Any())
            {
                todayBookings = allActiveDetails.OrderByDescending(ct => ct.NgayNhanPhongDuKien).Take(6).ToList();
            }

            frontDeskBookings = todayBookings.Select(ct => new FrontDeskBookingItem
            {
                Id = ct.MaDatPhong,
                BookingCode = ct.MaDatPhongNavigation?.MaDatPhong ?? $"#DP-{ct.MaDatPhong}",
                GuestName = ct.MaDatPhongNavigation?.TenKhach ?? "Khách vãng lai",
                GuestPhone = ct.MaDatPhongNavigation?.Sdtkhach ?? "",
                RoomName = ct.MaLoaiPhongNavigation?.Ten ?? "Phòng Tiêu Chuẩn",
                RoomNumber = ct.MaPhongNavigation?.SoPhong,
                CheckinDate = ct.NgayNhanPhongDuKien,
                CheckoutDate = ct.NgayTraPhongDuKien,
                Total = ct.MaDatPhongNavigation?.TongTien ?? 0,
                Deposit = ct.MaDatPhongNavigation?.TienDatCoc ?? 0,
                Status = ct.TrangThai,
                Direction = (ct.NgayNhanPhongDuKien >= today && ct.NgayNhanPhongDuKien < tomorrow) ? "CheckIn" : "CheckOut"
            }).ToList();

            // 3. Dữ liệu Buồng phòng
            var incidentsQuery = Db.MatMatHuHongs.AsNoTracking().AsQueryable();
            if (effectiveBranchId > 0)
            {
                incidentsQuery = incidentsQuery.Where(m => m.MaChiTietDatPhongNavigation != null && m.MaChiTietDatPhongNavigation.MaPhongNavigation != null && m.MaChiTietDatPhongNavigation.MaPhongNavigation.MaChiNhanh == effectiveBranchId);
            }
            openIncidentsCount = await incidentsQuery.CountAsync();
            housekeepingRooms = rooms
                .OrderBy(r => r.Tang)
                .ThenBy(r => r.SoPhong)
                .Select(r => new HousekeepingRoomItem
                {
                    Id = r.MaId,
                    RoomNumber = r.SoPhong,
                    Floor = r.Tang ?? 1,
                    RoomType = r.MaLoaiPhongNavigation?.Ten ?? "Phòng Tiêu Chuẩn",
                    OccupancyStatus = StatusMapper.IsRoomOccupied(r.TrangThai) ? "Đang ở" : "Trống",
                    CleanlinessStatus = StatusMapper.NormalizePhongVeSinh(r.TrangThaiVeSinh)
                }).ToList();

            // 4. Dữ liệu Kế toán: Doanh thu & Hóa đơn & Chi phí
            var paymentsQuery = Db.ThanhToans.AsNoTracking()
                .Include(t => t.MaHoaDonNavigation)
                    .ThenInclude(h => h.MaDatPhongNavigation)
                .Where(t => t.TrangThai == "Success" || t.TrangThai == "success");

            if (effectiveBranchId > 0)
            {
                paymentsQuery = paymentsQuery.Where(t => t.MaHoaDonNavigation != null && t.MaHoaDonNavigation.MaDatPhongNavigation.MaChiNhanh == effectiveBranchId);
            }

            var allPayments = await paymentsQuery.ToListAsync();

            todayRevenue = allPayments
                .Where(t => t.NgayThanhToan.Date == today)
                .Sum(t => t.SoTienDaThanhToan);

            todayTransactionsCount = allPayments.Count(t => t.NgayThanhToan.Date == today);

            vnpayRevenue = allPayments
                .Where(t => t.NgayThanhToan.Date == today && (t.PhuongThucThanhToan.Contains("VNPay") || t.PhuongThucThanhToan.Contains("VietQR")))
                .Sum(t => t.SoTienDaThanhToan);

            cashRevenue = allPayments
                .Where(t => t.NgayThanhToan.Date == today && t.PhuongThucThanhToan.Contains("Cash"))
                .Sum(t => t.SoTienDaThanhToan);

            bankRevenue = allPayments
                .Where(t => t.NgayThanhToan.Date == today && t.PhuongThucThanhToan.Contains("Bank"))
                .Sum(t => t.SoTienDaThanhToan);

            momoRevenue = allPayments
                .Where(t => t.NgayThanhToan.Date == today && t.PhuongThucThanhToan.Contains("MoMo"))
                .Sum(t => t.SoTienDaThanhToan);

            monthlyRevenue = allPayments
                .Where(t => t.NgayThanhToan.Month == today.Month && t.NgayThanhToan.Year == today.Year)
                .Sum(t => t.SoTienDaThanhToan);

            var invoicesQuery = Db.HoaDons.AsNoTracking()
                .Include(h => h.MaDatPhongNavigation)
                .AsQueryable();

            if (effectiveBranchId > 0)
            {
                invoicesQuery = invoicesQuery.Where(h => h.MaDatPhongNavigation.MaChiNhanh == effectiveBranchId);
            }

            pendingInvoicesCount = await invoicesQuery.CountAsync(h => h.TrangThai == "Pending" || h.TrangThai == "pending");
            pendingInvoicesTotal = await invoicesQuery.Where(h => h.TrangThai == "Pending" || h.TrangThai == "pending").SumAsync(h => h.TongThanhToan);

            var invoices = await invoicesQuery
                .OrderByDescending(h => h.NgayTao)
                .Take(10)
                .ToListAsync();

            recentInvoices = invoices.Select(h => new InvoiceSummaryItem
            {
                Id = h.MaId,
                BookingCode = h.MaDatPhongNavigation?.MaDatPhong ?? $"#DP-{h.MaDatPhong}",
                GuestName = h.MaDatPhongNavigation?.TenKhach ?? "Khách vãng lai",
                RoomTotal = h.TongTienPhong,
                ServiceTotal = h.TongTienDichVu,
                GrandTotal = h.TongThanhToan,
                Status = h.TrangThai,
                CreatedAt = h.NgayTao
            }).ToList();

            var currentMonth = today.Month;
            var currentYear = today.Year;

            var expensesQuery = Db.ChiPhiVanHanhs.AsNoTracking().AsQueryable();
            if (effectiveBranchId > 0)
            {
                expensesQuery = expensesQuery.Where(c => c.MaChiNhanh == effectiveBranchId);
            }

            var expensesList = await expensesQuery
                .OrderByDescending(c => c.NgayChi)
                .Take(10)
                .ToListAsync();

            monthlyExpenses = await expensesQuery
                .Where(c => c.NgayChi.Month == currentMonth && c.NgayChi.Year == currentYear)
                .SumAsync(c => c.SoTien);

            recentExpenses = expensesList.Select(c => new ExpenseSummaryItem
            {
                Id = c.MaId,
                Category = c.DanhMuc,
                Description = c.MoTa,
                Amount = c.SoTien,
                Date = c.NgayChi,
                Status = c.TrangThai
            }).ToList();

            // 5. Dữ liệu Giám đốc: AI Churn Risk
            var churnQuery = Db.DuDoanHuyPhongAis.AsNoTracking()
                .Include(d => d.MaDatPhongNavigation)
                    .ThenInclude(b => b.ChiTietDatPhongs)
                .AsQueryable();

            if (effectiveBranchId > 0)
            {
                churnQuery = churnQuery.Where(d => d.MaDatPhongNavigation.MaChiNhanh == effectiveBranchId);
            }

            var churnList = await churnQuery
                .OrderByDescending(d => d.XacSuatHuyPhong)
                .Take(5)
                .ToListAsync();

            highRiskBookings = churnList.Select(d => new ChurnRiskItem
            {
                BookingId = d.MaDatPhong,
                BookingCode = d.MaDatPhongNavigation?.MaDatPhong ?? $"#DP-{d.MaDatPhong}",
                GuestName = d.MaDatPhongNavigation?.TenKhach ?? "Khách vãng lai",
                Total = d.MaDatPhongNavigation?.TongTien ?? 0,
                RiskProbability = d.XacSuatHuyPhong,
                RiskLevel = d.MucDoRuiRo,
                MainFactor = d.YeuToChinh ?? "Thời gian đặt phòng xa",
                CheckinDate = d.MaDatPhongNavigation?.ChiTietDatPhongs.FirstOrDefault()?.NgayNhanPhongDuKien ?? today
            }).ToList();

            // 6. Dữ liệu Admin: Audit Logs & Tổng tài khoản
            var auditList = await Db.NhatKyHeThongs.AsNoTracking()
                .OrderByDescending(a => a.ThoiGian)
                .Take(6)
                .ToListAsync();

            recentAuditLogs = auditList.Select(a => new AuditLogItem
            {
                Time = a.ThoiGian,
                Email = a.Email ?? "Hệ thống",
                Action = a.HanhDong,
                ObjectName = a.DoiTuong,
                Detail = a.NoiDung
            }).ToList();

            totalActiveStaffAccounts = await Db.NguoiDungs.CountAsync(u => u.TrangThai);
        }
        catch { }
    }
}