@page "/frontdesk/checkin-out"
@inject DACNContext Db

<PageTitle>Check-in / Check-out — TV3</PageTitle>

<PageHeader Title="Quy Trình Tiếp Đón Lưu Trú: Check-in / Check-out"
            Subtitle="Xác nhận nhận phòng, trả phòng, đổi phòng, gia hạn lưu trú và kích hoạt quy trình dọn dẹp"
            Icon="bi bi-box-arrow-in-right"
            MemberTag="TV3 — CHECK-IN & CHECK-OUT"
            MemberTagClass="member-tag-tv3">
    <Actions>
        <button class="hotel-btn hotel-btn-outline" @onclick="LoadDataAsync">
            <i class="bi bi-arrow-clockwise"></i> Làm mới
        </button>
        <button class="hotel-btn hotel-btn-primary" @onclick='() => mode = "checkin"'>
            <i class="bi bi-person-check-fill me-1"></i> Khách Đến Check-in
        </button>
        <button class="hotel-btn hotel-btn-accent" @onclick='() => mode = "checkout"'>
            <i class="bi bi-box-arrow-right me-1"></i> Khách Trả Check-out
        </button>
    </Actions>
</PageHeader>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <StatCard Title="Dự Kiến Check-in Hôm Nay" Value="@checkinTodayCount.ToString()" Description="Khách đã đặt trước" Icon="bi bi-box-arrow-in-right" Variant="primary" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Dự Kiến Check-out" Value="@checkoutTodayCount.ToString()" Description="Cần chuẩn bị hóa đơn" Icon="bi bi-box-arrow-left" Variant="warning" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Đã Check-in Thành Công" Value="8" Description="Khách đang ở trong phòng" Icon="bi bi-door-open-fill" Variant="success" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Yêu Cầu Gia Hạn / Đổi Phòng" Value="1" Description="Cần điều phối buồng phòng" Icon="bi bi-arrow-repeat" Variant="accent" />
    </div>
</div>

<!-- Tabs Lọc Chế Độ -->
<div class="hotel-card mb-4 p-2">
    <ul class="nav nav-pills gap-2">
        <li class="nav-item">
            <button class="nav-link @(mode == "checkin" ? "active" : "")" style="@(mode == "checkin" ? "background: var(--hotel-primary); color: white;" : "color: var(--hotel-text);")" @onclick='() => mode = "checkin"'>
                <i class="bi bi-box-arrow-in-right me-1"></i> Danh Sách Chờ Check-in
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(mode == "checkout" ? "active" : "")" style="@(mode == "checkout" ? "background: var(--hotel-primary); color: white;" : "color: var(--hotel-text);")" @onclick='() => mode = "checkout"'>
                <i class="bi bi-box-arrow-left me-1"></i> Danh Sách Chờ Check-out
            </button>
        </li>
    </ul>
</div>

<!-- Bảng hiển thị danh sách khách -->
<div class="hotel-card">
    <div class="hotel-card-header">
        <div class="hotel-card-title">
            <i class="bi bi-list-stars text-primary"></i>
            <span>@(mode == "checkin" ? "Khách Hàng Tiếp Nhận Check-in" : "Khách Hàng Chuẩn Bị Trả Phòng & Check-out")</span>
        </div>
        <input type="text" class="hotel-input" placeholder="Tìm theo tên khách, mã đơn..." @bind="searchQuery" @bind:event="oninput" style="width: 250px;" />
    </div>
    <div class="hotel-card-body p-0">
        <div class="table-responsive">
            <table class="hotel-table">
                <thead>
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Loại Phòng / Số Phòng</th>
                        <th>Thời Gian Nhận - Trả</th>
                        <th>Tiền Đặt Cọc</th>
                        <th>Trạng Thái</th>
                        <th class="text-end">Xử Lý Ca</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in DisplayBookings)
                    {
                        <tr>
                            <td><code>#DP-@b.MaId.ToString("D4")</code></td>
                            <td>
                                <div class="fw-bold">@(b.TenKhach ?? b.MaNguoiDungNavigation?.HoTen ?? "Khách lẻ")</div>
                                <div class="small text-muted">@(b.Sdtkhach ?? b.MaNguoiDungNavigation?.SoDienThoai ?? "---")</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(b.ChiTietDatPhongs.FirstOrDefault()?.MaPhong.HasValue == true ? $"Phòng {b.ChiTietDatPhongs.First().MaPhong}" : "Chưa xếp phòng")
                                </span>
                            </td>
                            <td>
                                <small class="text-muted">
                                    @(b.ChiTietDatPhongs.FirstOrDefault()?.NgayNhanPhongDuKien.ToString("dd/MM/yyyy") ?? b.NgayTao.ToString("dd/MM/yyyy")) 
                                    → 
                                    @(b.ChiTietDatPhongs.FirstOrDefault()?.NgayTraPhongDuKien.ToString("dd/MM/yyyy") ?? b.NgayTao.AddDays(1).ToString("dd/MM/yyyy"))
                                </small>
                            </td>
                            <td class="fw-bold text-success">@b.TienDatCoc.ToString("N0") đ</td>
                            <td><StatusBadge Status="@b.TrangThai" /></td>
                            <td class="text-end">
                                @if (mode == "checkin")
                                {
                                    <button class="hotel-btn hotel-btn-primary py-1 px-3" style="font-size: 0.8rem;" @onclick="() => XacNhanCheckIn(b.MaId)">
                                        <i class="bi bi-key-fill me-1"></i> Nhận Phòng (Check-in)
                                    </button>
                                }
                                else
                                {
                                    <a href="/frontdesk/services-billing" class="hotel-btn hotel-btn-accent py-1 px-3" style="font-size: 0.8rem;">
                                        <i class="bi bi-receipt me-1"></i> Thanh Toán & Trả Phòng
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string mode = "checkin";
    private string searchQuery = "";
    private List<DatPhong> allBookings = new();

    private int checkinTodayCount => allBookings.Count(b => b.TrangThai == "Confirmed" || b.TrangThai == "Pending" || b.TrangThai == "da_xac_nhan" || b.TrangThai == "cho_xac_nhan");
    private int checkoutTodayCount => allBookings.Count(b => b.TrangThai == "CheckedIn" || b.TrangThai == "da_nhan_phong" || b.TrangThai == "dang_o");

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            allBookings = await Db.DatPhongs
                .AsNoTracking()
                .Include(b => b.MaNguoiDungNavigation)
                .Include(b => b.ChiTietDatPhongs)
                .OrderByDescending(b => b.NgayTao)
                .Take(25)
                .ToListAsync();
        }
        catch { }
    }

    private IEnumerable<DatPhong> DisplayBookings => allBookings
        .Where(b => mode == "checkin"
            ? (b.TrangThai == "Confirmed" || b.TrangThai == "Pending" || b.TrangThai == "da_xac_nhan" || b.TrangThai == "cho_xac_nhan" || b.TrangThai == "moi_tao")
            : (b.TrangThai == "CheckedIn" || b.TrangThai == "CheckedOut" || b.TrangThai == "da_nhan_phong" || b.TrangThai == "dang_o" || b.TrangThai == "da_tra_phong"))
        .Where(b => string.IsNullOrWhiteSpace(searchQuery)
                 || (b.TenKhach != null && b.TenKhach.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
                 || (b.MaNguoiDungNavigation != null && b.MaNguoiDungNavigation.HoTen.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));

    private async Task XacNhanCheckIn(int bookingId)
    {
        var b = await Db.DatPhongs.Include(x => x.ChiTietDatPhongs).FirstOrDefaultAsync(x => x.MaId == bookingId);
        if (b != null)
        {
            b.TrangThai = "CheckedIn";
            b.NgayCapNhat = DateTime.UtcNow;
            foreach (var ct in b.ChiTietDatPhongs)
            {
                ct.TrangThai = "Active";
                ct.ThoiGianNhanPhongThucTe = DateTime.UtcNow;
            }
            await Db.SaveChangesAsync();
            await LoadDataAsync();
        }
    }
}
