@page "/frontdesk/bookings"
@inject DACNContext Db

<PageTitle>Sơ Đồ Phòng & Đặt Phòng — TV3</PageTitle>

<PageHeader Title="Phân Hệ Tiền Sảnh: Sơ Đồ Phòng & Đặt Phòng"
            Subtitle="Sơ đồ buồng phòng trực quan (Room Rack) và tiếp nhận tạo mới, tra cứu đơn đặt phòng"
            Icon="bi bi-calendar-check-fill"
            MemberTag="TV3 — TIỀN SẢNH & ĐẶT PHÒNG"
            MemberTagClass="member-tag-tv3">
    <Actions>
        <button class="hotel-btn hotel-btn-outline" @onclick="LoadDataAsync">
            <i class="bi bi-arrow-clockwise"></i> Tải lại
        </button>
        <button class="hotel-btn hotel-btn-primary">
            <i class="bi bi-plus-circle"></i> Đặt Phòng Trực Tiếp
        </button>
    </Actions>
</PageHeader>

<!-- Thanh thống kê nhanh tiền sảnh -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <StatCard Title="Phòng Sẵn Sàng" Value="@roomsReady.ToString()" Description="Phòng trống đã dọn sạch" Icon="bi bi-check-circle-fill" Variant="success" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Khách Đang Ở" Value="@roomsOccupied.ToString()" Description="Phòng đang lưu trú" Icon="bi bi-person-fill" Variant="info" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Chờ Vệ Sinh" Value="@roomsCleaning.ToString()" Description="Khách vừa trả phòng" Icon="bi bi-brush-fill" Variant="warning" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Tổng Đơn Đặt" Value="@bookings.Count.ToString()" Description="Trong ca trực hiện tại" Icon="bi bi-journal-bookmark-fill" Variant="accent" />
    </div>
</div>

<!-- Sơ đồ phòng trực quan (Room Rack) -->
<div class="hotel-card mb-4">
    <div class="hotel-card-header">
        <div class="hotel-card-title">
            <i class="bi bi-grid-3x3-gap-fill text-primary"></i>
            <span>Sơ Đồ Buồng Phòng Khách Sạn (Room Rack)</span>
        </div>
        <div class="d-flex align-items-center gap-3" style="font-size: 0.8rem;">
            <span><span class="room-status-indicator trong me-1"></span> Trống (@roomsReady)</span>
            <span><span class="room-status-indicator dang_o me-1"></span> Đang ở (@roomsOccupied)</span>
            <span><span class="room-status-indicator don_dep me-1"></span> Chờ dọn (@roomsCleaning)</span>
            <span><span class="room-status-indicator sua_chua me-1"></span> Bảo trì (@roomsMaintenance)</span>
        </div>
    </div>
    <div class="hotel-card-body">
        @if (isLoading)
        {
            <div class="text-center py-4 text-muted">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2">Đang tải sơ đồ phòng...</div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var room in rooms)
                {
                    <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                        <div class="room-box">
                            <div class="room-box-header">
                                <span class="room-box-number">P.@room.SoPhong</span>
                                <span class="room-status-indicator @room.TrangThai"></span>
                            </div>
                            <div class="room-box-type text-truncate">@room.MaLoaiPhongNavigation?.Ten</div>
                            <div class="mt-2 d-flex justify-content-between align-items-center">
                                <StatusBadge Status="@room.TrangThai" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Danh sách đơn đặt phòng gần đây -->
<div class="hotel-card">
    <div class="hotel-card-header">
        <div class="hotel-card-title">
            <i class="bi bi-card-checklist text-primary"></i>
            <span>Danh Sách Đơn Đặt Phòng Gần Đây</span>
        </div>
        <input type="text" placeholder="Tìm theo tên khách, mã đơn..." class="hotel-input" @bind="searchBooking" @bind:event="oninput" style="width: 240px; font-size: 0.85rem;" />
    </div>
    <div class="hotel-table-container">
        <table class="hotel-table">
            <thead>
                <tr>
                    <th>Mã Đơn</th>
                    <th>Khách Hàng</th>
                    <th>Thời Gian Lưu Trú</th>
                    <th>Trạng Thái</th>
                    <th>Tổng Tiền</th>
                    <th class="text-end">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredBookings.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            Chưa có đơn đặt phòng nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var b in FilteredBookings)
                    {
                        <tr>
                            <td>
                                <strong>#DP-@b.MaId.ToString("D4")</strong>
                                <div style="font-size: 0.75rem; color: var(--hotel-text-muted);">@b.NgayTao.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td>
                                <div class="fw-bold">@(b.TenKhach ?? b.MaNguoiDungNavigation?.HoTen ?? "Khách vãng lai")</div>
                                <div style="font-size: 0.8rem; color: var(--hotel-text-secondary);">@(b.Sdtkhach ?? b.MaNguoiDungNavigation?.SoDienThoai ?? "---")</div>
                            </td>
                            <td>
                                <div><i class="bi bi-box-arrow-in-right text-success"></i> @(b.ChiTietDatPhongs.FirstOrDefault()?.NgayNhanPhongDuKien.ToString("dd/MM/yyyy") ?? b.NgayTao.ToString("dd/MM/yyyy"))</div>
                                <div><i class="bi bi-box-arrow-left text-danger"></i> @(b.ChiTietDatPhongs.FirstOrDefault()?.NgayTraPhongDuKien.ToString("dd/MM/yyyy") ?? b.NgayTao.AddDays(1).ToString("dd/MM/yyyy"))</div>
                            </td>
                            <td>
                                <StatusBadge Status="@b.TrangThai" />
                            </td>
                            <td class="fw-bold text-primary">
                                @b.TongTien.ToString("N0") đ
                            </td>
                            <td class="text-end">
                                <a href="/frontdesk/checkin-out" class="hotel-btn hotel-btn-outline py-1 px-2 text-primary" title="Xử lý Check-in / out">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                </a>
                                <a href="/frontdesk/services-billing" class="hotel-btn hotel-btn-primary py-1 px-2 ms-1" title="Lập hóa đơn">
                                    <i class="bi bi-receipt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private bool isLoading = true;
    private string searchBooking = "";
    private List<Phong> rooms = new();
    private List<DatPhong> bookings = new();

    private int roomsReady => rooms.Count(r => (r.TrangThai == "Available" || r.TrangThai == "trong") && r.TrangThaiVeSinh != "Dirty");
    private int roomsOccupied => rooms.Count(r => r.TrangThai == "Occupied" || r.TrangThai == "Reserved" || r.TrangThai == "dang_o");
    private int roomsCleaning => rooms.Count(r => r.TrangThaiVeSinh == "Dirty" || r.TrangThai == "don_dep" || r.TrangThai == "chua_don");
    private int roomsMaintenance => rooms.Count(r => r.TrangThai == "Maintenance" || r.TrangThai == "sua_chua");

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            rooms = await Db.Phongs
                .AsNoTracking()
                .Include(p => p.MaLoaiPhongNavigation)
                .OrderBy(p => p.SoPhong)
                .ToListAsync();

            bookings = await Db.DatPhongs
                .AsNoTracking()
                .Include(b => b.MaNguoiDungNavigation)
                .Include(b => b.ChiTietDatPhongs)
                .OrderByDescending(b => b.NgayTao)
                .Take(15)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi nạp dữ liệu: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<DatPhong> FilteredBookings => bookings
        .Where(b => string.IsNullOrWhiteSpace(searchBooking)
                 || (b.TenKhach != null && b.TenKhach.Contains(searchBooking, StringComparison.OrdinalIgnoreCase))
                 || (b.MaNguoiDungNavigation != null && b.MaNguoiDungNavigation.HoTen.Contains(searchBooking, StringComparison.OrdinalIgnoreCase))
                 || b.MaId.ToString().Contains(searchBooking));
}
