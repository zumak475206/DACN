@page "/frontdesk/services-billing"
@inject DACNContext Db
@inject UserSessionService Session
@inject IAuditService AuditService

<PageTitle>Dịch Vụ & Hóa Đơn — TV3</PageTitle>

<PageHeader Title="Quản Lý Dịch Vụ, Lập Hóa Đơn & Thu Ngân"
            Subtitle="Ghi dịch vụ buồng phòng (minibar, ăn uống, spa), áp dụng voucher và thanh toán qua VNPay/MoMo/Tiền mặt"
            Icon="bi bi-receipt-cutoff"
            MemberTag="TV3 — DỊCH VỤ & HÓA ĐƠN"
            MemberTagClass="member-tag-tv3">
    <Actions>
        <button class="hotel-btn hotel-btn-outline" @onclick="LoadDataAsync">
            <i class="bi bi-arrow-clockwise"></i> Làm mới
        </button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(paymentMessage))
{
    <div class="alert alert-info alert-dismissible fade show py-2 small mb-3" role="alert">
        <i class="bi bi-info-circle-fill me-1"></i> @paymentMessage
        <button type="button" class="btn-close py-2" @onclick="() => paymentMessage = null"></button>
    </div>
}

@if (Session.CurrentUser.Role is "Admin" or "Manager")
{
    <div class="d-flex align-items-center gap-2 mb-3 p-2 bg-white rounded-3 shadow-sm border flex-wrap">
        <span class="small fw-bold text-dark"><i class="bi bi-buildings-fill text-primary me-1"></i> Chi nhánh:</span>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn @(selectedBranchId == 0 ? "btn-dark fw-bold" : "btn-outline-secondary")" @onclick="() => FilterBranchAsync(0)">🏨 Toàn Chuỗi</button>
            <button type="button" class="btn @(selectedBranchId == 1 ? "btn-primary fw-bold" : "btn-outline-primary")" @onclick="() => FilterBranchAsync(1)">🌊 Đà Nẵng</button>
            <button type="button" class="btn @(selectedBranchId == 2 ? "btn-info text-white fw-bold" : "btn-outline-info")" @onclick="() => FilterBranchAsync(2)">🌴 Phú Quốc</button>
            <button type="button" class="btn @(selectedBranchId == 3 ? "btn-success fw-bold" : "btn-outline-success")" @onclick="() => FilterBranchAsync(3)">🌲 Đà Lạt</button>
        </div>
    </div>
}
else
{
    <div class="mb-3 px-3 py-2 bg-white border-start border-4 border-warning rounded shadow-sm d-flex align-items-center justify-content-between">
        <span class="small text-muted"><i class="bi bi-geo-alt-fill text-warning me-1"></i> Quản lý hóa đơn tại: <strong class="text-dark">@Session.CurrentUser.TenChiNhanh</strong></span>
        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 small">FrontDesk Isolation</span>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <StatCard Title="Hóa Đơn Đã Thu" Value="@($"{totalCollectedAmount:N0} đ")" Description="Tổng thu từ các ca đã thanh toán" Icon="bi bi-cash-stack" Variant="success" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Chờ Khách Thanh Toán" Value="@invoicesPendingCount.ToString()" Description="Hóa đơn chưa tất toán" Icon="bi bi-clock-history" Variant="warning" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Phòng Đang Lưu Trú" Value="@($"{activeRooms.Count} phòng")" Description="Có thể gọi dịch vụ" Icon="bi bi-door-open-fill" Variant="info" />
    </div>
    <div class="col-6 col-md-3">
        <StatCard Title="Danh Mục Dịch Vụ" Value="@($"{availableServices.Count} món")" Description="Minibar, F&B, Spa sẵn sàng" Icon="bi bi-cup-hot-fill" Variant="primary" />
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Danh sách hóa đơn -->
    <div class="col-12 col-lg-8">
        <div class="hotel-card">
            <div class="hotel-card-header">
                <div class="hotel-card-title">
                    <i class="bi bi-receipt text-primary"></i>
                    <span>Danh Sách Hóa Đơn Phòng</span>
                </div>
                <input type="text" class="hotel-input" placeholder="Tìm theo mã đơn, mã hóa đơn..." @bind="searchInvoice" @bind:event="oninput" style="width: 220px;" />
            </div>
            <div class="hotel-card-body p-0">
                <div class="table-responsive">
                    <table class="hotel-table">
                        <thead>
                            <tr>
                                <th>Mã Hóa Đơn</th>
                                <th>Đơn Đặt Phòng</th>
                                <th>Tiền Phòng</th>
                                <th>Tiền Dịch Vụ</th>
                                <th>Tổng Thanh Toán</th>
                                <th>Trạng Thái</th>
                                <th class="text-end">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredInvoices.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">Chưa có hóa đơn nào phù hợp.</td>
                                </tr>
                            }
                            @foreach (var inv in FilteredInvoices)
                            {
                                <tr>
                                    <td><strong>#HD-@inv.MaId.ToString("D4")</strong></td>
                                    <td>
                                        <code>#DP-@inv.MaDatPhong.ToString("D4")</code>
                                        @if (inv.MaDatPhongNavigation?.MaChiNhanhNavigation != null)
                                        {
                                            <span class="badge bg-light text-primary border small ms-1">@inv.MaDatPhongNavigation.MaChiNhanhNavigation.TenChiNhanh</span>
                                        }
                                    </td>
                                    <td>@inv.TongTienPhong.ToString("N0") đ</td>
                                    <td>@inv.TongTienDichVu.ToString("N0") đ</td>
                                    <td class="fw-bold text-primary">@inv.TongThanhToan.ToString("N0") đ</td>
                                    <td><StatusBadge Status="@inv.TrangThai" /></td>
                                    <td class="text-end">
                                        @if (!IsInvoicePaid(inv.TrangThai))
                                        {
                                            <button class="hotel-btn hotel-btn-accent py-1 px-2 ms-1" title="Thu tiền" @onclick="() => ThuTien(inv.MaId)">
                                                <i class="bi bi-check-circle"></i> Thu Tiền
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle small">Đã tất toán</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel Gọi Dịch Vụ Nhanh Vào Phòng -->
    <div class="col-12 col-lg-4">
        <div class="hotel-card h-100">
            <div class="hotel-card-header">
                <div class="hotel-card-title">
                    <i class="bi bi-bell-fill text-warning"></i>
                    <span>Gọi Dịch Vụ Theo Phòng</span>
                </div>
            </div>
            <div class="hotel-card-body">
                @if (activeRooms.Count == 0)
                {
                    <div class="alert alert-warning small py-2">
                        Hiện chưa có phòng nào đang lưu trú (CheckedIn) tại chi nhánh này để gọi dịch vụ.
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Chọn Phòng Đang Lưu Trú:</label>
                        <select class="hotel-select w-100" @bind="selectedDetailId">
                            <option value="0">-- Chọn phòng lưu trú --</option>
                            @foreach (var room in activeRooms)
                            {
                                <option value="@room.MaId">
                                    Phòng @(room.MaPhongNavigation?.SoPhong ?? "N/A") — @(room.MaDatPhongNavigation?.TenKhach ?? "Khách lẻ")
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Dịch Vụ Yêu Cầu:</label>
                        <select class="hotel-select w-100" @bind="selectedServiceId">
                            <option value="0">-- Chọn loại dịch vụ --</option>
                            @foreach (var s in availableServices)
                            {
                                <option value="@s.MaId">
                                    @s.Ten (@s.GiaDichVu.ToString("N0") đ / @s.DonViTinh)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Số Lượng:</label>
                        <input type="number" class="hotel-input w-100" @bind="serviceQuantity" min="1" max="50" />
                    </div>

                    <button class="hotel-btn hotel-btn-accent w-100 mt-2" disabled="@isAddingService" @onclick="ThemDichVuVaoPhongAsync">
                        @if (isAddingService)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        <i class="bi bi-plus-lg me-1"></i> Thêm Vào Hóa Đơn Phòng
                    </button>
                }
            </div>
        </div>
    </div>
</div>


@code {
    private string searchInvoice = "";
    private string? paymentMessage;
    private bool isAddingService = false;
    private int selectedBranchId = 0;
    private int selectedDetailId = 0;
    private int selectedServiceId = 0;
    private int serviceQuantity = 1;
    private decimal totalCollectedAmount = 0;

    private List<HoaDon> invoices = new();
    private List<ChiTietDatPhong> activeRooms = new();
    private List<DichVu> availableServices = new();

    private int invoicesPendingCount =>
        invoices.Count(i => !IsInvoicePaid(i.TrangThai));

    private static bool IsInvoicePaid(string? status) =>
        string.Equals(status, "Paid", StringComparison.OrdinalIgnoreCase)
        || string.Equals(status, "da_thanh_toan", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentUser.Role is not ("Admin" or "Manager"))
        {
            selectedBranchId = Session.CurrentUser.MaChiNhanh;
        }
        await LoadDataAsync();
    }

    private async Task FilterBranchAsync(int branchId)
    {
        selectedBranchId = branchId;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var effectiveBranchId = (Session.CurrentUser.Role is "Admin" or "Manager")
            ? selectedBranchId
            : Session.CurrentUser.MaChiNhanh;

        var query = Db.HoaDons
            .AsNoTracking()
            .Include(h => h.MaDatPhongNavigation).ThenInclude(dp => dp.MaChiNhanhNavigation)
            .Include(h => h.ThanhToans)
            .AsQueryable();

        if (effectiveBranchId > 0)
        {
            query = query.Where(h => h.MaDatPhongNavigation != null && h.MaDatPhongNavigation.MaChiNhanh == effectiveBranchId);
        }

        invoices = await query
            .OrderByDescending(h => h.NgayTao)
            .Take(100)
            .ToListAsync();

        totalCollectedAmount = await Db.ThanhToans
            .Where(t => t.TrangThai == "Success" && (effectiveBranchId <= 0 || t.MaHoaDonNavigation.MaDatPhongNavigation.MaChiNhanh == effectiveBranchId))
            .SumAsync(t => (decimal?)t.SoTienDaThanhToan) ?? 0m;

        var roomQuery = Db.ChiTietDatPhongs
            .AsNoTracking()
            .Include(ct => ct.MaPhongNavigation)
            .Include(ct => ct.MaDatPhongNavigation)
            .Where(ct => ct.TrangThai == "Active");

        if (effectiveBranchId > 0)
        {
            roomQuery = roomQuery.Where(ct => ct.MaPhongNavigation != null && ct.MaPhongNavigation.MaChiNhanh == effectiveBranchId);
        }

        activeRooms = await roomQuery.OrderBy(ct => ct.MaPhongNavigation != null ? ct.MaPhongNavigation.SoPhong : "").ToListAsync();

        var serviceQuery = Db.DichVus.AsNoTracking().Where(d => d.DangHoatDong);
        if (effectiveBranchId > 0)
        {
            serviceQuery = serviceQuery.Where(d => d.MaChiNhanh == null || d.MaChiNhanh == effectiveBranchId);
        }
        availableServices = await serviceQuery.OrderBy(d => d.Ten).ToListAsync();
    }

    private IEnumerable<HoaDon> FilteredInvoices =>
        invoices.Where(i =>
            string.IsNullOrWhiteSpace(searchInvoice)
            || i.MaId.ToString().Contains(searchInvoice)
            || i.MaDatPhong.ToString().Contains(searchInvoice));

    private async Task ThemDichVuVaoPhongAsync()
    {
        if (selectedDetailId <= 0 || selectedServiceId <= 0 || serviceQuantity <= 0)
        {
            paymentMessage = "Vui lòng chọn phòng lưu trú, dịch vụ và số lượng hợp lệ.";
            return;
        }

        isAddingService = true;
        paymentMessage = null;

        try
        {
            var detail = await Db.ChiTietDatPhongs.FirstOrDefaultAsync(ct => ct.MaId == selectedDetailId);
            var service = await Db.DichVus.FirstOrDefaultAsync(d => d.MaId == selectedServiceId);
            if (detail == null || service == null)
            {
                paymentMessage = "Dữ liệu phòng hoặc dịch vụ không tồn tại.";
                return;
            }

            var invoice = await Db.HoaDons.FirstOrDefaultAsync(h => h.MaDatPhong == detail.MaDatPhong);
            if (invoice == null)
            {
                paymentMessage = "Đơn đặt phòng chưa có hóa đơn.";
                return;
            }

            var itemTotal = service.GiaDichVu * serviceQuantity;

            var donDichVu = new DonDichVu
            {
                MaChiTietDatPhong = detail.MaId,
                NgayDatDichVu = DateTime.UtcNow,
                TongTien = itemTotal,
                TrangThai = "Completed"
            };

            Db.DonDichVus.Add(donDichVu);
            await Db.SaveChangesAsync();

            Db.ChiTietDonDichVus.Add(new ChiTietDonDichVu
            {
                MaDonDichVu = donDichVu.MaId,
                MaDichVu = service.MaId,
                SoLuong = serviceQuantity,
                DonGia = service.GiaDichVu
            });

            invoice.TongTienDichVu += itemTotal;
            invoice.TongThanhToan += itemTotal;

            await Db.SaveChangesAsync();

            await AuditService.GhiNhanAsync(
                "GOI_DICH_VU_PHONG",
                "DonDichVu",
                donDichVu.MaId.ToString(),
                $"Gọi {serviceQuantity}x {service.Ten} vào chi tiết phòng #{detail.MaId} — Thành tiền: {itemTotal:N0} đ",
                Session.CurrentUser.Id,
                Session.CurrentUser.Email,
                "127.0.0.1",
                true);

            paymentMessage = $"Đã thêm thành công {serviceQuantity}x {service.Ten} ({itemTotal:N0} đ) vào hóa đơn #HD-{invoice.MaId:D4}!";
            serviceQuantity = 1;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            paymentMessage = $"Không thể thêm dịch vụ: {ex.Message}";
        }
        finally
        {
            isAddingService = false;
        }
    }

    private async Task ThuTien(int invoiceId)
    {
        paymentMessage = "";

        await using var transaction = await Db.Database.BeginTransactionAsync();

        try
        {
            var invoice = await Db.HoaDons
                .FirstOrDefaultAsync(h => h.MaId == invoiceId);

            if (invoice == null)
            {
                paymentMessage = "Không tìm thấy hóa đơn.";
                return;
            }

            if (IsInvoicePaid(invoice.TrangThai))
            {
                paymentMessage = "Hóa đơn này đã được thanh toán.";
                return;
            }

            var totalPaid = await Db.ThanhToans
                .Where(t => t.MaHoaDon == invoiceId && t.TrangThai == "Success")
                .SumAsync(t => (decimal?)t.SoTienDaThanhToan) ?? 0m;

            var remaining = invoice.TongThanhToan - totalPaid;

            if (remaining <= 0)
            {
                invoice.TrangThai = "Paid";
                await Db.SaveChangesAsync();
                await transaction.CommitAsync();

                paymentMessage = "Hóa đơn đã được tất toán.";
                await LoadDataAsync();
                return;
            }

            var payment = new ThanhToan
            {
                MaHoaDon = invoiceId,
                PhuongThucThanhToan = "Cash",
                SoTienDaThanhToan = remaining,
                MaGiaoDich = $"CS-{DateTime.UtcNow:yyMMddHHmmss}-{Guid.NewGuid():N}"[..40],
                TrangThai = "Success",
                NgayThanhToan = DateTime.UtcNow
            };

            Db.ThanhToans.Add(payment);

            invoice.TrangThai = "Paid";

            await Db.SaveChangesAsync();
            await transaction.CommitAsync();

            await AuditService.GhiNhanAsync(
                "THU_TIEN_HOA_DON",
                "HoaDon",
                invoice.MaId.ToString(),
                $"Thu tiền mặt hóa đơn #HD-{invoice.MaId:D4}, số tiền: {remaining:N0} đ",
                Session.CurrentUser.Id,
                Session.CurrentUser.Email,
                "127.0.0.1",
                true);

            paymentMessage =
                $"Thu tiền thành công hóa đơn #{invoiceId}. Số tiền: {remaining:N0} đ.";

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            paymentMessage = $"Không thể thanh toán: {ex.Message}";
        }
    }
}
