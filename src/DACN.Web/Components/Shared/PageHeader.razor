<div class="hotel-page-header">
    <div>
        <h2>
            @if (!string.IsNullOrEmpty(Icon))
            {
                <i class="@Icon" style="color: var(--hotel-primary);"></i>
            }
            @Title
            @if (!string.IsNullOrEmpty(MemberTag))
            {
                <span class="member-tag @MemberTagClass ms-2">@MemberTag</span>
            }
        </h2>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p>@Subtitle</p>
        }
    </div>

    @if (Actions != null)
    {
        <div class="d-flex align-items-center gap-2">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? MemberTag { get; set; }
    [Parameter] public string MemberTagClass { get; set; } = "member-tag-tv1";
    [Parameter] public RenderFragment? Actions { get; set; }
}
