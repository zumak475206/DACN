@inherits LayoutComponentBase
@inject UserSessionService Session
@inject GoiYDuLichService AiService
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage LocalStorage
@inject IJSRuntime JS
@implements IDisposable

<div class="customer-portal-wrapper">
    <!-- 1. HEADER PHONG CÁCH BOOKING.COM & AI TRAVEL -->
    <header class="customer-header sticky-top" style="background: #003B95; color: white;">
        <div class="container">
            <!-- Top bar: Tiền tệ VND, Quốc gia, Thông tin liên hệ -->
            <div class="d-flex align-items-center justify-content-between py-2 border-bottom" style="border-color: rgba(255,255,255,0.15) !important; font-size: 0.82rem;">
                <div class="d-flex align-items-center gap-3">
                    <span class="fw-semibold"><i class="bi bi-globe-asia-australia me-1 text-warning"></i> Hệ thống Đặt phòng & Trợ lý Du lịch AI Toàn Quốc</span>
                    <span class="badge bg-white text-dark fw-bold px-2 py-1">VND 🇻🇳</span>
                </div>

                <div class="d-none d-md-flex align-items-center gap-3 text-light opacity-90">
                    <a href="my-bookings" class="text-white text-decoration-none fw-semibold">
                        <i class="bi bi-search text-warning me-1"></i> Tra cứu đơn đặt phòng
                    </a>
                    <span class="text-white-50">|</span>
                    <span><i class="bi bi-telephone-fill text-warning me-1"></i> Hotline: <strong>1900 6868</strong></span>
                    <span><i class="bi bi-headset text-warning me-1"></i> Hỗ trợ khách hàng 24/7</span>
                </div>
            </div>

            <!-- Navbar chính -->
            <nav class="navbar navbar-expand-lg navbar-dark py-2">
                <a class="navbar-brand d-flex align-items-center gap-2" href="">
                    <div style="width: 40px; height: 40px; border-radius: 8px; background: #FFB700; color: #003B95; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 900;">
                        <i class="bi bi-luggage-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 text-white" style="letter-spacing: -0.5px; line-height: 1.1;">BookingStay<span style="color: #FFB700;">.AI</span></div>
                        <small style="color: #93C5FD; font-size: 0.7rem; letter-spacing: 0.5px;">ĐẶT PHÒNG & ĐI MUÔN NƠI CÙNG AI</small>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#customerNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="customerNav">
                    <!-- Các pill điều hướng kiểu Booking.com -->
                    <ul class="navbar-nav mx-auto gap-1 gap-lg-2 fw-semibold align-items-lg-center mt-2 mt-lg-0" style="font-size: 0.9rem;">
                        <li class="nav-item">
                            <NavLink class="nav-link booking-nav-pill px-3 py-1 text-white" href="" Match="NavLinkMatch.All">
                                <i class="bi bi-buildings me-1"></i> Lưu trú & Khách sạn
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link booking-nav-pill px-3 py-1 text-white" href="/#ai-goi-y">
                                <i class="bi bi-stars text-warning me-1"></i> AI Gợi Ý Điểm Đến
                            </a>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link booking-nav-pill px-3 py-1 text-white" href="rooms">
                                <i class="bi bi-door-open me-1"></i> Tìm Phòng & Giá
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link booking-nav-pill px-3 py-1 text-white" href="/#diem-check-in">
                                <i class="bi bi-camera me-1"></i> Điểm Check-in Sống Ảo
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link booking-nav-pill px-3 py-1 text-warning fw-bold" href="/#uu-dai">
                                <i class="bi bi-tag-fill me-1"></i> Ưu Đãi & Voucher
                            </a>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link booking-nav-pill px-3 py-1 text-white" href="my-bookings">
                                <i class="bi bi-ticket-perforated text-warning me-1"></i> Đơn Của Tôi
                            </NavLink>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        @if (Session.CurrentUser.IsLoggedIn)
                        {
                            @if (Session.CurrentUser.Role != "Customer")
                            {
                                <button type="button" @onclick="GoToStaffDashboard" class="btn btn-warning fw-bold py-1 px-3 text-dark d-flex align-items-center gap-1 shadow-sm" style="font-size: 0.84rem; border-radius: 999px;">
                                    <i class="bi bi-speedometer2"></i>
                                    <span>Quản Trị Hệ Thống</span>
                                </button>
                            }

                            <div class="position-relative">
                                <button class="btn btn-light border-0 py-1 px-3 d-flex align-items-center gap-2 shadow-sm"
                                        type="button"
                                        @onclick="ToggleUserMenu"
                                        style="border-radius: 999px;">
                                    <div style="width: 28px; height: 28px; border-radius: 50%; background: #003B95; color: white; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold;">
                                        @Session.CurrentUser.HoTen.Substring(0, Math.Min(2, Session.CurrentUser.HoTen.Length)).ToUpper()
                                    </div>
                                    <span class="small fw-bold text-dark">@Session.CurrentUser.HoTen</span>
                                    <span class="badge @(Session.CurrentUser.Role == "Customer" ? "bg-primary" : "bg-warning text-dark") rounded-pill" style="font-size: 0.68rem;">
                                        @Session.CurrentUser.RoleShortBadge
                                    </span>
                                    <i class="bi @(isUserMenuOpen ? "bi-chevron-up" : "bi-chevron-down") text-dark" style="font-size: 0.75rem;"></i>
                                </button>

                                @if (isUserMenuOpen)
                                {
                                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="() => isUserMenuOpen = false"></div>
                                    <ul class="dropdown-menu show shadow-lg border-0 mt-2" style="right: 0; left: auto; min-width: 250px; border-radius: 12px; z-index: 1050;">
                                        <li class="px-3 py-2 border-bottom bg-light rounded-top">
                                            <div class="fw-bold text-dark small">@Session.CurrentUser.HoTen</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">@Session.CurrentUser.Email</div>
                                            <span class="badge bg-primary-subtle text-primary mt-1" style="font-size: 0.7rem;">@Session.CurrentUser.RoleDisplayName</span>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item py-2 d-flex align-items-center" @onclick="OpenProfileModal">
                                                <i class="bi bi-person-vcard me-2 text-primary"></i> Thông Tin Tài Khoản
                                            </button>
                                        </li>
                                        @if (Session.CurrentUser.Role != "Customer")
                                        {
                                            <li>
                                                <button type="button" class="dropdown-item py-2 fw-semibold text-primary d-flex align-items-center" @onclick="GoToStaffDashboard">
                                                    <i class="bi bi-speedometer2 me-2"></i> Vào Admin Dashboard
                                                </button>
                                            </li>
                                        }
                                        <li>
                                            <button type="button" class="dropdown-item py-2 d-flex align-items-center" @onclick='() => NavigateAndClose("/my-bookings")'>
                                                <i class="bi bi-clock-history me-2 text-secondary"></i> Đơn Đặt Phòng Của Tôi
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <button type="button" class="dropdown-item py-2 text-danger fw-semibold d-flex align-items-center" @onclick="Logout">
                                                <i class="bi bi-box-arrow-right me-2"></i> Đăng Xuất
                                            </button>
                                        </li>
                                    </ul>
                                }
                            </div>
                        }
                        else
                        {
                            <a href="my-bookings" class="btn btn-warning fw-bold text-dark py-1 px-3 d-flex align-items-center gap-1 shadow-sm" style="font-size: 0.86rem; border-radius: 6px;">
                                <i class="bi bi-search"></i>
                                <span>Tra Cứu Đơn</span>
                            </a>
                            <a href="register" class="btn btn-outline-light fw-bold py-1 px-3 d-flex align-items-center gap-1" style="font-size: 0.88rem; border-radius: 6px;">
                                <i class="bi bi-person-plus"></i>
                                <span>Đăng ký</span>
                            </a>
                            <a href="login" class="btn btn-light fw-bold text-primary py-1 px-3 d-flex align-items-center gap-2" style="font-size: 0.88rem; border-radius: 6px;">
                                <i class="bi bi-person-circle"></i>
                                <span>Đăng nhập</span>
                            </a>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <!-- 2. NỘI DUNG CHÍNH TRANG KHÁCH HÀNG -->
    <main class="customer-main-content">
        @Body
    </main>

    <!-- 3. FOOTER PHONG CÁCH BOOKING & DU LỊCH -->
    <footer class="customer-footer mt-5 pt-5 pb-4" style="background: #00224F; color: #E2E8F0;">
        <div class="container">
            <div class="row g-4 pb-4 border-bottom border-secondary">
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div style="width: 36px; height: 36px; border-radius: 6px; background: #FFB700; color: #003B95; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                            <i class="bi bi-luggage-fill"></i>
                        </div>
                        <h5 class="mb-0 text-white fw-bold">BookingStay.AI Vietnam</h5>
                    </div>
                    <p class="small text-light opacity-75" style="line-height: 1.6;">
                        Nền tảng Đặt phòng chuỗi nghỉ dưỡng kết hợp Trợ lý AI thông minh: Gợi ý điểm đến đẹp nhất theo mùa, lọc theo ngân sách và gu check-in sống ảo / nghỉ dưỡng chữa lành.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-primary">Gợi ý lịch trình AI</span>
                        <span class="badge bg-primary">Dự báo mùa đẹp nhất</span>
                        <span class="badge bg-primary">Đặt phòng giữ chỗ tức thì</span>
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <h6 class="text-white fw-bold mb-3">Khám Phá Điểm Đến</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="/#ai-goi-y" class="text-decoration-none text-light opacity-75">Đà Nẵng — Biển Mỹ Khê</a></li>
                        <li><a href="/#ai-goi-y" class="text-decoration-none text-light opacity-75">Đà Lạt — Săn Mây</a></li>
                        <li><a href="/#ai-goi-y" class="text-decoration-none text-light opacity-75">Phú Quốc — Hoàng Hôn</a></li>
                        <li><a href="/#ai-goi-y" class="text-decoration-none text-light opacity-75">Sa Pa — Mùa Lúa Chín</a></li>
                        <li><a href="/#ai-goi-y" class="text-decoration-none text-light opacity-75">Hội An — Phố Cổ</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3">
                    <h6 class="text-white fw-bold mb-3">Dành Cho Khách Hàng</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="rooms" class="text-decoration-none text-light opacity-75">Tìm kiếm chỗ nghỉ & Hạng phòng</a></li>
                        <li><a href="my-bookings" class="text-decoration-none text-light opacity-75">Quản lý đơn đặt phòng</a></li>
                        <li><a href="/#uu-dai" class="text-decoration-none text-light opacity-75">Kho Voucher ưu đãi theo mùa</a></li>
                        <li><a href="login" class="text-decoration-none text-light opacity-75">Đăng nhập thành viên</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-3">
                    <h6 class="text-white fw-bold mb-3">Liên Hệ & Hỗ Trợ</h6>
                    <div class="small text-light opacity-75 mb-1"><i class="bi bi-geo-alt text-warning me-1"></i> Võ Nguyên Giáp, Mỹ Khê, Đà Nẵng</div>
                    <div class="small text-light opacity-75 mb-1"><i class="bi bi-telephone text-info me-1"></i> Hotline: 1900 6868 (24/7)</div>
                    <div class="small text-light opacity-75 mb-1"><i class="bi bi-envelope text-success me-1"></i> Email: support@bookingstay.ai</div>
                    <div class="small text-light opacity-75"><i class="bi bi-shield-check text-warning me-1"></i> Bảo mật thanh toán & Đặt phòng tức thì</div>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 small text-light opacity-75">
                <div>© 2026 BookingStay.AI — Hệ thống Quản trị Lưu trú & Gợi ý Du lịch Thông minh (DACN).</div>
                <div>ASP.NET Core 9.0 + Blazor Interactive + SQL Server</div>
            </div>
        </div>
    </footer>

    <!-- 4. FLOATING AI TRAVEL ADVISOR WIDGET GÓC PHẢI (KHUNG DÀNH CHO TV4) -->
    <div class="floating-ai-widget">
        @if (isChatOpen)
        {
            <div class="ai-chat-popup shadow-lg rounded-4 border overflow-hidden">
                <div class="ai-chat-header d-flex justify-content-between align-items-center p-3 text-white" style="background: linear-gradient(135deg, #003B95, #6D28D9);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-stars fs-4 text-warning"></i>
                        <div>
                            <div class="fw-bold" style="font-size: 0.92rem;">AI Tư Vấn Đi Đâu & Đặt Phòng</div>
                            <small style="font-size: 0.72rem; opacity: 0.9;">Gợi ý theo Ngân sách • Gu sống ảo • Mùa đẹp nhất</small>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-link text-white p-0" @onclick="() => isChatOpen = false">
                        <i class="bi bi-x-lg fs-5"></i>
                    </button>
                </div>

                <div class="ai-chat-body p-3 overflow-auto" style="height: 340px; background: #F8FAFC; font-size: 0.84rem;">
                    <div class="p-2 px-3 rounded-3 bg-white shadow-sm mb-2 border">
                        👋 Chào bạn! Bạn đang phân vân <strong>chưa biết đi đâu, ở đâu</strong>? Hãy cho mình biết <strong>ngân sách</strong>, <strong>gu sống ảo hay thư giãn</strong> và <strong>thời gian đi</strong> nhé!
                    </div>

                    <!-- Thanh định vị GPS / Chọn Tỉnh thành xuất phát -->
                    <div class="p-2 mb-2 rounded-3 bg-white border d-flex align-items-center justify-content-between gap-1 shadow-sm" style="font-size: 0.74rem;">
                        <div class="d-flex align-items-center gap-1 text-truncate">
                            <i class="bi bi-geo-alt-fill text-danger"></i>
                            <span class="text-muted">Điểm xuất phát:</span>
                            <strong class="text-primary text-truncate">@(string.IsNullOrWhiteSpace(userCity) ? "TP. Hồ Chí Minh" : userCity)</strong>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <button class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.70rem;" title="Định vị GPS tự động" @onclick="GetGpsLocation">
                                <i class="bi bi-crosshair"></i> GPS
                            </button>
                            <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.70rem;" title="Đổi tỉnh thành" @onclick="() => showCityPicker = !showCityPicker">
                                <i class="bi bi-pencil"></i> Đổi
                            </button>
                        </div>
                    </div>

                    @if (showCityPicker)
                    {
                        <div class="p-2 mb-2 rounded-3 bg-light border shadow-sm" style="font-size: 0.74rem;">
                            <label class="fw-bold mb-1 text-dark">Bạn đang ở tỉnh/thành nào?</label>
                            <div class="input-group input-group-sm mb-2">
                                <input class="form-control form-control-sm" placeholder="VD: Cần Thơ, Vũng Tàu, Đà Lạt, Hà Nội..." @bind="customCityInput" />
                                <button class="btn btn-primary btn-sm" @onclick="SetCustomCity">Chọn</button>
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <span class="badge bg-white text-dark border cursor-pointer" @onclick='() => SetQuickCity("TP. Hồ Chí Minh")'>TP.HCM</span>
                                <span class="badge bg-white text-dark border cursor-pointer" @onclick='() => SetQuickCity("Vũng Tàu")'>Vũng Tàu</span>
                                <span class="badge bg-white text-dark border cursor-pointer" @onclick='() => SetQuickCity("Cần Thơ")'>Cần Thơ</span>
                                <span class="badge bg-white text-dark border cursor-pointer" @onclick='() => SetQuickCity("Đà Lạt")'>Đà Lạt</span>
                                <span class="badge bg-white text-dark border cursor-pointer" @onclick='() => SetQuickCity("Đà Nẵng")'>Đà Nẵng</span>
                                <span class="badge bg-white text-dark border cursor-pointer" @onclick='() => SetQuickCity("Hà Nội")'>Hà Nội</span>
                            </div>
                        </div>
                    }

                    <!-- Gợi ý câu hỏi nhanh đúng ý tưởng đồ án -->
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        <button class="btn btn-sm btn-outline-primary rounded-pill py-1 px-2" style="font-size: 0.72rem;"
                                @onclick='() => QuickAsk("Giờ tôi có 3 triệu muốn đi sống ảo gần khu vực Hồ Chí Minh trong tháng 12 thì nên đi đâu?")'>
                            🌲 3tr sống ảo gần TP.HCM tháng 12?
                        </button>
                        <button class="btn btn-sm btn-outline-primary rounded-pill py-1 px-2" style="font-size: 0.72rem;"
                                @onclick='() => QuickAsk("Tháng 6 có 3 triệu muốn đi biển Đà Nẵng sống ảo?")'>
                            🌊 Tháng 6 đi biển Đà Nẵng?
                        </button>
                        <button class="btn btn-sm btn-outline-primary rounded-pill py-1 px-2" style="font-size: 0.72rem;"
                                @onclick='() => QuickAsk("Có mã voucher giảm giá nào đang dùng được không?")'>
                            🎁 Xin mã giảm giá
                        </button>
                    </div>

                    @foreach (var msg in chatList)
                    {
                        <div class="d-flex @(msg.IsUser ? "justify-content-end" : "") mb-2">
                            <div class="p-2 px-3 rounded-3 shadow-sm" style="background: @(msg.IsUser ? "#003B95" : "white"); color: @(msg.IsUser ? "white" : "#1E293B"); max-width: 92%; border: 1px solid rgba(0,0,0,0.06);">
                                <div>@((MarkupString)RenderMarkdown(msg.Text))</div>

                                @if (!msg.IsUser && msg.Suggestions is { Count: > 0 })
                                {
                                    <div class="mt-2 pt-2 border-top d-flex flex-column gap-2">
                                        @foreach (var s in msg.Suggestions.Take(2))
                                        {
                                            <div class="p-2 rounded-3 border bg-light text-dark" style="font-size: 0.76rem;">
                                                <div class="d-flex justify-content-between align-items-start gap-1 mb-1">
                                                    <strong class="text-primary">@s.TieuDe</strong>
                                                    <span class="badge bg-success">@s.PhanTramPhuHop% Match</span>
                                                </div>
                                                <div class="text-muted mb-1"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@s.DiemDen</div>
                                                <div class="text-muted mb-1">🌤️ <strong>@s.ThoiDiemDepNhat</strong> (@s.ThoiTietDuKien)</div>
                                                <div class="mb-1">🏨 <strong>@s.TenChiNhanh</strong> • Phòng: <span class="fw-bold text-dark">@s.HangPhongPhuHop</span> (@(s.GiaPhongMoiDem?.ToString("N0"))đ/đêm)</div>
                                                <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top">
                                                    <span class="fw-bold text-success">Trọn gói: @s.ChiPhiDuKienTu.ToString("N0")đ – @s.ChiPhiDuKienDen.ToString("N0")đ</span>
                                                    <a href="/rooms?branch=@s.MaChiNhanh" class="btn btn-sm btn-primary py-0 px-2 fw-bold" style="font-size: 0.72rem;" @onclick="() => isChatOpen = false">
                                                        Đặt Phòng Ngay
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="p-2 border-top bg-white d-flex gap-2">
                    <input type="text" class="hotel-input flex-grow-1" style="font-size: 0.84rem; padding: 0.4rem 0.7rem;" 
                           placeholder="VD: Đi đâu 3 triệu cảnh đẹp sống ảo..." 
                           @bind="chatInput" @bind:event="oninput" @onkeydown="HandleChatKeyDown" />
                    <button class="hotel-btn hotel-btn-ai py-1 px-3" style="font-size: 0.85rem;" @onclick="SendChatMessage">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        }

        <button class="btn-floating-ai shadow-lg" @onclick="() => isChatOpen = !isChatOpen" title="Hỏi trợ lý AI tư vấn điểm đến & đặt phòng">
            <i class="bi @(isChatOpen ? "bi-x-lg" : "bi-stars") fs-4 text-white"></i>
        </button>
    </div>

    @if (isProfileModalOpen && Session.CurrentUser.IsLoggedIn)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); z-index: 2100;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                    <div class="modal-header text-white border-0 py-3 px-4" style="background: #003B95;">
                        <h5 class="modal-title fw-bold mb-0"><i class="bi bi-person-vcard me-2 text-warning"></i> Thông Tin Tài Khoản</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => isProfileModalOpen = false"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                            <div style="width: 56px; height: 56px; border-radius: 50%; background: #003B95; color: #FFB700; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: bold;">
                                @Session.CurrentUser.HoTen.Substring(0, Math.Min(2, Session.CurrentUser.HoTen.Length)).ToUpper()
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@Session.CurrentUser.HoTen</h5>
                                <div class="text-muted small">@Session.CurrentUser.Email</div>
                                <span class="badge bg-primary mt-1">@Session.CurrentUser.RoleDisplayName</span>
                            </div>
                        </div>

                        <div class="row g-3 small">
                            <div class="col-6">
                                <div class="text-muted">Mã tài khoản</div>
                                <div class="fw-bold text-dark">#@Session.CurrentUser.Id</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted">Trạng thái</div>
                                <div class="fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> Đang hoạt động</div>
                            </div>
                            <div class="col-12">
                                <div class="text-muted">Quyền hạn hệ thống</div>
                                <div class="fw-semibold text-dark">@Session.CurrentUser.Permissions.Count quyền được cấp</div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 bg-light px-4 py-3 d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-danger btn-sm fw-bold" @onclick="Logout">
                            <i class="bi bi-box-arrow-right me-1"></i> Đăng Xuất
                        </button>
                        <div class="d-flex gap-2">
                            @if (Session.CurrentUser.Role != "Customer")
                            {
                                <button type="button" class="btn btn-primary btn-sm fw-bold" @onclick="GoToStaffDashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Vào Admin Dashboard
                                </button>
                            }
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => isProfileModalOpen = false">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
