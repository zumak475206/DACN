@inherits LayoutComponentBase
@inject UserSessionService Session
@inject NavigationManager Nav
@implements IDisposable

<div class="customer-portal-wrapper">
    <!-- 1. HEADER PHONG CÁCH BOOKING.COM & AI TRAVEL -->
    <header class="customer-header sticky-top" style="background: #003B95; color: white;">
        <div class="container">
            <!-- Top bar: Tiền tệ VND, Quốc gia, Chuyển đổi vai trò kiểm thử đồ án -->
            <div class="d-flex align-items-center justify-content-between py-2 border-bottom" style="border-color: rgba(255,255,255,0.15) !important; font-size: 0.82rem;">
                <div class="d-flex align-items-center gap-3">
                    <span class="fw-semibold"><i class="bi bi-globe-asia-australia me-1 text-warning"></i> Hệ thống Đặt phòng & Trợ lý Du lịch AI Toàn Quốc</span>
                    <span class="badge bg-white text-dark fw-bold px-2 py-1">VND 🇻🇳</span>
                </div>

                <!-- Giả lập phân quyền & Chuyển vai trò test đồ án -->
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark d-none d-sm-inline">
                        <i class="bi bi-person-badge me-1"></i> Đang xem: <strong>@Session.CurrentUser.RoleDisplayName</strong>
                    </span>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-light dropdown-toggle py-0 px-2" type="button" data-bs-toggle="dropdown" style="font-size: 0.75rem;">
                            Đổi vai trò test (TV1-TV4)
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow" style="font-size: 0.85rem;">
                            <li><h6 class="dropdown-header">Chọn vai trò kiểm thử</h6></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick='() => SwitchRole("Customer")'><i class="bi bi-person me-2 text-primary"></i> Khách Hàng (Cổng Booking)</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick='() => SwitchRole("FrontDesk")'><i class="bi bi-bell me-2 text-warning"></i> Lễ Tân (TV3 — Tiền sảnh)</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick='() => SwitchRole("Housekeeping")'><i class="bi bi-brush me-2 text-success"></i> Buồng Phòng (TV2 — Vận hành)</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick='() => SwitchRole("Manager")'><i class="bi bi-pie-chart me-2 text-info"></i> Quản Lý (TV4 — AI & BI)</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick='() => SwitchRole("Admin")'><i class="bi bi-shield-lock me-2 text-danger"></i> Tổng Quản Trị (TV1 — Admin)</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Navbar chính -->
            <nav class="navbar navbar-expand-lg navbar-dark py-2">
                <a class="navbar-brand d-flex align-items-center gap-2" href="">
                    <div style="width: 40px; height: 40px; border-radius: 8px; background: #FFB700; color: #003B95; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 900;">
                        <i class="bi bi-luggage-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 text-white" style="letter-spacing: -0.5px; line-height: 1.1;">BookingStay<span style="color: #FFB700;">.AI</span></div>
                        <small style="color: #93C5FD; font-size: 0.7rem; letter-spacing: 0.5px;">ĐẶT PHÒNG & ĐI MUÔN NƠI CÙNG AI</small>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#customerNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="customerNav">
                    <!-- Các pill điều hướng kiểu Booking.com -->
                    <ul class="navbar-nav mx-auto gap-1 gap-lg-2 fw-semibold align-items-lg-center mt-2 mt-lg-0" style="font-size: 0.9rem;">
                        <li class="nav-item">
                            <NavLink class="nav-link booking-nav-pill px-3 py-1 text-white" href="" Match="NavLinkMatch.All">
                                <i class="bi bi-buildings me-1"></i> Lưu trú & Khách sạn
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link booking-nav-pill px-3 py-1 text-white" href="/#ai-goi-y">
                                <i class="bi bi-stars text-warning me-1"></i> AI Gợi Ý Điểm Đến
                            </a>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link booking-nav-pill px-3 py-1 text-white" href="rooms">
                                <i class="bi bi-door-open me-1"></i> Tìm Phòng & Giá
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link booking-nav-pill px-3 py-1 text-white" href="/#diem-check-in">
                                <i class="bi bi-camera me-1"></i> Điểm Check-in Sống Ảo
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link booking-nav-pill px-3 py-1 text-warning fw-bold" href="/#uu-dai">
                                <i class="bi bi-tag-fill me-1"></i> Ưu Đãi & Voucher
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        @if (Session.CurrentUser.Role != "Customer")
                        {
                            <a href="admin/dashboard" class="btn btn-warning fw-bold py-1 px-3 text-dark" style="font-size: 0.85rem; border-radius: 6px;" title="Chuyển đến màn hình làm việc nhân viên">
                                <i class="bi bi-speedometer2 me-1"></i> Cổng Quản Trị (Staff)
                            </a>
                        }

                        @if (Session.CurrentUser.IsLoggedIn)
                        {
                            <div class="dropdown">
                                <button class="btn btn-light border-0 dropdown-toggle py-1 px-3 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" style="border-radius: 6px;">
                                    <div style="width: 26px; height: 26px; border-radius: 50%; background: #003B95; color: white; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold;">
                                        @Session.CurrentUser.HoTen.Substring(0, Math.Min(2, Session.CurrentUser.HoTen.Length)).ToUpper()
                                    </div>
                                    <span class="small fw-semibold text-dark">@Session.CurrentUser.HoTen</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item" href="my-bookings"><i class="bi bi-clock-history me-2"></i> Đơn Đặt Phòng Của Tôi</a></li>
                                    <li><a class="dropdown-item" href="login"><i class="bi bi-arrow-repeat me-2"></i> Đổi Tài Khoản / Vai Trò</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="javascript:void(0)" @onclick="Logout"><i class="bi bi-box-arrow-right me-2"></i> Đăng Xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a href="login" class="btn btn-light fw-bold text-primary py-1 px-3" style="font-size: 0.85rem;">
                                Đăng nhập / Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <!-- 2. NỘI DUNG CHÍNH TRANG KHÁCH HÀNG -->
    <main class="customer-main-content">
        @Body
    </main>

    <!-- 3. FOOTER PHONG CÁCH BOOKING & DU LỊCH -->
    <footer class="customer-footer mt-5 pt-5 pb-4" style="background: #00224F; color: #E2E8F0;">
        <div class="container">
            <div class="row g-4 pb-4 border-bottom border-secondary">
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div style="width: 36px; height: 36px; border-radius: 6px; background: #FFB700; color: #003B95; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                            <i class="bi bi-luggage-fill"></i>
                        </div>
                        <h5 class="mb-0 text-white fw-bold">BookingStay.AI Vietnam</h5>
                    </div>
                    <p class="small text-light opacity-75" style="line-height: 1.6;">
                        Nền tảng Đặt phòng chuỗi nghỉ dưỡng kết hợp Trợ lý AI thông minh: Gợi ý điểm đến đẹp nhất theo mùa, lọc theo ngân sách và gu check-in sống ảo / nghỉ dưỡng chữa lành.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-primary">Gợi ý lịch trình AI</span>
                        <span class="badge bg-primary">Dự báo mùa đẹp nhất</span>
                        <span class="badge bg-primary">Đặt phòng giữ chỗ tức thì</span>
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <h6 class="text-white fw-bold mb-3">Khám Phá Điểm Đến</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="/#ai-goi-y" class="text-decoration-none text-light opacity-75">Đà Nẵng — Biển Mỹ Khê</a></li>
                        <li><a href="/#ai-goi-y" class="text-decoration-none text-light opacity-75">Đà Lạt — Săn Mây</a></li>
                        <li><a href="/#ai-goi-y" class="text-decoration-none text-light opacity-75">Phú Quốc — Hoàng Hôn</a></li>
                        <li><a href="/#ai-goi-y" class="text-decoration-none text-light opacity-75">Sa Pa — Mùa Lúa Chín</a></li>
                        <li><a href="/#ai-goi-y" class="text-decoration-none text-light opacity-75">Hội An — Phố Cổ</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3">
                    <h6 class="text-white fw-bold mb-3">Dành Cho Khách Hàng</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="rooms" class="text-decoration-none text-light opacity-75">Tìm kiếm chỗ nghỉ & Hạng phòng</a></li>
                        <li><a href="my-bookings" class="text-decoration-none text-light opacity-75">Quản lý đơn đặt phòng</a></li>
                        <li><a href="/#uu-dai" class="text-decoration-none text-light opacity-75">Kho Voucher ưu đãi theo mùa</a></li>
                        <li><a href="login" class="text-decoration-none text-warning fw-bold">Chuyển đổi vai trò Demo (TV1-TV4)</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-3">
                    <h6 class="text-white fw-bold mb-3">Phân Công Nhóm Đồ Án (DACN)</h6>
                    <div class="small text-light opacity-75 mb-1"><i class="bi bi-shield-check text-info me-1"></i> <strong>TV1:</strong> Auth, RBAC, Voucher, Điểm đến</div>
                    <div class="small text-light opacity-75 mb-1"><i class="bi bi-brush text-success me-1"></i> <strong>TV2:</strong> Buồng phòng, Tài sản, Chi phí</div>
                    <div class="small text-light opacity-75 mb-1"><i class="bi bi-calendar-check text-warning me-1"></i> <strong>TV3:</strong> Đặt phòng, Lễ tân, Hóa đơn</div>
                    <div class="small text-light opacity-75"><i class="bi bi-robot text-danger me-1"></i> <strong>TV4:</strong> AI Tư vấn du lịch, Dự báo & BI</div>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 small text-light opacity-75">
                <div>© 2026 BookingStay.AI — Hệ thống Quản trị Lưu trú & Gợi ý Du lịch Thông minh (DACN).</div>
                <div>ASP.NET Core 9.0 + Blazor Interactive + SQL Server</div>
            </div>
        </div>
    </footer>

    <!-- 4. FLOATING AI TRAVEL ADVISOR WIDGET GÓC PHẢI (KHUNG DÀNH CHO TV4) -->
    <div class="floating-ai-widget">
        @if (isChatOpen)
        {
            <div class="ai-chat-popup shadow-lg rounded-4 border overflow-hidden">
                <div class="ai-chat-header d-flex justify-content-between align-items-center p-3 text-white" style="background: linear-gradient(135deg, #003B95, #6D28D9);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-stars fs-4 text-warning"></i>
                        <div>
                            <div class="fw-bold" style="font-size: 0.92rem;">AI Tư Vấn Đi Đâu & Đặt Phòng</div>
                            <small style="font-size: 0.72rem; opacity: 0.9;">Gợi ý theo Ngân sách • Gu sống ảo • Mùa đẹp nhất</small>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-link text-white p-0" @onclick="() => isChatOpen = false">
                        <i class="bi bi-x-lg fs-5"></i>
                    </button>
                </div>

                <div class="ai-chat-body p-3 overflow-auto" style="height: 340px; background: #F8FAFC; font-size: 0.84rem;">
                    <div class="p-2 px-3 rounded-3 bg-white shadow-sm mb-2 border">
                        👋 Chào bạn! Bạn đang phân vân <strong>chưa biết đi đâu, ở đâu</strong>? Hãy cho mình biết <strong>ngân sách</strong>, <strong>gu sống ảo hay thư giãn</strong> và <strong>thời gian đi</strong> nhé!
                    </div>

                    <!-- Gợi ý câu hỏi nhanh đúng ý tưởng đồ án -->
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        <button class="btn btn-sm btn-outline-primary rounded-pill py-1 px-2" style="font-size: 0.72rem;"
                                @onclick='() => QuickAsk("Cầm 2 triệu đi đâu nhiều góc check-in sống ảo?")'>
                            📸 2 triệu đi đâu sống ảo?
                        </button>
                        <button class="btn btn-sm btn-outline-primary rounded-pill py-1 px-2" style="font-size: 0.72rem;"
                                @onclick='() => QuickAsk("Tháng này đi đâu thời tiết đẹp và thư giãn nhất?")'>
                            🌿 Mùa này đâu đẹp nhất?
                        </button>
                        <button class="btn btn-sm btn-outline-primary rounded-pill py-1 px-2" style="font-size: 0.72rem;"
                                @onclick='() => QuickAsk("Có mã voucher giảm giá nào đang dùng được không?")'>
                            🎁 Xin mã giảm giá
                        </button>
                    </div>

                    @foreach (var msg in chatList)
                    {
                        <div class="d-flex @(msg.IsUser ? "justify-content-end" : "") mb-2">
                            <div class="p-2 px-3 rounded-3 shadow-sm" style="background: @(msg.IsUser ? "#003B95" : "white"); color: @(msg.IsUser ? "white" : "#1E293B"); max-width: 88%; border: 1px solid rgba(0,0,0,0.06);">
                                @msg.Text
                            </div>
                        </div>
                    }
                </div>

                <div class="p-2 border-top bg-white d-flex gap-2">
                    <input type="text" class="hotel-input flex-grow-1" style="font-size: 0.84rem; padding: 0.4rem 0.7rem;" 
                           placeholder="VD: Đi đâu 3 triệu cảnh đẹp sống ảo..." 
                           @bind="chatInput" @bind:event="oninput" @onkeydown="HandleChatKeyDown" />
                    <button class="hotel-btn hotel-btn-ai py-1 px-3" style="font-size: 0.85rem;" @onclick="SendChatMessage">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        }

        <button class="btn-floating-ai shadow-lg" @onclick="() => isChatOpen = !isChatOpen" title="Hỏi trợ lý AI tư vấn điểm đến & đặt phòng">
            <i class="bi @(isChatOpen ? "bi-x-lg" : "bi-stars") fs-4 text-white"></i>
        </button>
    </div>
</div>

<style>
    .customer-portal-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #F8FAFC;
    }
    .customer-header {
        box-shadow: 0 2px 12px rgba(0,0,0,0.12);
        z-index: 1000;
    }
    .booking-nav-pill {
        border-radius: 999px;
        border: 1px solid transparent;
        transition: all 0.15s ease;
    }
    .booking-nav-pill:hover, .booking-nav-pill.active {
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 255, 255, 0.4);
    }
    .customer-main-content {
        flex-grow: 1;
    }
    .floating-ai-widget {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 2000;
    }
    .btn-floating-ai {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: linear-gradient(135deg, #003B95, #7C3AED);
        border: 2px solid #FFB700;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .btn-floating-ai:hover {
        transform: scale(1.08);
        box-shadow: 0 8px 24px rgba(124, 58, 237, 0.45);
    }
    .ai-chat-popup {
        position: absolute;
        bottom: 72px;
        right: 0;
        width: 360px;
        background: white;
        z-index: 2001;
    }
</style>

@code {
    private bool isChatOpen = false;
    private string chatInput = "";
    private List<ChatMsg> chatList = new();

    private record ChatMsg(string Text, bool IsUser);

    protected override void OnInitialized()
    {
        Session.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }

    private void SwitchRole(string role)
    {
        Session.SwitchRole(role);
        if (role == "Customer") Nav.NavigateTo("/");
        else if (role == "FrontDesk") Nav.NavigateTo("/frontdesk/bookings");
        else if (role == "Housekeeping") Nav.NavigateTo("/housekeeping/rooms");
        else if (role == "Manager") Nav.NavigateTo("/ai-analytics/dashboard");
        else if (role == "Admin") Nav.NavigateTo("/admin/accounts");
    }

    private void Logout()
    {
        Session.Logout();
        Nav.NavigateTo("/");
    }

    private void QuickAsk(string prompt)
    {
        chatInput = prompt;
        SendChatMessage();
    }

    private void HandleChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SendChatMessage();
    }

    // TODO [TV4 - AI Core]: Nối hàm SendChatMessage() này với endpoint POST /api/v1/ai/chat để lưu vào bảng PhienChat_AI & TinNhanChat_AI
    private void SendChatMessage()
    {
        if (string.IsNullOrWhiteSpace(chatInput)) return;

        chatList.Add(new ChatMsg(chatInput, true));
        var q = chatInput.ToLowerInvariant();
        chatInput = "";

        string res;
        if (q.Contains("sống ảo") || q.Contains("2 triệu") || q.Contains("3 triệu"))
            res = "✨ Với ngân sách ~2 triệu & thích check-in sống ảo: Bạn nên chọn Phòng Deluxe Sea View (1.000.000đ/đêm, ban công hướng biển đón bình minh) kết hợp check-in Cầu Vàng Bà Nà Hills, Bán đảo Sơn Trà và phố cổ Hội An! Áp mã WELCOME2026 giảm thêm 15%.";
        else if (q.Contains("tháng này") || q.Contains("mùa") || q.Contains("thư giãn"))
            res = "🌿 Thời điểm này thời tiết mát mẻ (24-28°C), rất hợp nghỉ dưỡng chữa lành tại Đà Nẵng - Hội An hoặc săn mây Đà Lạt. Độ phù hợp AI chấm: 98%!";
        else if (q.Contains("voucher") || q.Contains("giảm giá"))
            res = "🎁 Bạn có thể dùng mã WELCOME2026 (giảm 15% cho đơn từ 1 triệu) hoặc SUMMERLUXURY (giảm 300.000đ cho đơn từ 2.5 triệu) ngay khi đặt phòng nhé!";
        else
            res = "🤖 AI đã ghi nhận nhu cầu của bạn! Bạn có thể bấm chọn bộ lọc 'Ngân sách + Gu trải nghiệm' ngay trên Trang chủ để xem các điểm đến & phòng phù hợp nhất.";

        chatList.Add(new ChatMsg(res, false));
    }
}
