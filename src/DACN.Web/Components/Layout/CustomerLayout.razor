@code {
    private bool isChatOpen = false;
    private bool isUserMenuOpen = false;
    private bool isProfileModalOpen = false;
    private bool isChatSending = false;
    private DateTime lastChatSentAt = DateTime.MinValue;
    private int guestMessageCount = 0;
    private string chatInput = "";
    private string? chatSessionToken;
    private List<ChatMsg> chatList = new();
    private double? userLat;
    private double? userLng;
    private string userCity = "TP. Hồ Chí Minh";
    private bool showCityPicker = false;
    private string customCityInput = "";

    private record ChatMsg(string Text, bool IsUser, List<GoiYKetQuaDto>? Suggestions = null);

    protected override void OnInitialized()
    {
        Session.OnChange += OnSessionChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Session.IsRestored && !Session.CurrentUser.IsLoggedIn)
        {
            try
            {
                var stored = await LocalStorage.GetAsync<StoredUserSession>(UserSessionService.StorageKey);
                if (stored.Success && stored.Value is { IsLoggedIn: true })
                {
                    Session.RestoreFromStored(stored.Value);
                    return;
                }
            }
            catch { }
            Session.MarkRestored();
        }
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
    }

    private void ToggleUserMenu()
    {
        isUserMenuOpen = !isUserMenuOpen;
    }

    private void OpenProfileModal()
    {
        isUserMenuOpen = false;
        isProfileModalOpen = true;
    }

    private void NavigateAndClose(string url)
    {
        isUserMenuOpen = false;
        isProfileModalOpen = false;
        Nav.NavigateTo(url);
    }

    private void GoToStaffDashboard()
    {
        isUserMenuOpen = false;
        isProfileModalOpen = false;
        Nav.NavigateTo(Session.GetDefaultStaffRoute());
    }

    private async Task Logout()
    {
        isUserMenuOpen = false;
        isProfileModalOpen = false;
        try
        {
            await LocalStorage.DeleteAsync(UserSessionService.StorageKey);
        }
        catch { }
        Session.Logout();
        Nav.NavigateTo("/");
    }

    private async Task QuickAsk(string prompt)
    {
        chatInput = prompt;
        await SendChatMessage();
    }

    private async Task HandleChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendChatMessage();
    }

    private async Task GetGpsLocation()
    {
        try
        {
            var coords = await JS.InvokeAsync<double[]>("eval", @"
                new Promise((resolve) => {
                    if (!navigator.geolocation) { resolve(null); return; }
                    navigator.geolocation.getCurrentPosition(
                        (pos) => resolve([pos.coords.latitude, pos.coords.longitude]),
                        () => resolve(null),
                        { timeout: 5000 }
                    );
                })
            ");

            if (coords != null && coords.Length >= 2)
            {
                userLat = Math.Round(coords[0], 2);
                userLng = Math.Round(coords[1], 2);
                userCity = $"GPS ({userLat:F2}, {userLng:F2})";
                showCityPicker = false;
                StateHasChanged();
            }
        }
        catch { }
    }

    private void SetCustomCity()
    {
        if (!string.IsNullOrWhiteSpace(customCityInput))
        {
            userCity = customCityInput.Trim();
            userLat = null;
            userLng = null;
            showCityPicker = false;
        }
    }

    private void SetQuickCity(string city)
    {
        userCity = city;
        userLat = null;
        userLng = null;
        showCityPicker = false;
    }

    private async Task SendChatMessage()
    {
        if (string.IsNullOrWhiteSpace(chatInput) || isChatSending) return;
        if ((DateTime.UtcNow - lastChatSentAt).TotalSeconds < 2)
        {
            return;
        }

        if (!Session.CurrentUser.IsLoggedIn && guestMessageCount >= 5)
        {
            chatList.Add(new ChatMsg(chatInput.Trim(), true));
            chatInput = "";
            chatList.Add(new ChatMsg("🔒 Bạn đã sử dụng hết 5 lượt tư vấn miễn phí dành cho khách vãng lai. Vui lòng Đăng nhập hoặc Đăng ký tài khoản để tiếp tục trò chuyện không giới hạn cùng AI!", false));
            return;
        }

        var question = chatInput.Trim();
        chatList.Add(new ChatMsg(question, true));
        chatInput = "";
        isChatSending = true;
        lastChatSentAt = DateTime.UtcNow;
        if (!Session.CurrentUser.IsLoggedIn)
        {
            guestMessageCount++;
        }

        try
        {
            var res = await AiService.ChatAsync(question, chatSessionToken, Session.CurrentUser.IsLoggedIn ? Session.CurrentUser.Id : null, userLat, userLng, userCity);
            chatSessionToken = res.MaPhienChat;
            chatList.Add(new ChatMsg(res.CauTraLoi, false, res.GoiYKemTheo));
        }
        catch
        {
            chatList.Add(new ChatMsg("🤖 AI đã ghi nhận nhu cầu của bạn! Bạn có thể chọn bộ lọc Ngân sách + Gu trải nghiệm ngay trên Trang chủ để xem gợi ý chi tiết.", false));
        }
        finally
        {
            isChatSending = false;
        }
    }

    private static string RenderMarkdown(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var encoded = System.Net.WebUtility.HtmlEncode(text);
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        encoded = encoded.Replace("\n", "<br/>");
        return encoded;
    }
}
