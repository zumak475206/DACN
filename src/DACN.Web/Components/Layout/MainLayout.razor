@inherits LayoutComponentBase
@inject UserSessionService Session
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@implements IDisposable

<div class="hotel-layout-container">
    <!-- Thanh điều hướng cố định bên trái (Sidebar) -->
    <aside class="hotel-sidebar">
        <NavMenu />
    </aside>

    <!-- Khung chính bên phải (Main Content Wrapper) -->
    <div class="hotel-main-wrapper">
        <!-- Thanh công cụ trên cùng (Topbar) -->
        <header class="hotel-topbar">
            <div class="hotel-topbar-left">
                <div class="d-flex align-items-center gap-2">
                    <span class="hotel-badge hotel-badge-success">
                        <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i>
                        Hệ thống Trực tuyến
                    </span>
                    <span class="text-muted d-none d-md-inline" style="font-size: 0.85rem;">
                        | BookingStay.AI — Cổng Quản Trị Nội Bộ
                    </span>
                    <a href="" class="badge bg-warning text-dark text-decoration-none ms-2 py-1 px-2" style="font-size: 0.75rem;">
                        <i class="bi bi-globe me-1"></i> Xem Web Khách Hàng
                    </a>
                </div>
            </div>

            <div class="hotel-topbar-right">
                <div class="d-flex align-items-center gap-2 ps-2">
                    <div style="text-align: right; line-height: 1.2;">
                        <span style="font-size: 0.85rem; font-weight: 700; color: var(--hotel-text);">@Session.CurrentUser.HoTen</span>
                        <div style="font-size: 0.72rem; color: var(--hotel-text-muted);">@Session.CurrentUser.Email</div>
                    </div>
                    <div style="width: 36px; height: 36px; border-radius: 50%; background: #E2E8F0; color: var(--hotel-primary); display: flex; align-items: center; justify-content: center; font-weight: bold;">
                        @Session.CurrentUser.HoTen.Substring(0, Math.Min(2, Session.CurrentUser.HoTen.Length)).ToUpper()
                    </div>
                    <button class="btn btn-sm btn-outline-danger ms-2" @onclick="Logout" title="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Vùng hiển thị trang nội dung động -->
        <main class="hotel-page-body">
            @if (!Session.CurrentUser.IsLoggedIn || Session.CurrentUser.Role == "Customer")
            {
                <div class="hotel-card p-5 text-center my-4">
                    <i class="bi bi-shield-slash text-danger" style="font-size: 3rem;"></i>
                    <h4 class="fw-bold mt-3">403 — Truy Cập Bị Từ Chối</h4>
                    <p class="text-muted">Tài khoản hiện tại (<strong>@Session.CurrentUser.RoleDisplayName</strong>) không có quyền truy cập Cổng Quản Trị Nội Bộ.</p>
                    <div class="d-flex justify-content-center gap-2 mt-3">
                        <a href="/login" class="hotel-btn hotel-btn-primary">Đăng nhập tài khoản Nhân viên / Admin</a>
                        <a href="/" class="hotel-btn hotel-btn-outline">Về Trang Chủ Khách Hàng</a>
                    </div>
                </div>
            }
            else
            {
                @Body
            }
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra sự cố không mong muốn trong phiên làm việc.
    <a href="." class="reload">Tải lại trang</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }

    private void Logout()
    {
        Session.Logout();
        Nav.NavigateTo("/login");
    }
}
