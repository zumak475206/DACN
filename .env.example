# ====================================================================
# DACN HOTEL MANAGEMENT - ENVIRONMENT VARIABLES TEMPLATE
# ====================================================================
# Hướng dẫn: Tạo bản sao file này với tên '.env' hoặc thiết lập các biến môi trường
# trong hệ thống / container Docker / CI/CD pipeline trước khi chạy.
# KHÔNG BAO GIỜ COMMIT FILE CHỨA MẬT KHẨU THẬT LÊN GIT!
# ====================================================================

# 1. Cơ sở dữ liệu SQL Server (Bắt buộc)
# Format Windows Auth: Server=.;Database=DACN;Trusted_Connection=True;TrustServerCertificate=True;
# Format SQL Auth: Server=localhost,1433;Database=DACN;User Id=sa;Password=YourStrongPassword!;TrustServerCertificate=True;
DACN_CONNECTION_STRING=Server=.;Database=DACN;Trusted_Connection=True;TrustServerCertificate=True;

# 2. JWT Authentication (Bắt buộc tối thiểu 32 ký tự trên Production)
DACN_JWT_SECRET=Thay_The_Bang_Chuoi_Bi_Mat_Ngau_Nhien_Dai_Toi_Thieu_32_Ky_Tu_!@#2026
Jwt__Issuer=DACN_HotelManagement
Jwt__Audience=DACN_HotelManagement_Clients
Jwt__ExpireDays=7

# 3. Môi trường ASP.NET Core
# Giá trị: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development
